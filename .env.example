# Database Turso (SQLite Edge)
# Dapatkan dari: https://app.turso.tech > Database > Connect
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# JWT Secret untuk otentikasi Edge (minimal 32 karakter)
JWT_SECRET=your_super_secret_jwt_key_here

# S3-Compatible Object Storage (Backblaze B2 / Cloudflare R2 / AWS S3)
# Contoh Backblaze B2: https://s3.us-east-005.backblazeb2.com
# Contoh Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=https://s3.your-region.backblazeb2.com
S3_REGION=your-region
S3_BUCKET_NAME=your-bucket-name

AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Resend API Key & Email Verifikasi
# Dapatkan API Key di: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Sender email. Gunakan custom domain yang sudah diverifikasi di Resend, atau 'Admin PERISAI UMI <onboarding@resend.dev>' untuk testing
RESEND_FROM_EMAIL=Admin PERISAI UMI <admin@perisai.site>

# Domain publik aplikasi (opsional, jika tidak diset akan menggunakan origin request saat ini)
APP_URL=https://oprec.perisai.site

