---
import '../styles/global.css';
import type { AuthUser } from '../lib/auth';
import { createDb } from '../db';
import { systemSettings } from '../db/schema';
import { eq } from 'drizzle-orm';

interface Props {
  title?: string;
  description?: string;
  waNumber?: string | null;
  waMessage?: string | null;
}

const {
  title = 'Open Recruitment - PERISAI UMI',
  description = 'Sistem Pendaftaran dan Seleksi Calon Anggota UKM PERISAI Universitas Muslim Indonesia.',
} = Astro.props;

const user = Astro.locals.user as AuthUser | null | undefined;

let waNum = Astro.props.waNumber;
let waMsg = Astro.props.waMessage;

if (waNum === undefined) {
  try {
    const db = createDb();
    const [settings] = await db
      .select({ waNumber: systemSettings.waNumber, waMessage: systemSettings.waMessage })
      .from(systemSettings)
      .where(eq(systemSettings.id, 1))
      .limit(1);
    if (settings) {
      waNum = settings.waNumber;
      waMsg = settings.waMessage;
    }
  } catch {
    // fallback
  }
}

let cleanWa = (waNum || '081234567890').replace(/\D/g, '');
if (cleanWa.startsWith('0')) cleanWa = '62' + cleanWa.slice(1);
else if (cleanWa.startsWith('8')) cleanWa = '62' + cleanWa;

const waMessageDefault = waMsg || 'Halo Admin Panitia OREC PERISAI UMI, saya ingin bertanya terkait pendaftaran calon anggota.';
const waUrl = cleanWa
  ? `https://wa.me/${cleanWa}?text=${encodeURIComponent(waMessageDefault)}`
  : 'https://wa.me/';
---

<!DOCTYPE html>
<html lang="id" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/assets/img/logoperisai.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#0a0a0c] text-gray-100 flex flex-col antialiased selection:bg-amber-400 selection:text-black">
    <!-- Top Decorative Glow -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[600px] h-[250px] bg-amber-500/10 blur-[120px] rounded-full pointer-events-none -z-10"></div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 w-full bg-[#121216]/85 backdrop-blur-md border-b border-amber-500/20 shadow-lg shadow-black/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          
          <!-- Logo & Brand (Static, Aligned, Utilitarian) -->
          <div class="flex items-center gap-3.5 select-none">
            <img
              src="/assets/img/logoperisai.png"
              alt="Logo PERISAI UMI"
              class="h-11 w-auto"
            />
            <div class="flex flex-col justify-center">
              <span class="font-extrabold text-lg sm:text-xl tracking-tight text-white leading-tight">
                PERISAI <span class="text-amber-400">UMI</span>
              </span>
              <span class="text-[10px] tracking-widest uppercase text-gray-400 font-semibold">
                Open Recruitment
              </span>
            </div>
          </div>

          <!-- Desktop Navigation: Profile & Logout & WhatsApp CTA -->
          <nav class="hidden md:flex items-center gap-3">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 hover:text-emerald-300 border border-emerald-500/30 text-xs font-bold transition-all duration-200 shadow-sm shadow-emerald-500/10"
              title="Hubungi Call Center Panitia via WhatsApp"
            >
              <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.187 1.564 5.946l-1.664 6.082 6.262-1.642c1.714.939 3.682 1.474 5.838 1.474 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
              </svg>
              <span>📞 Bantuan</span>
            </a>

            {user ? (
              <div class="flex items-center gap-4">
                <div class="text-right">
                  <div class="font-semibold text-white text-sm leading-tight">{user.name}</div>
                  <div class="text-[11px] font-mono tracking-wider text-amber-400/90">
                    {user.role === 'admin' ? 'Panitia' : (user.nim ? `NIM: ${user.nim}` : 'Calon Anggota')}
                  </div>
                </div>

                <a
                  href="/api/auth/logout"
                  class="text-xs font-semibold text-rose-300 hover:text-white bg-rose-950/40 hover:bg-rose-900/60 border border-rose-800/40 px-3.5 py-1.5 rounded-lg transition-colors"
                >
                  Keluar
                </a>
              </div>
            ) : (
              <div class="flex items-center gap-3">
                <a
                  href="/auth/login"
                  class="text-sm font-semibold text-black bg-amber-400 hover:bg-amber-300 px-5 py-2 rounded-xl shadow-md shadow-amber-500/20 hover:shadow-amber-500/35 transition-all duration-200"
                >
                  Masuk
                </a>
              </div>
            )}
          </nav>

          <!-- Mobile Menu Toggle Button -->
          <div class="flex md:hidden">
            <button
              id="mobile-menu-btn"
              type="button"
              class="text-gray-400 hover:text-white p-2 focus:outline-none"
              aria-label="Buka Menu"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-[#121216] px-4 pt-3 pb-5 space-y-3">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 font-bold text-xs"
        >
          <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.187 1.564 5.946l-1.664 6.082 6.262-1.642c1.714.939 3.682 1.474 5.838 1.474 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
          </svg>
          <span>Bantuan WhatsApp</span>
        </a>

        {user ? (
          <div class="space-y-3">
            <div class="text-sm">
              <span class="text-gray-400">Masuk sebagai: </span>
              <span class="font-semibold text-white">{user.name}</span>
              <span class="ml-2 text-xs text-amber-400 font-mono">[{user.role === 'admin' ? 'Panitia' : 'Calon Anggota'}]</span>
            </div>
            <a
              href="/api/auth/logout"
              class="block w-full text-center text-sm font-semibold text-rose-300 bg-rose-950/50 py-2 rounded-lg border border-rose-800/40"
            >
              Keluar
            </a>
          </div>
        ) : (
          <a
            href="/auth/login"
            class="block w-full text-center text-sm font-semibold text-black bg-amber-400 py-2.5 rounded-xl"
          >
            Masuk
          </a>
        )}
      </div>
    </header>

    <!-- Page Content Container -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="border-t border-white/10 bg-[#0d0d10] py-10 mt-16 text-center text-sm text-gray-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <img src="/assets/img/logoperisai.png" alt="PERISAI UMI" class="h-7 w-auto opacity-70" />
        </div>
        <p class="text-xs text-gray-500">
          &copy; {new Date().getFullYear()} PERISAI UMI TECH
        </p>
      </div>
    </footer>

    <!-- Mobile Nav Toggle Script -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
