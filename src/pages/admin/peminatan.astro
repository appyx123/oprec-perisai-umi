---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';
import { createDb } from '../../db';
import { peminatan } from '../../db/schema';
import { asc } from 'drizzle-orm';

const user = Astro.locals.user as AuthUser | null | undefined;
const isAdmin = user?.role === 'admin' || user?.isAdmin === true || String(user?.role).toLowerCase() === 'admin';

if (!user || !isAdmin) {
  return Astro.redirect('/auth/login');
}

let peminatanList: any[] = [];
let dbError: string | null = null;

try {
  const db = createDb();
  peminatanList = await db
    .select()
    .from(peminatan)
    .orderBy(asc(peminatan.id));
} catch (err) {
  console.error('Error loading peminatan list:', err);
  dbError = 'Gagal memuat data peminatan. Pastikan database terhubung.';
}

const configuredCount = peminatanList.filter(p => !!p.guidebookUrl && p.guidebookUrl.trim() !== '').length;
const unconfiguredCount = peminatanList.length - configuredCount;
---

<MainLayout title="Manajemen Peminatan & Guidebook - Admin PERISAI UMI">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Header Card -->
    <div class="bg-gradient-to-r from-[#1b1912] via-[#201c13] to-[#121217] border border-amber-500/30 rounded-3xl p-8 sm:p-10 shadow-xl relative overflow-hidden mb-8">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-amber-500/15 rounded-full blur-[90px] pointer-events-none"></div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-semibold mb-3">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            Peminatan & Panduan
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Manajemen Peminatan & Guidebook
          </h1>
          <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-xl">
            Kelola tautan file Guidebook PDF untuk setiap Peminatan. Tautan ini akan dapat diakses calon pendaftar di beranda publik serta dashboard peserta.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/admin/dashboard"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white border border-white/15 text-xs font-bold transition-all"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Dashboard
          </a>
        </div>
      </div>
    </div>

    {dbError && (
      <div class="mb-8 p-4 rounded-2xl bg-rose-950/50 border border-rose-800/50 text-rose-300 text-sm flex items-center gap-3">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{dbError}</span>
      </div>
    )}

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
      <div class="bg-[#121217] border border-white/10 rounded-2xl p-6 hover:border-amber-400/40 transition-colors">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold block mb-1">Total Peminatan</span>
        <p class="text-3xl font-extrabold text-white">{peminatanList.length}</p>
        <span class="text-[11px] text-gray-500 mt-1 block">Pilihan jalur seleksi calon anggota</span>
      </div>

      <div class="bg-[#121217] border border-white/10 rounded-2xl p-6 hover:border-emerald-400/40 transition-colors">
        <span class="text-xs uppercase tracking-wider text-emerald-400/80 font-semibold block mb-1">Guidebook Siap</span>
        <p class="text-3xl font-extrabold text-emerald-400">{configuredCount}</p>
        <span class="text-[11px] text-gray-500 mt-1 block">Telah terhubung dengan tautan PDF</span>
      </div>

      <div class="bg-[#121217] border border-white/10 rounded-2xl p-6 hover:border-amber-400/40 transition-colors">
        <span class="text-xs uppercase tracking-wider text-amber-400/80 font-semibold block mb-1">Belum Terhubung</span>
        <p class="text-3xl font-extrabold text-amber-400">{unconfiguredCount}</p>
        <span class="text-[11px] text-gray-500 mt-1 block">Menunggu tautan Guidebook diisi</span>
      </div>
    </div>

    <!-- Peminatan Cards List -->
    <div class="space-y-6">
      {peminatanList.map((item) => {
        const hasGuidebook = Boolean(item.guidebookUrl && item.guidebookUrl.trim().length > 0);
        return (
          <div 
            class="bg-[#121217] border border-white/10 rounded-2xl p-6 sm:p-7 hover:border-amber-400/30 transition-all shadow-lg"
            id={`card-${item.id}`}
          >
            <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
              
              <!-- Left: Peminatan Info -->
              <div class="flex-1">
                <div class="flex items-center gap-3 flex-wrap mb-2">
                  <h3 class="text-lg font-bold text-white tracking-tight">
                    {item.nama}
                  </h3>
                  {hasGuidebook ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      Guidebook Siap
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/10 border border-amber-500/30 text-amber-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                      Belum Diatur
                    </span>
                  )}
                </div>

                <p class="text-sm text-gray-400 mb-4 leading-relaxed">
                  {item.deskripsi}
                </p>

                {hasGuidebook && (
                  <div class="flex items-center gap-3 text-xs">
                    <span class="text-gray-500">Tautan Saat Ini:</span>
                    <a
                      href={item.guidebookUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-amber-400 hover:text-amber-300 underline underline-offset-4 truncate max-w-md inline-flex items-center gap-1"
                      title={item.guidebookUrl}
                    >
                      <span class="truncate">{item.guidebookUrl}</span>
                      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                      </svg>
                    </a>
                  </div>
                )}
              </div>

              <!-- Right: Form to Update Guidebook -->
              <div class="w-full lg:w-[480px] bg-white/[0.03] border border-white/10 rounded-xl p-4 sm:p-5">
                <form class="update-guidebook-form space-y-3" data-id={item.id}>
                  <div>
                    <label class="block text-xs font-semibold text-gray-300 mb-1.5">
                      URL Guidebook PDF (Direct S3 / B2 / Cloudflare)
                    </label>
                    <div class="relative">
                      <input
                        type="url"
                        name="guidebookUrl"
                        value={item.guidebookUrl || ''}
                        placeholder="https://storage.perisai.org/guidebook-kti.pdf"
                        class="w-full px-3.5 py-2 rounded-xl bg-black/40 border border-white/15 text-white text-xs placeholder-gray-600 focus:outline-none focus:border-amber-400 transition-colors"
                      />
                    </div>
                    <span class="text-[10px] text-gray-500 mt-1 block">
                      Masukkan direct link unduhan PDF. Kosongkan jika ingin menonaktifkan tombol unduh.
                    </span>
                  </div>

                  <div class="flex items-center justify-between pt-1 gap-2">
                    {hasGuidebook ? (
                      <a
                        href={item.guidebookUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white border border-white/10 text-xs font-medium transition-colors"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        Pratinjau PDF
                      </a>
                    ) : (
                      <div></div>
                    )}

                    <button
                      type="submit"
                      class="submit-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-black text-xs font-bold shadow-md shadow-amber-500/20 hover:shadow-amber-500/35 transition-all cursor-pointer disabled:opacity-50"
                    >
                      <span>Simpan URL</span>
                      <svg class="w-3.5 h-3.5 loading-spinner hidden animate-spin" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                      </svg>
                    </button>
                  </div>
                </form>
              </div>

            </div>
          </div>
        );
      })}
    </div>

  </div>

  <!-- Toast Notification Container -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <div class="px-5 py-3 rounded-2xl bg-zinc-900 border border-amber-500/40 text-white text-sm shadow-2xl flex items-center gap-3">
      <span id="toast-icon"></span>
      <span id="toast-message">Pemberitahuan</span>
    </div>
  </div>
</MainLayout>

<script>
  function showToast(message: string, isError = false) {
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toast-message');
    const toastIcon = document.getElementById('toast-icon');
    if (!toast || !toastMsg || !toastIcon) return;

    toastMsg.textContent = message;
    toastIcon.innerHTML = isError
      ? `<svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
      : `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;

    toast.classList.remove('translate-y-20', 'opacity-0');
    setTimeout(() => {
      toast.classList.add('translate-y-20', 'opacity-0');
    }, 3500);
  }

  document.querySelectorAll<HTMLFormElement>('.update-guidebook-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const peminatanId = Number(form.getAttribute('data-id'));
      const input = form.querySelector<HTMLInputElement>('input[name="guidebookUrl"]');
      const submitBtn = form.querySelector<HTMLButtonElement>('.submit-btn');
      const spinner = form.querySelector<SVGSVGElement>('.loading-spinner');

      if (!input || !submitBtn) return;
      const guidebookUrl = input.value.trim();

      submitBtn.disabled = true;
      spinner?.classList.remove('hidden');

      try {
        const res = await fetch('/api/admin/peminatan', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: peminatanId,
            guidebookUrl: guidebookUrl,
          }),
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          showToast(data.message || 'Gagal memperbarui guidebook.', true);
        } else {
          showToast('Guidebook Peminatan berhasil disimpan!');
          setTimeout(() => {
            window.location.reload();
          }, 800);
        }
      } catch (err) {
        showToast('Terjadi kesalahan jaringan.', true);
      } finally {
        submitBtn.disabled = false;
        spinner?.classList.add('hidden');
      }
    });
  });
</script>
