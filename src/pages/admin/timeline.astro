---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';
import { createDb } from '../../db';
import { timelineEvents } from '../../db/schema';
import { asc } from 'drizzle-orm';

const user = Astro.locals.user as AuthUser | null | undefined;
const isAdmin = user?.role === 'admin' || user?.isAdmin === true || String(user?.role).toLowerCase() === 'admin';

if (!user || !isAdmin) {
  return Astro.redirect('/auth/login');
}

let eventsList: any[] = [];
let dbError: string | null = null;

try {
  const db = createDb();
  eventsList = await db
    .select()
    .from(timelineEvents)
    .orderBy(asc(timelineEvents.sequenceOrder), asc(timelineEvents.startDate));
} catch (err) {
  console.error('Error loading timeline events:', err);
  dbError = 'Gagal memuat daftar linimasa. Silakan muat ulang halaman.';
}

const now = new Date();

function formatWITA(date: Date | null | undefined): string {
  if (!date) return '-';
  const d = new Date(date);
  if (isNaN(d.getTime())) return '-';
  return d.toLocaleDateString('id-ID', {
    timeZone: 'Asia/Makassar',
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }) + ' ' + d.toLocaleTimeString('id-ID', {
    timeZone: 'Asia/Makassar',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
}

function formatForDatetimeLocalWITA(date: Date | null | undefined): string {
  if (!date) return '';
  const d = new Date(date);
  if (isNaN(d.getTime())) return '';
  const formatter = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Makassar',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
  const parts = formatter.formatToParts(d);
  const get = (type: string) => parts.find((p) => p.type === type)?.value || '';
  return `${get('year')}-${get('month')}-${get('day')}T${get('hour')}:${get('minute')}`;
}
---

<MainLayout title="Manajemen Linimasa - Admin PERISAI UMI">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Header Card -->
    <div class="bg-gradient-to-r from-[#1b1912] via-[#201c13] to-[#121217] border border-amber-500/30 rounded-3xl p-8 sm:p-10 shadow-xl relative overflow-hidden mb-8">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-amber-500/15 rounded-full blur-[90px] pointer-events-none"></div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-semibold mb-3">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            Linimasa Open Recruitment
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Manajemen Jadwal Seleksi
          </h1>
          <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-xl">
            Kelola tahapan dan jadwal waktu pelaksanaan seleksi. Perubahan akan langsung disinkronkan ke beranda publik secara real-time.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            id="open-create-btn"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black text-xs font-bold shadow-md shadow-amber-500/20 hover:shadow-amber-500/35 transition-all cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Tambah
          </button>

          <a
            href="/admin/dashboard"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-300 hover:text-white text-xs font-semibold transition-colors"
          >
            Kembali
          </a>
        </div>
      </div>
    </div>

    {dbError && (
      <div class="mb-8 p-4 rounded-2xl bg-rose-950/50 border border-rose-800/50 text-rose-300 text-sm flex items-center gap-3">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{dbError}</span>
      </div>
    )}

    <!-- Dynamic Feedback Alert -->
    <div
      id="feedback-alert"
      class="hidden mb-6 p-4 rounded-xl text-sm flex items-center gap-3"
      role="alert"
    >
      <span id="feedback-text"></span>
    </div>

    <!-- Timeline Events Table Card -->
    <div class="bg-[#121217] border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl mb-8">
      <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
        <h2 class="text-lg font-bold text-white tracking-tight">Daftar Tahapan Seleksi</h2>
        <span class="text-xs text-gray-400 font-mono">
          Total: <strong class="text-amber-400">{eventsList.length}</strong> Tahapan
        </span>
      </div>

      {eventsList.length === 0 ? (
        <div class="text-center py-12 text-gray-400 text-sm">
          <p>Belum ada jadwal tahapan seleksi yang ditambahkan.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-white/10 text-gray-400 text-xs uppercase tracking-wider">
                <th class="py-3 px-4 w-16">Urutan</th>
                <th class="py-3 px-4">Nama Tahapan</th>
                <th class="py-3 px-4">Waktu Pelaksanaan</th>
                <th class="py-3 px-4">Status</th>
                <th class="py-3 px-4 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {eventsList.map((event) => {
                const startMs = new Date(event.startDate).getTime();
                // Jika tidak ada endDate atau acara 1 hari saja, anggap batas selesai adalah 23:59:59 hari tersebut
                let endMs = event.endDate ? new Date(event.endDate).getTime() : startMs + (24 * 60 * 60 * 1000);
                const nowMs = now.getTime();

                const isPast = nowMs > endMs;
                const isFuture = startMs > nowMs;
                const isCurrent = !isPast && !isFuture;

                let statusBadge = 'bg-gray-800 text-gray-400 border-gray-700';
                let statusLabel = 'Akan Datang';

                if (isCurrent) {
                  statusBadge = 'bg-amber-400/15 text-amber-300 border-amber-400/30';
                  statusLabel = 'Sedang Berlangsung';
                } else if (isPast) {
                  statusBadge = 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30';
                  statusLabel = 'Selesai';
                }

                return (
                  <tr class="hover:bg-white/[0.02] transition-colors">
                    <td class="py-4 px-4 font-mono font-bold text-amber-400 text-sm">
                      #{event.sequenceOrder}
                    </td>
                    <td class="py-4 px-4">
                      <div class="font-bold text-white">{event.title}</div>
                      {event.description && (
                        <div class="text-xs text-gray-400 mt-0.5 max-w-md line-clamp-2">
                          {event.description}
                        </div>
                      )}
                    </td>
                    <td class="py-4 px-4 text-xs font-mono text-gray-300">
                      <div><span class="text-gray-500">Mulai :</span> {formatWITA(event.startDate)}</div>
                      {event.endDate ? (
                        <div class="mt-0.5"><span class="text-gray-500">Selesai:</span> {formatWITA(event.endDate)}</div>
                      ) : (
                        <div class="mt-0.5 inline-flex items-center gap-1 text-amber-400 font-semibold">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                          <span>Acara 1 Hari Saja</span>
                        </div>
                      )}
                    </td>
                    <td class="py-4 px-4">
                      <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold border ${statusBadge}`}>
                        {isCurrent && <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>}
                        {statusLabel}
                      </span>
                    </td>
                    <td class="py-4 px-4 text-right">
                      <div class="inline-flex items-center gap-2">
                        <button
                          type="button"
                          class="edit-btn px-3 py-1.5 rounded-xl bg-white/5 hover:bg-amber-400 hover:text-black border border-white/10 text-gray-200 text-xs font-semibold transition-all cursor-pointer"
                          data-id={event.id}
                          data-title={event.title}
                          data-description={event.description || ''}
                          data-start={formatForDatetimeLocalWITA(event.startDate)}
                          data-end={event.endDate ? formatForDatetimeLocalWITA(event.endDate) : ''}
                          data-order={event.sequenceOrder}
                        >
                          Ubah
                        </button>
                        <button
                          type="button"
                          class="delete-btn px-3 py-1.5 rounded-xl bg-rose-950/40 hover:bg-rose-900/60 border border-rose-800/40 text-rose-300 hover:text-white text-xs font-semibold transition-all cursor-pointer"
                          data-id={event.id}
                          data-title={event.title}
                        >
                          Hapus
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- Modal Form Tambah / Ubah Tahapan -->
    <div
      id="event-modal"
      class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4 overflow-y-auto"
    >
      <div class="bg-[#15151c] border border-amber-500/30 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl relative">
        <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/10">
          <h3 id="modal-title" class="text-lg font-bold text-white tracking-tight">Tambah Tahapan</h3>
          <button
            type="button"
            id="close-modal-btn"
            class="text-gray-400 hover:text-white text-sm p-1"
          >
            ✕
          </button>
        </div>

        <form id="timeline-form" class="space-y-4">
          <input type="hidden" id="event-id" name="id" value="" />

          <div>
            <label for="event-title" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
              Judul Tahapan *
            </label>
            <input
              type="text"
              id="event-title"
              name="title"
              required
              placeholder="Contoh: Seleksi Wawancara"
              class="w-full px-4 py-2.5 rounded-xl bg-[#1c1c24] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-amber-400 text-sm"
            />
          </div>

          <div>
            <label for="event-description" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
              Deskripsi Singkat (Opsional)
            </label>
            <textarea
              id="event-description"
              name="description"
              rows="3"
              placeholder="Jelaskan instruksi atau kegiatan pada tahapan ini..."
              class="w-full px-4 py-2.5 rounded-xl bg-[#1c1c24] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-amber-400 text-sm"
            ></textarea>
          </div>

          <!-- Toggle Acara 1 Hari Saja -->
          <div class="p-3.5 rounded-2xl bg-[#1c1c24] border border-white/10 flex items-center justify-between gap-3">
            <div>
              <label for="is-single-day" class="text-xs font-bold text-white cursor-pointer select-none">
                Acara 1 Hari Saja
              </label>
              <p class="text-[11px] text-gray-400">Centang jika tahapan berlangsung dalam satu hari saja (tanpa rentang selesai).</p>
            </div>
            <input
              type="checkbox"
              id="is-single-day"
              class="w-4 h-4 rounded border-gray-600 text-amber-400 focus:ring-amber-400 bg-[#121217] cursor-pointer"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="event-start" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
                Waktu Mulai *
              </label>
              <input
                type="datetime-local"
                id="event-start"
                name="startDate"
                required
                class="w-full px-3.5 py-2.5 rounded-xl bg-[#1c1c24] border border-white/10 text-white focus:outline-none focus:border-amber-400 text-xs"
              />
            </div>

            <div id="end-date-container">
              <label for="event-end" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
                Waktu Selesai *
              </label>
              <input
                type="datetime-local"
                id="event-end"
                name="endDate"
                required
                class="w-full px-3.5 py-2.5 rounded-xl bg-[#1c1c24] border border-white/10 text-white focus:outline-none focus:border-amber-400 text-xs"
              />
            </div>
          </div>

          <div>
            <label for="event-order" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
              Nomor Urut Tampilan *
            </label>
            <input
              type="number"
              id="event-order"
              name="sequenceOrder"
              required
              min="1"
              value="1"
              class="w-full px-4 py-2.5 rounded-xl bg-[#1c1c24] border border-white/10 text-white focus:outline-none focus:border-amber-400 text-sm font-mono"
            />
          </div>

          <div class="flex items-center justify-end gap-3 pt-4 border-t border-white/10">
            <button
              type="button"
              id="cancel-modal-btn"
              class="px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white text-xs font-semibold transition-colors cursor-pointer"
            >
              Batal
            </button>
            <button
              type="submit"
              id="save-modal-btn"
              class="px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-xs shadow-md transition-all cursor-pointer flex items-center gap-1.5"
            >
              <span id="save-text">Simpan</span>
              <svg id="save-spinner" class="hidden w-3.5 h-3.5 animate-spin text-black" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <script>
    const modal = document.getElementById('event-modal') as HTMLDivElement | null;
    const modalTitle = document.getElementById('modal-title') as HTMLHeadingElement | null;
    const form = document.getElementById('timeline-form') as HTMLFormElement | null;
    const idInput = document.getElementById('event-id') as HTMLInputElement | null;
    const titleInput = document.getElementById('event-title') as HTMLInputElement | null;
    const descInput = document.getElementById('event-description') as HTMLTextAreaElement | null;
    const startInput = document.getElementById('event-start') as HTMLInputElement | null;
    const endInput = document.getElementById('event-end') as HTMLInputElement | null;
    const isSingleDayCheckbox = document.getElementById('is-single-day') as HTMLInputElement | null;
    const endDateContainer = document.getElementById('end-date-container') as HTMLDivElement | null;
    const orderInput = document.getElementById('event-order') as HTMLInputElement | null;
    const saveBtn = document.getElementById('save-modal-btn') as HTMLButtonElement | null;
    const saveText = document.getElementById('save-text') as HTMLSpanElement | null;
    const saveSpinner = document.getElementById('save-spinner') as SVGElement | null;

    const openCreateBtn = document.getElementById('open-create-btn');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const cancelModalBtn = document.getElementById('cancel-modal-btn');
    const alertBox = document.getElementById('feedback-alert') as HTMLDivElement | null;
    const alertText = document.getElementById('feedback-text') as HTMLSpanElement | null;

    function handleSingleDayToggle() {
      const isSingle = Boolean(isSingleDayCheckbox?.checked);
      if (isSingle) {
        if (endDateContainer) endDateContainer.classList.add('hidden');
        if (endInput) {
          endInput.required = false;
          endInput.disabled = true;
          endInput.value = '';
        }
      } else {
        if (endDateContainer) endDateContainer.classList.remove('hidden');
        if (endInput) {
          endInput.required = true;
          endInput.disabled = false;
        }
      }
    }

    if (isSingleDayCheckbox) {
      isSingleDayCheckbox.addEventListener('change', handleSingleDayToggle);
    }

    function openCreate() {
      if (form && modalTitle) {
        form.reset();
        if (idInput) idInput.value = '';
        if (isSingleDayCheckbox) isSingleDayCheckbox.checked = false;
        handleSingleDayToggle();
        modalTitle.textContent = 'Tambah Tahapan';
        modal?.classList.remove('hidden');
      }
    }

    function closeModal() {
      modal?.classList.add('hidden');
    }

    openCreateBtn?.addEventListener('click', openCreate);
    closeModalBtn?.addEventListener('click', closeModal);
    cancelModalBtn?.addEventListener('click', closeModal);

    // Edit Buttons
    document.querySelectorAll('.edit-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id') || '';
        const title = btn.getAttribute('data-title') || '';
        const description = btn.getAttribute('data-description') || '';
        const start = btn.getAttribute('data-start') || '';
        const end = btn.getAttribute('data-end') || '';
        const order = btn.getAttribute('data-order') || '1';

        if (idInput) idInput.value = id;
        if (titleInput) titleInput.value = title;
        if (descInput) descInput.value = description;
        if (startInput) startInput.value = start;
        if (orderInput) orderInput.value = order;

        if (isSingleDayCheckbox) {
          isSingleDayCheckbox.checked = !end || end === start;
        }
        handleSingleDayToggle();

        if (endInput && end) {
          endInput.value = end;
        }

        if (modalTitle) modalTitle.textContent = 'Ubah Tahapan';
        modal?.classList.remove('hidden');
      });
    });

    // Delete Buttons
    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title') || 'tahapan ini';

        if (!confirm(`Apakah Anda yakin ingin menghapus "${title}"?`)) {
          return;
        }

        try {
          const res = await fetch(`/api/admin/timeline?id=${id}`, {
            method: 'DELETE',
          });

          const data = (await res.json()) as any;
          if (res.ok && data.success) {
            showAlert('success', data.message || 'Tahapan berhasil dihapus.');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            showAlert('error', data.message || 'Gagal menghapus tahapan.');
          }
        } catch (err) {
          showAlert('error', 'Terjadi kendala jaringan.');
        }
      });
    });

    // Form Submit (Create or Update)
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const id = idInput?.value ? Number(idInput.value) : null;
        const title = titleInput?.value.trim() || '';
        const description = descInput?.value.trim() || null;
        const startDate = startInput?.value || '';
        const isSingle = Boolean(isSingleDayCheckbox?.checked);
        const endDate = isSingle ? null : (endInput?.value || null);
        const sequenceOrder = Number(orderInput?.value) || 1;

        if (!title || !startDate || (!isSingle && !endDate)) {
          alert('Mohon isi semua kolom yang diperlukan.');
          return;
        }

        setLoading(true);

        const method = id ? 'PUT' : 'POST';
        const payload: Record<string, any> = {
          title,
          description,
          startDate,
          endDate,
          sequenceOrder,
        };
        if (id) payload.id = id;

        try {
          const res = await fetch('/api/admin/timeline', {
            method,
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const data = (await res.json()) as any;
          if (res.ok && data.success) {
            closeModal();
            showAlert('success', data.message || 'Berhasil disimpan.');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            alert(data.message || 'Gagal menyimpan tahapan.');
            setLoading(false);
          }
        } catch (err) {
          alert('Terjadi kendala jaringan.');
          setLoading(false);
        }
      });
    }

    function showAlert(type: 'success' | 'error', msg: string) {
      if (!alertBox || !alertText) return;
      alertBox.className = type === 'success'
        ? 'mb-6 p-4 rounded-xl text-sm bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 flex items-center gap-3'
        : 'mb-6 p-4 rounded-xl text-sm bg-rose-500/15 border border-rose-500/30 text-rose-300 flex items-center gap-3';
      alertText.textContent = msg;
      alertBox.classList.remove('hidden');
    }

    function setLoading(isLoading: boolean) {
      if (saveBtn && saveText && saveSpinner) {
        saveBtn.disabled = isLoading;
        if (isLoading) {
          saveText.textContent = 'Menyimpan...';
          saveSpinner.classList.remove('hidden');
        } else {
          saveText.textContent = 'Simpan';
          saveSpinner.classList.add('hidden');
        }
      }
    }
  </script>
</MainLayout>
