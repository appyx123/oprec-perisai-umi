---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';
import { createDb } from '../../db';
import { systemSettings } from '../../db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user as AuthUser | null | undefined;
const isAdmin = user?.role === 'admin' || user?.isAdmin === true || String(user?.role).toLowerCase() === 'admin';

if (!user || !isAdmin) {
  return Astro.redirect('/auth/login');
}

let settings = {
  isRegistrationOpen: false,
  registrationStart: null as Date | null,
  registrationEnd: null as Date | null,
  waNumber: '',
  waMessage: '',
};

let dbError: string | null = null;

try {
  const db = createDb();
  const [row] = await db
    .select()
    .from(systemSettings)
    .where(eq(systemSettings.id, 1))
    .limit(1);

  if (row) {
    settings = {
      isRegistrationOpen: row.isRegistrationOpen,
      registrationStart: row.registrationStart,
      registrationEnd: row.registrationEnd,
      waNumber: row.waNumber || '',
      waMessage: row.waMessage || '',
    };
  }
} catch (err) {
  console.error('Error loading system settings:', err);
  dbError = 'Gagal memuat konfigurasi pendaftaran. Silakan muat ulang halaman.';
}

function formatForDatetimeLocalWITA(date: Date | null | undefined): string {
  if (!date) return '';
  const d = new Date(date);
  if (isNaN(d.getTime())) return '';
  const formatter = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Makassar',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
  const parts = formatter.formatToParts(d);
  const get = (type: string) => parts.find((p) => p.type === type)?.value || '';
  return `${get('year')}-${get('month')}-${get('day')}T${get('hour')}:${get('minute')}`;
}

const now = new Date();
const hasStart = Boolean(settings.registrationStart);
const hasEnd = Boolean(settings.registrationEnd);
const isBeforeStart = hasStart && now < new Date(settings.registrationStart!);
const isAfterEnd = hasEnd && now > new Date(settings.registrationEnd!);
const isWithinWindow = (!hasStart || !isBeforeStart) && (!hasEnd || !isAfterEnd);
const isCurrentlyActive = settings.isRegistrationOpen && isWithinWindow;
---

<MainLayout title="Pengaturan Pendaftaran - Admin PERISAI UMI">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Top Breadcrumb & Header Card -->
    <div class="bg-gradient-to-r from-[#1b1912] via-[#201c13] to-[#121217] border border-amber-500/30 rounded-3xl p-8 shadow-xl relative overflow-hidden mb-8">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-amber-500/15 rounded-full blur-[90px] pointer-events-none"></div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-semibold mb-3">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            Kontrol Akses Pendaftaran
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Pengaturan Waktu & Akses
          </h1>
          <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-xl">
            Tentukan jadwal periode pendaftaran dan saklar manual untuk mengaktifkan atau menutup pendaftaran calon anggota baru.
          </p>
        </div>

        <div class="flex items-center gap-2.5">
          <a
            href="/admin/timeline"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-black text-xs font-bold shadow-md shadow-amber-500/20 transition-all"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            Linimasa
          </a>

          <a
            href="/admin/dashboard"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-300 hover:text-white text-xs font-semibold transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Kembali
          </a>
        </div>
      </div>
    </div>

    {dbError && (
      <div class="mb-8 p-4 rounded-2xl bg-rose-950/50 border border-rose-800/50 text-rose-300 text-sm flex items-center gap-3">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{dbError}</span>
      </div>
    )}

    <!-- Live Status Overview -->
    <div class="bg-[#121217] border border-white/10 rounded-2xl p-6 shadow-xl mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold block mb-1">Status Pendaftaran Saat Ini</span>
        <div class="flex items-center gap-3">
          {isCurrentlyActive ? (
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/15 border border-emerald-500/30 text-emerald-400">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              PENDAFTARAN DIBUKA
            </span>
          ) : (
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-rose-500/15 border border-rose-500/30 text-rose-400">
              <span class="w-2 h-2 rounded-full bg-rose-400"></span>
              PENDAFTARAN DITUTUP
            </span>
          )}
        </div>
        <p class="text-xs text-gray-400 mt-2">
          {isCurrentlyActive
            ? 'Calon anggota dapat membuat akun baru dan mengisi formulir pendaftaran di situs.'
            : !settings.isRegistrationOpen
            ? 'Pendaftaran dinonaktifkan secara manual oleh panitia.'
            : isBeforeStart
            ? 'Pendaftaran dijadwalkan dibuka di waktu yang telah ditentukan.'
            : 'Jadwal pendaftaran telah berakhir.'}
        </p>
      </div>

      <div class="text-right sm:border-l sm:border-white/10 sm:pl-6">
        <span class="text-[11px] text-gray-500 block">Waktu Server (WITA)</span>
        <span id="server-wita-clock" class="font-mono text-xs text-amber-400 font-bold">
          {now.toLocaleDateString('id-ID', {
            timeZone: 'Asia/Makassar',
            day: 'numeric',
            month: 'short',
            year: 'numeric',
          })}, {now.toLocaleTimeString('id-ID', {
            timeZone: 'Asia/Makassar',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false,
          })} WITA
        </span>
        <span class="text-[10px] text-gray-500 block mt-0.5">Zona Makassar (UTC+8)</span>
      </div>
    </div>

    <!-- Alert Message Box -->
    <div
      id="feedback-alert"
      class="hidden mb-6 p-4 rounded-xl text-sm flex items-center gap-3"
      role="alert"
    >
      <div id="feedback-icon" class="flex-shrink-0"></div>
      <span id="feedback-text"></span>
    </div>

    <!-- Settings Form Card -->
    <div class="bg-[#121217] border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl">
      <h2 class="text-lg font-bold text-white mb-6 pb-4 border-b border-white/10">
        Konfigurasi Pendaftaran
      </h2>

      <form id="settings-form" class="space-y-6">
        
        <!-- Toggle Switch: Saklar Manual -->
        <div class="flex items-start justify-between p-5 rounded-xl bg-[#17171e] border border-white/5">
          <div class="pr-4">
            <label for="is-registration-open" class="text-sm font-bold text-white block cursor-pointer">
              Buka Akses Pendaftaran
            </label>
            <p class="text-xs text-gray-400 mt-1">
              Saklar utama untuk mengaktifkan atau menonaktifkan pendaftaran peserta secara manual. Jika dimatikan, pendaftaran langsung ditutup terlepas dari jadwal waktu.
            </p>
          </div>

          <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 mt-1">
            <input
              type="checkbox"
              id="is-registration-open"
              name="isRegistrationOpen"
              class="sr-only peer"
              checked={settings.isRegistrationOpen}
            />
            <div class="w-11 h-6 bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-400"></div>
          </label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
          
          <!-- Tanggal Mulai -->
          <div>
            <label for="registration-start" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
              Waktu Mulai Pendaftaran (WITA)
            </label>
            <input
              type="datetime-local"
              id="registration-start"
              name="registrationStart"
              value={formatForDatetimeLocalWITA(settings.registrationStart)}
              class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-colors text-sm"
            />
            <p class="text-[11px] text-gray-500 mt-1.5">
              Peserta baru belum dapat mendaftar sebelum waktu ini (WITA / UTC+8).
            </p>
          </div>

          <!-- Tanggal Selesai -->
          <div>
            <label for="registration-end" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
              Waktu Penutupan Pendaftaran (WITA)
            </label>
            <input
              type="datetime-local"
              id="registration-end"
              name="registrationEnd"
              value={formatForDatetimeLocalWITA(settings.registrationEnd)}
              class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-colors text-sm"
            />
            <p class="text-[11px] text-gray-500 mt-1.5">
              Pendaftaran akan ditutup otomatis ketika waktu ini terlampaui (WITA / UTC+8).
            </p>
          </div>

        </div>

        <!-- WhatsApp Call Center Settings Section -->
        <div class="pt-6 border-t border-white/10">
          <div class="flex items-center gap-2.5 mb-4">
            <div class="w-8 h-8 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.187 1.564 5.946l-1.664 6.082 6.262-1.642c1.714.939 3.682 1.474 5.838 1.474 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-base font-bold text-white tracking-tight">WhatsApp Call Center</h3>
              <p class="text-xs text-gray-400">Pusat bantuan langsung untuk calon pendaftar yang mengalami kendala.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-4">
            <!-- Nomor WA -->
            <div>
              <label for="wa-number" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
                Nomor WhatsApp Admin *
              </label>
              <input
                type="text"
                id="wa-number"
                name="waNumber"
                value={settings.waNumber}
                placeholder="Contoh: 081234567890 atau 6281234567890"
                class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors text-sm font-mono"
              />
              <p class="text-[11px] text-gray-500 mt-1.5">
                Format nomor lokal (08...) atau internasional (62...). Sistem otomatis memformat ke standar tautan wa.me.
              </p>
            </div>

            <!-- Preview Link -->
            <div class="flex flex-col justify-between">
              <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
                Uji Tautan WhatsApp
              </label>
              <div class="p-3.5 rounded-xl bg-[#171720] border border-white/10 flex items-center justify-between gap-3">
                <span id="wa-preview-text" class="text-xs text-gray-400 font-mono truncate">
                  {settings.waNumber ? `https://wa.me/${settings.waNumber.replace(/\D/g, '')}` : 'Belum diisi'}
                </span>
                <a
                  id="wa-test-link"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 text-xs font-semibold border border-emerald-500/40 transition-colors flex-shrink-0"
                >
                  Tes Chat
                </a>
              </div>
              <p class="text-[11px] text-gray-500 mt-1.5">
                Pastikan tautan dapat membuka percakapan WhatsApp dengan benar.
              </p>
            </div>
          </div>

          <!-- Pre-filled Message -->
          <div class="mb-4">
            <label for="wa-message" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
              Template Pesan Otomatis (Pre-filled Message)
            </label>
            <textarea
              id="wa-message"
              name="waMessage"
              rows="3"
              placeholder="Contoh: Halo Admin Panitia OREC PERISAI UMI, saya ingin bertanya terkait pendaftaran calon anggota."
              class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors text-sm"
            >{settings.waMessage}</textarea>
            <p class="text-[11px] text-gray-500 mt-1">
              Pesan default yang akan otomatis terisi saat calon peserta menekan tombol WhatsApp.
            </p>
          </div>
        </div>

        <!-- Note info -->
        <div class="p-4 rounded-xl bg-amber-400/5 border border-amber-400/20 text-amber-300 text-xs flex items-start gap-2.5">
          <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>
            Zona waktu yang digunakan adalah Waktu Indonesia Tengah (WITA / UTC+8). Akun peserta yang sudah terdaftar tetap dapat masuk dan mengakses dashboard kapan saja.
          </span>
        </div>

        <!-- Submit & Actions -->
        <div class="flex items-center justify-end gap-3 pt-4 border-t border-white/10">
          <a
            href="/admin/dashboard"
            class="px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white text-xs font-semibold transition-colors"
          >
            Kembali
          </a>
          
          <button
            type="submit"
            id="save-btn"
            class="px-6 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-xs shadow-md shadow-amber-500/20 hover:shadow-amber-500/35 transition-all flex items-center gap-2 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span id="save-btn-text">Simpan</span>
            <svg id="save-btn-spinner" class="hidden w-3.5 h-3.5 animate-spin text-black" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </div>

      </form>
    </div>

  </div>

  <script>
    const form = document.getElementById('settings-form') as HTMLFormElement | null;
    const toggleOpen = document.getElementById('is-registration-open') as HTMLInputElement | null;
    const startInput = document.getElementById('registration-start') as HTMLInputElement | null;
    const endInput = document.getElementById('registration-end') as HTMLInputElement | null;
    const saveBtn = document.getElementById('save-btn') as HTMLButtonElement | null;
    const saveBtnText = document.getElementById('save-btn-text') as HTMLSpanElement | null;
    const saveBtnSpinner = document.getElementById('save-btn-spinner') as SVGElement | null;
    const alertBox = document.getElementById('feedback-alert') as HTMLDivElement | null;
    const alertText = document.getElementById('feedback-text') as HTMLSpanElement | null;
    const waNumberInput = document.getElementById('wa-number') as HTMLInputElement | null;
    const waMessageInput = document.getElementById('wa-message') as HTMLTextAreaElement | null;
    const waPreviewText = document.getElementById('wa-preview-text') as HTMLSpanElement | null;
    const waTestLink = document.getElementById('wa-test-link') as HTMLAnchorElement | null;

    function updateWaPreview() {
      const rawNum = waNumberInput?.value?.trim() || '';
      const rawMsg = waMessageInput?.value?.trim() || '';
      let clean = rawNum.replace(/\D/g, '');
      if (clean.startsWith('0')) clean = '62' + clean.slice(1);
      else if (clean.startsWith('8')) clean = '62' + clean;

      if (clean) {
        const url = `https://wa.me/${clean}?text=${encodeURIComponent(rawMsg)}`;
        if (waPreviewText) waPreviewText.textContent = `https://wa.me/${clean}`;
        if (waTestLink) {
          waTestLink.href = url;
          waTestLink.classList.remove('pointer-events-none', 'opacity-50');
        }
      } else {
        if (waPreviewText) waPreviewText.textContent = 'Nomor belum diisi';
        if (waTestLink) {
          waTestLink.href = '#';
          waTestLink.classList.add('pointer-events-none', 'opacity-50');
        }
      }
    }

    if (waNumberInput) waNumberInput.addEventListener('input', updateWaPreview);
    if (waMessageInput) waMessageInput.addEventListener('input', updateWaPreview);
    updateWaPreview();

    // Real-time ticking WITA clock
    function updateWITAClock() {
      const clockEl = document.getElementById('server-wita-clock');
      if (clockEl) {
        const d = new Date();
        const dateStr = d.toLocaleDateString('id-ID', {
          timeZone: 'Asia/Makassar',
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        });
        const timeStr = d.toLocaleTimeString('id-ID', {
          timeZone: 'Asia/Makassar',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        });
        clockEl.textContent = `${dateStr}, ${timeStr} WITA`;
      }
    }
    setInterval(updateWITAClock, 1000);

    function toWITAISO(val: string | null): string | null {
      if (!val) return null;
      const clean = val.trim();
      if (!clean) return null;
      const withSec = clean.length === 16 ? `${clean}:00` : clean;
      const d = new Date(`${withSec}+08:00`);
      return isNaN(d.getTime()) ? null : d.toISOString();
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const isRegistrationOpen = Boolean(toggleOpen?.checked);
        const registrationStart = toWITAISO(startInput?.value || null);
        const registrationEnd = toWITAISO(endInput?.value || null);
        const waNumber = waNumberInput?.value?.trim() || '';
        const waMessage = waMessageInput?.value?.trim() || '';

        if (registrationStart && registrationEnd) {
          if (new Date(registrationStart).getTime() > new Date(registrationEnd).getTime()) {
            showAlert('error', 'Waktu mulai tidak boleh lebih lambat daripada waktu selesai.');
            return;
          }
        }

        setLoading(true);
        hideAlert();

        try {
          const res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify({
              isRegistrationOpen,
              registrationStart,
              registrationEnd,
              waNumber,
              waMessage,
            }),
          });

          const data = (await res.json()) as any;

          if (res.ok && data.success) {
            showAlert('success', data.message || 'Pengaturan pendaftaran berhasil disimpan.');
            setTimeout(() => {
              window.location.reload();
            }, 1200);
          } else {
            showAlert('error', data.message || 'Gagal menyimpan pengaturan.');
            setLoading(false);
          }
        } catch (err) {
          console.error('Save error:', err);
          showAlert('error', 'Terjadi kendala jaringan saat menyimpan pengaturan.');
          setLoading(false);
        }
      });
    }

    function showAlert(type: 'success' | 'error', message: string) {
      if (!alertBox || !alertText) return;
      alertBox.className = type === 'success'
        ? 'mb-6 p-4 rounded-xl text-sm bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 flex items-center gap-3'
        : 'mb-6 p-4 rounded-xl text-sm bg-rose-500/15 border border-rose-500/30 text-rose-300 flex items-center gap-3';
      alertText.textContent = message;
      alertBox.classList.remove('hidden');
    }

    function hideAlert() {
      if (alertBox) alertBox.classList.add('hidden');
    }

    function setLoading(isLoading: boolean) {
      if (saveBtn && saveBtnText && saveBtnSpinner) {
        saveBtn.disabled = isLoading;
        if (isLoading) {
          saveBtnText.textContent = 'Menyimpan...';
          saveBtnSpinner.classList.remove('hidden');
        } else {
          saveBtnText.textContent = 'Simpan';
          saveBtnSpinner.classList.add('hidden');
        }
      }
    }
  </script>
</MainLayout>
