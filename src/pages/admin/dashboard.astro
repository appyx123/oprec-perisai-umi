---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';
import { createDb } from '../../db';
import { cagens, berkasCagens, STATUS_PENDAFTARAN } from '../../db/schema';
import { count, eq, desc, and, or, like } from 'drizzle-orm';

const user = Astro.locals.user as AuthUser | null | undefined;
const isAdmin = user?.role === 'admin' || user?.isAdmin === true || String(user?.role).toLowerCase() === 'admin';

if (!user || !isAdmin) {
  return Astro.redirect('/auth/login');
}

// 1. Ambil parameter filter & pencarian dari URL
const search = Astro.url.searchParams.get('search')?.trim() || '';
const statusFilter = Astro.url.searchParams.get('status')?.trim() || '';

// Inisialisasi statistik default
let stats = {
  totalPendaftar: 0,
  reviewBerkas: 0,
  berkasDiterima: 0,
  lulusFinal: 0,
};

let applicantList: Array<{
  id: number;
  nomorRegistrasi?: string | null;
  namaLengkap: string;
  nim: string;
  fakultas: string;
  jurusan: string;
  statusPendaftaran: string;
  peminatan: string | null;
}> = [];

let dbError: string | null = null;

try {
  const db = createDb();

  // 1. Hitung metrik pendaftar secara langsung dari database Turso
  const [totalResult] = await db.select({ value: count() }).from(cagens);
  const [reviewResult] = await db.select({ value: count() }).from(cagens).where(eq(cagens.statusPendaftaran, 'Review Berkas'));
  const [diterimaResult] = await db.select({ value: count() }).from(cagens).where(eq(cagens.statusPendaftaran, 'Berkas Diterima'));
  const [lulusResult] = await db.select({ value: count() }).from(cagens).where(eq(cagens.statusPendaftaran, 'Lulus'));

  stats.totalPendaftar = totalResult?.value ?? 0;
  stats.reviewBerkas = reviewResult?.value ?? 0;
  stats.berkasDiterima = diterimaResult?.value ?? 0;
  stats.lulusFinal = lulusResult?.value ?? 0;

  // 2. Susun kondisi query filter & search
  const whereConditions = [];
  if (statusFilter && statusFilter !== 'SEMUA') {
    whereConditions.push(eq(cagens.statusPendaftaran, statusFilter as any));
  }
  if (search) {
    whereConditions.push(
      or(
        like(cagens.namaLengkap, `%${search}%`),
        like(cagens.nim, `%${search}%`),
        like(cagens.email, `%${search}%`),
        like(cagens.nomorRegistrasi, `%${search}%`),
        like(cagens.jurusan, `%${search}%`),
        like(cagens.fakultas, `%${search}%`)
      )
    );
  }

  // 3. Ambil data pendaftar (limit 50)
  let query = db
    .select({
      id: cagens.id,
      nomorRegistrasi: cagens.nomorRegistrasi,
      namaLengkap: cagens.namaLengkap,
      nim: cagens.nim,
      fakultas: cagens.fakultas,
      jurusan: cagens.jurusan,
      statusPendaftaran: cagens.statusPendaftaran,
      peminatan: berkasCagens.peminatan,
    })
    .from(cagens)
    .leftJoin(berkasCagens, eq(cagens.id, berkasCagens.cagenId))
    .orderBy(desc(cagens.createdAt))
    .limit(50);

  if (whereConditions.length > 0) {
    query = query.where(and(...whereConditions)) as any;
  }

  const rows = await query;

  applicantList = rows.map((r) => ({
    id: r.id,
    nomorRegistrasi: r.nomorRegistrasi,
    namaLengkap: r.namaLengkap,
    nim: r.nim,
    fakultas: r.fakultas,
    jurusan: r.jurusan,
    statusPendaftaran: r.statusPendaftaran,
    peminatan: r.peminatan || null,
  }));
} catch (err) {
  console.error('Error loading admin dashboard stats:', err);
  dbError = 'Gagal memuat data pendaftar. Silakan segarkan halaman.';
}

const isFiltered = Boolean(search || (statusFilter && statusFilter !== 'SEMUA'));
---

<MainLayout title="Dashboard Panitia - Open Recruitment PERISAI UMI">
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Admin Header Card -->
    <div class="bg-gradient-to-r from-[#1b1912] via-[#201c13] to-[#121217] border border-amber-500/30 rounded-3xl p-8 sm:p-10 shadow-xl relative overflow-hidden mb-8">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-amber-500/15 rounded-full blur-[90px] pointer-events-none"></div>

      <div class="flex flex-col xl:flex-row items-start xl:items-center justify-between gap-6 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-semibold mb-3">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            Panel Administrator (Panitia OPREC)
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
            Dashboard Panitia: <span class="text-amber-400">{user.name}</span>
          </h1>
          <p class="text-sm sm:text-base text-gray-400 mt-2 max-w-2xl">
            Selamat bertugas, <span class="text-white font-semibold">@{user.username || 'admin'}</span>. Kelola pendaftaran calon anggota dan pengumuman seleksi di sini.
          </p>
        </div>

        <div class="flex items-center gap-2 sm:gap-2.5 flex-nowrap shrink-0 overflow-x-auto max-w-full pb-1">
          <a
            href="/admin/timeline"
            class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white border border-white/15 text-xs font-bold whitespace-nowrap transition-all"
          >
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            Linimasa
          </a>

          <a
            href="/admin/qna"
            class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black border border-amber-400 hover:border-amber-300 text-xs font-bold whitespace-nowrap shadow-md shadow-amber-500/20 hover:shadow-amber-500/35 transition-all"
          >
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
            </svg>
            Q&A
          </a>

          <a
            href="/admin/peminatan"
            class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white border border-white/15 text-xs font-bold whitespace-nowrap transition-all"
          >
            <svg class="w-4 h-4 flex-shrink-0 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            Peminatan
          </a>

          <a
            href="/admin/pengaturan"
            class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white border border-white/15 text-xs font-bold whitespace-nowrap transition-all"
          >
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Pengaturan
          </a>
        </div>
      </div>
    </div>

    {dbError && (
      <div class="mb-8 p-4 rounded-2xl bg-rose-950/50 border border-rose-800/50 text-rose-300 text-sm flex items-center gap-3">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{dbError}</span>
      </div>
    )}

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="bg-[#121217] border border-white/10 rounded-2xl p-6 hover:border-amber-400/40 transition-colors">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold block mb-1">Total Pendaftar</span>
        <p class="text-3xl font-extrabold text-white">{stats.totalPendaftar}</p>
        <span class="text-[11px] text-gray-500 mt-1 block">Calon Anggota Terdaftar</span>
      </div>

      <div class="bg-[#121217] border border-white/10 rounded-2xl p-6 hover:border-amber-400/40 transition-colors">
        <span class="text-xs uppercase tracking-wider text-amber-400/80 font-semibold block mb-1">Review Berkas</span>
        <p class="text-3xl font-extrabold text-amber-400">{stats.reviewBerkas}</p>
        <span class="text-[11px] text-gray-500 mt-1 block">Menunggu Verifikasi</span>
      </div>

      <div class="bg-[#121217] border border-white/10 rounded-2xl p-6 hover:border-emerald-400/40 transition-colors">
        <span class="text-xs uppercase tracking-wider text-emerald-400/80 font-semibold block mb-1">Berkas Diterima</span>
        <p class="text-3xl font-extrabold text-emerald-400">{stats.berkasDiterima}</p>
        <span class="text-[11px] text-gray-500 mt-1 block">Lolos Seleksi Berkas</span>
      </div>

      <div class="bg-[#121217] border border-white/10 rounded-2xl p-6 hover:border-blue-400/40 transition-colors">
        <span class="text-xs uppercase tracking-wider text-blue-400/80 font-semibold block mb-1">Lulus Final</span>
        <p class="text-3xl font-extrabold text-blue-400">{stats.lulusFinal}</p>
        <span class="text-[11px] text-gray-500 mt-1 block">Calon Anggota Lulus</span>
      </div>
    </div>

    <!-- Data Peserta Table Panel -->
    <div class="bg-[#121217] border border-white/10 rounded-2xl p-6 sm:p-8 shadow-xl mb-8">
      
      <!-- Panel Header with Search and Filter Form -->
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 pb-6 border-b border-white/10">
        <div>
          <h2 class="text-xl font-bold text-white tracking-tight">Daftar Calon Anggota (Cagen)</h2>
          <p class="text-xs text-gray-400 mt-1">
            Data pendaftar tersaring secara real-time. Buka profil untuk detail lengkap dan verifikasi berkas.
          </p>
        </div>

        <!-- Filter & Search Toolbar -->
        <form id="search-filter-form" method="GET" action="/admin/dashboard" class="w-full lg:w-auto flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          
          <!-- Search Input with Debounce & Loading Spinner -->
          <div class="relative min-w-[260px] flex-1">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
              <svg id="search-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <svg id="search-spinner" class="hidden w-4 h-4 animate-spin text-amber-400" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </div>
            <input
              type="text"
              id="search-applicants"
              name="search"
              value={search}
              placeholder="Cari nama, NIM, no. registrasi..."
              autocomplete="off"
              class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[#1a1a22] border border-white/10 text-white placeholder-gray-500 text-xs focus:outline-none focus:border-amber-400 transition-colors"
            />
          </div>

          <!-- Status Filter Dropdown -->
          <div class="relative">
            <select
              id="status-filter"
              name="status"
              class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-[#1a1a22] border border-white/10 text-white text-xs focus:outline-none focus:border-amber-400 transition-colors cursor-pointer appearance-none pr-8"
            >
              <option value="SEMUA" selected={!statusFilter || statusFilter === 'SEMUA'}>Semua Status</option>
              {STATUS_PENDAFTARAN.map((s) => (
                <option value={s} selected={statusFilter === s}>{s}</option>
              ))}
            </select>
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-gray-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>

          <!-- Filter Submit Button -->
          <button
            type="submit"
            class="px-4 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-xs shadow-md transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
          >
            Filter
          </button>

          <!-- Reset Filter Button -->
          {isFiltered && (
            <a
              id="reset-filter-btn"
              href="/admin/dashboard"
              class="px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-300 hover:text-white text-xs font-semibold transition-colors flex items-center justify-center gap-1"
              title="Hapus Filter"
            >
              Reset
            </a>
          )}
        </form>
      </div>

      <!-- Result Count Strip -->
      <div class="flex items-center justify-between pt-4 pb-2 text-xs text-gray-400 font-mono">
        <div>
          Menampilkan: <span id="applicant-count" class="text-amber-400 font-bold">{applicantList.length}</span> peserta
          <span id="filtered-indicator" class="text-gray-500 ml-1" style={isFiltered ? '' : 'display: none;'}>
            (tersaring)
          </span>
        </div>
      </div>

      <!-- Empty State Container -->
      <div
        id="empty-state"
        class={`text-center py-14 text-gray-400 text-sm ${applicantList.length === 0 ? '' : 'hidden'}`}
      >
        <div class="w-12 h-12 rounded-full bg-white/5 mx-auto mb-3 flex items-center justify-center text-gray-500">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <p id="empty-state-text">
          {isFiltered ? 'Tidak ada calon anggota yang cocok dengan kriteria pencarian.' : 'Belum ada calon anggota yang mendaftar di sistem.'}
        </p>
      </div>

      <!-- Table Container -->
      <div id="table-container" class={`overflow-x-auto mt-4 ${applicantList.length === 0 ? 'hidden' : ''}`}>
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b border-white/10 text-gray-400 text-xs uppercase tracking-wider">
              <th class="py-3.5 px-4 w-24">No. Reg</th>
              <th class="py-3.5 px-4">Calon Anggota</th>
              <th class="py-3.5 px-4">Fakultas & Program Studi</th>
              <th class="py-3.5 px-4">Peminatan</th>
              <th class="py-3.5 px-4">Status Seleksi</th>
              <th class="py-3.5 px-4 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody id="applicants-table-body" class="divide-y divide-white/5">
            {applicantList.map((cagen) => {
              let badgeColor = 'bg-gray-800 text-gray-300 border-gray-700';
              if (cagen.statusPendaftaran === 'Review Berkas') {
                badgeColor = 'bg-amber-500/15 text-amber-300 border-amber-500/30';
              } else if (cagen.statusPendaftaran === 'Berkas Diterima') {
                badgeColor = 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30';
              } else if (cagen.statusPendaftaran === 'Lulus') {
                badgeColor = 'bg-blue-500/15 text-blue-300 border-blue-500/30';
              } else if (cagen.statusPendaftaran === 'Tidak Lulus') {
                badgeColor = 'bg-rose-500/15 text-rose-300 border-rose-500/30';
              }

              return (
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="py-4 px-4 font-mono font-bold text-amber-400 text-xs tracking-wider">#{cagen.nomorRegistrasi || cagen.id}</td>
                  <td class="py-4 px-4">
                    <div class="font-bold text-white">{cagen.namaLengkap}</div>
                    <div class="font-mono text-xs text-amber-400/90 mt-0.5">{cagen.nim}</div>
                  </td>
                  <td class="py-4 px-4 text-xs text-gray-300">
                    <span class="block font-medium text-gray-200">{cagen.jurusan}</span>
                    <span class="text-gray-500">{cagen.fakultas}</span>
                  </td>
                  <td class="py-4 px-4">
                    {cagen.peminatan ? (
                      <span class="inline-block px-2.5 py-1 rounded-lg bg-amber-400/10 border border-amber-400/20 text-amber-300 text-xs font-medium">
                        {cagen.peminatan}
                      </span>
                    ) : (
                      <span class="text-xs text-gray-500 italic">Belum Dipilih</span>
                    )}
                  </td>
                  <td class="py-4 px-4">
                    <span class={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold border ${badgeColor}`}>
                      {cagen.statusPendaftaran}
                    </span>
                  </td>
                  <td class="py-4 px-4 text-right">
                    <a
                      href={`/admin/peserta/${cagen.id}`}
                      class="inline-flex items-center px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-amber-400 hover:text-black border border-white/10 hover:border-amber-400 text-gray-200 text-xs font-semibold transition-all shadow-sm"
                    >
                      Detail
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Lightning-Fast Debounced Client-Side Search Script -->
  <script is:inline>
    // 1. Debounce wrapper function (300ms default)
    function debounce(func, delay = 300) {
      let timeoutId;
      return function (...args) {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => {
          func.apply(this, args);
        }, delay);
      };
    }

    // 2. Helper to escape HTML characters (XSS Prevention)
    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // 3. Status Badge Color Mapper
    function getBadgeClass(status) {
      switch (status) {
        case 'Review Berkas':
          return 'bg-amber-500/15 text-amber-300 border-amber-500/30';
        case 'Berkas Diterima':
          return 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30';
        case 'Lulus':
          return 'bg-blue-500/15 text-blue-300 border-blue-500/30';
        case 'Tidak Lulus':
          return 'bg-rose-500/15 text-rose-300 border-rose-500/30';
        default:
          return 'bg-gray-800 text-gray-300 border-gray-700';
      }
    }

    // 4. Render Table Row HTML string
    function renderApplicantRow(cagen) {
      const regNo = escapeHtml(cagen.nomorRegistrasi || cagen.id);
      const nama = escapeHtml(cagen.namaLengkap);
      const nim = escapeHtml(cagen.nim);
      const jurusan = escapeHtml(cagen.jurusan);
      const fakultas = escapeHtml(cagen.fakultas);
      const peminatan = cagen.peminatan
        ? `<span class="inline-block px-2.5 py-1 rounded-lg bg-amber-400/10 border border-amber-400/20 text-amber-300 text-xs font-medium">${escapeHtml(cagen.peminatan)}</span>`
        : `<span class="text-xs text-gray-500 italic">Belum Dipilih</span>`;
      const badgeClass = getBadgeClass(cagen.statusPendaftaran);
      const status = escapeHtml(cagen.statusPendaftaran);

      return `
        <tr class="hover:bg-white/[0.02] transition-colors">
          <td class="py-4 px-4 font-mono font-bold text-amber-400 text-xs tracking-wider">#${regNo}</td>
          <td class="py-4 px-4">
            <div class="font-bold text-white">${nama}</div>
            <div class="font-mono text-xs text-amber-400/90 mt-0.5">${nim}</div>
          </td>
          <td class="py-4 px-4 text-xs text-gray-300">
            <span class="block font-medium text-gray-200">${jurusan}</span>
            <span class="text-gray-500">${fakultas}</span>
          </td>
          <td class="py-4 px-4">
            ${peminatan}
          </td>
          <td class="py-4 px-4">
            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold border ${badgeClass}">
              ${status}
            </span>
          </td>
          <td class="py-4 px-4 text-right">
            <a
              href="/admin/peserta/${cagen.id}"
              class="inline-flex items-center px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-amber-400 hover:text-black border border-white/10 hover:border-amber-400 text-gray-200 text-xs font-semibold transition-all shadow-sm"
            >
              Detail
            </a>
          </td>
        </tr>
      `;
    }

    // 5. Search Controller with AbortController to prevent race conditions
    let searchAbortController = null;

    async function performSearch(searchTerm) {
      if (searchAbortController) {
        searchAbortController.abort();
      }
      searchAbortController = new AbortController();

      const searchIcon = document.getElementById('search-icon');
      const searchSpinner = document.getElementById('search-spinner');
      const statusSelect = document.getElementById('status-filter');
      const tableContainer = document.getElementById('table-container');
      const tbody = document.getElementById('applicants-table-body');
      const emptyState = document.getElementById('empty-state');
      const emptyStateText = document.getElementById('empty-state-text');
      const countSpan = document.getElementById('applicant-count');
      const filteredIndicator = document.getElementById('filtered-indicator');

      const statusVal = statusSelect ? statusSelect.value : '';

      if (searchIcon && searchSpinner) {
        searchIcon.classList.add('hidden');
        searchSpinner.classList.remove('hidden');
      }

      try {
        const params = new URLSearchParams();
        if (searchTerm) params.set('q', searchTerm);
        if (statusVal && statusVal !== 'SEMUA') params.set('status', statusVal);

        const res = await fetch(`/api/admin/search-applicants?${params.toString()}`, {
          signal: searchAbortController.signal,
          headers: { 'Accept': 'application/json' },
        });

        if (!res.ok) throw new Error('Search failed');

        const json = await res.json();
        if (!json.success || !Array.isArray(json.data)) return;

        const data = json.data;

        // Update count numbers
        if (countSpan) countSpan.textContent = String(data.length);
        if (filteredIndicator) {
          if (searchTerm || (statusVal && statusVal !== 'SEMUA')) {
            filteredIndicator.textContent = '(tersaring)';
            filteredIndicator.style.display = 'inline';
          } else {
            filteredIndicator.textContent = '';
            filteredIndicator.style.display = 'none';
          }
        }

        // Update DOM Table or Empty State
        if (data.length === 0) {
          if (tbody) tbody.innerHTML = '';
          if (tableContainer) tableContainer.classList.add('hidden');
          if (emptyState) {
            emptyState.classList.remove('hidden');
            if (emptyStateText) {
              emptyStateText.textContent = searchTerm
                ? `Tidak ada calon anggota yang cocok dengan kata kunci "${searchTerm}".`
                : 'Tidak ada calon anggota dengan kriteria yang dipilih.';
            }
          }
        } else {
          if (emptyState) emptyState.classList.add('hidden');
          if (tableContainer) tableContainer.classList.remove('hidden');
          if (tbody) {
            tbody.innerHTML = data.map(renderApplicantRow).join('');
          }
        }
      } catch (err) {
        if (err.name === 'AbortError') return;
        console.error('Search error:', err);
      } finally {
        if (searchIcon && searchSpinner) {
          searchSpinner.classList.add('hidden');
          searchIcon.classList.remove('hidden');
        }
      }
    }

    // 6. Initialize Event Listeners
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('search-applicants');
      const statusSelect = document.getElementById('status-filter');
      const searchForm = document.getElementById('search-filter-form');

      if (searchInput) {
        // Debounce input listener with 300ms delay
        const handleSearchDebounced = debounce((e) => {
          performSearch(e.target.value.trim());
        }, 300);

        searchInput.addEventListener('input', handleSearchDebounced);
      }

      if (statusSelect) {
        statusSelect.addEventListener('change', () => {
          const q = searchInput ? searchInput.value.trim() : '';
          performSearch(q);
        });
      }

      if (searchForm) {
        searchForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const q = searchInput ? searchInput.value.trim() : '';
          performSearch(q);
        });
      }
    });
  </script>
</MainLayout>
