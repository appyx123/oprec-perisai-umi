---
import MainLayout from '../../../layouts/MainLayout.astro';
import type { AuthUser } from '../../../lib/auth';
import { createDb } from '../../../db';
import { cagens, documentTypes, cagenDocuments, peminatan as peminatanTable, STATUS_PENDAFTARAN } from '../../../db/schema';
import { eq, asc, desc, lt, gt } from 'drizzle-orm';

const user = Astro.locals.user as AuthUser | null | undefined;
const isAdmin = user?.role === 'admin' || user?.isAdmin === true || String(user?.role).toLowerCase() === 'admin';

if (!user || !isAdmin) {
  return Astro.redirect('/auth/login');
}

const { id } = Astro.params;
const applicantId = Number(id);

if (!applicantId || isNaN(applicantId)) {
  return Astro.redirect('/admin/dashboard');
}

let cagen: any = null;
let chosenPeminatan: any = null;
let uploadedDocs: any[] = [];
let prevApplicantId: number | null = null;
let nextApplicantId: number | null = null;
let dbError: string | null = null;

try {
  const db = createDb();

  // 1. Ambil data peserta
  const [foundCagen] = await db
    .select()
    .from(cagens)
    .where(eq(cagens.id, applicantId))
    .limit(1);

  if (foundCagen) {
    cagen = foundCagen;

    // 2. Ambil informasi peminatan terpilih jika ada
    if (cagen.peminatan) {
      const [foundPeminatan] = await db
        .select()
        .from(peminatanTable)
        .where(eq(peminatanTable.nama, cagen.peminatan))
        .limit(1);
      chosenPeminatan = foundPeminatan ?? null;
    }

    // 3. Query seluruh dokumen persyaratan dan join dokumen unggahan peserta
    const allDocTypes = await db
      .select({
        id: documentTypes.id,
        slug: documentTypes.slug,
        label: documentTypes.label,
        group: documentTypes.group,
        peminatanId: documentTypes.peminatanId,
        inputType: documentTypes.inputType,
        acceptMime: documentTypes.acceptMime,
        maxSizeBytes: documentTypes.maxSizeBytes,
      })
      .from(documentTypes)
      .where(eq(documentTypes.isActive, true))
      .orderBy(asc(documentTypes.id));

    const userDocs = await db
      .select({
        id: cagenDocuments.id,
        documentTypeId: cagenDocuments.documentTypeId,
        s3Key: cagenDocuments.s3Key,
        originalFilename: cagenDocuments.originalFilename,
        contentType: cagenDocuments.contentType,
        uploadedAt: cagenDocuments.uploadedAt,
      })
      .from(cagenDocuments)
      .where(eq(cagenDocuments.cagenId, applicantId));

    const userDocsMap = new Map(userDocs.map(d => [d.documentTypeId, d]));

    uploadedDocs = allDocTypes
      .filter(dt => dt.peminatanId === null || (chosenPeminatan && dt.peminatanId === chosenPeminatan.id))
      .map(dt => {
        const userDoc = userDocsMap.get(dt.id);
        const s3Key = userDoc?.s3Key || '';
        const isUploaded = Boolean(s3Key && s3Key.trim() !== '');
        const isLink = dt.inputType === 'link' || s3Key.startsWith('http://') || s3Key.startsWith('https://');

        return {
          docTypeId: dt.id,
          slug: dt.slug,
          label: dt.label,
          group: dt.group,
          inputType: dt.inputType || 'file',
          isUploaded,
          isLink,
          s3Key,
          originalFilename: userDoc?.originalFilename || '',
          contentType: userDoc?.contentType || '',
          uploadedAt: userDoc?.uploadedAt || null,
        };
      });

    // 4. Navigasi Peserta Sebelumnya (Prev) dan Selanjutnya (Next)
    const [prevRow] = await db
      .select({ id: cagens.id })
      .from(cagens)
      .where(lt(cagens.id, applicantId))
      .orderBy(desc(cagens.id))
      .limit(1);

    const [nextRow] = await db
      .select({ id: cagens.id })
      .from(cagens)
      .where(gt(cagens.id, applicantId))
      .orderBy(asc(cagens.id))
      .limit(1);

    prevApplicantId = prevRow?.id ?? null;
    nextApplicantId = nextRow?.id ?? null;
  }
} catch (err) {
  console.error(`Error loading applicant #${applicantId}:`, err);
  dbError = 'Gagal memuat data calon anggota. Silakan muat ulang halaman.';
}

function formatWaUrl(rawPhone: string): string {
  let clean = (rawPhone || '').replace(/[^0-9]/g, '');
  if (clean.startsWith('0')) {
    clean = '62' + clean.slice(1);
  }
  return `https://wa.me/${clean}`;
}

// Initial active document for previewer
const firstAvailableDoc = uploadedDocs.find(d => d.isUploaded) || uploadedDocs[0] || null;
---

<MainLayout title={cagen ? `Review Peserta: ${cagen.namaLengkap} - PERISAI UMI` : 'Peserta Tidak Ditemukan'}>
  <div class="max-w-7xl mx-auto w-full px-3 sm:px-6 lg:px-8 py-6 md:py-8">
    
    <!-- Top Navigation Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div class="flex items-center gap-3">
        <a
          href="/admin/dashboard"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-300 hover:text-white text-xs font-semibold transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Kembali ke Daftar
        </a>

        <div class="h-4 w-px bg-white/10 hidden sm:block"></div>

        <span class="text-xs text-gray-400 font-mono">
          ID Pendaftar: <strong class="text-white">#{applicantId}</strong>
        </span>
      </div>

      <!-- Quick Prev / Next Navigator -->
      <div class="flex items-center gap-2">
        {prevApplicantId ? (
          <a
            href={`/admin/peserta/${prevApplicantId}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs text-gray-300 hover:text-white transition-colors"
            title="Peserta Sebelumnya"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            <span>Sebelumnya</span>
          </a>
        ) : (
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 border border-white/5 text-xs text-gray-600 cursor-not-allowed">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            <span>Sebelumnya</span>
          </span>
        )}

        {nextApplicantId ? (
          <a
            href={`/admin/peserta/${nextApplicantId}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs text-gray-300 hover:text-white transition-colors"
            title="Peserta Selanjutnya"
          >
            <span>Selanjutnya</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        ) : (
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 border border-white/5 text-xs text-gray-600 cursor-not-allowed">
            <span>Selanjutnya</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </span>
        )}
      </div>
    </div>

    {dbError && (
      <div class="mb-6 p-4 rounded-2xl bg-rose-950/50 border border-rose-800/50 text-rose-300 text-sm flex items-center gap-3">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{dbError}</span>
      </div>
    )}

    {!cagen ? (
      <div class="bg-[#121217] border border-white/10 rounded-3xl p-12 text-center shadow-xl">
        <div class="w-16 h-16 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white mb-2">Calon Anggota Tidak Ditemukan</h2>
        <p class="text-sm text-gray-400 max-w-md mx-auto mb-6">
          Data pendaftar dengan nomor identitas #{applicantId} tidak ditemukan dalam sistem pendaftaran.
        </p>
        <a
          href="/admin/dashboard"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-sm shadow-lg shadow-amber-500/20 transition-colors"
        >
          Kembali ke Dashboard
        </a>
      </div>
    ) : (
      <div>
        <!-- Toast Feedback Notification -->
        <div id="status-toast" class="hidden mb-6 p-4 rounded-2xl text-sm" role="alert">
          <div class="flex items-center gap-3">
            <div id="toast-icon" class="flex-shrink-0"></div>
            <p id="toast-message" class="font-medium"></p>
          </div>
        </div>

        <!-- SPLIT-SCREEN LAYOUT: Desktop col-span-7 / col-span-5 -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          
          <!-- ========================================================================= -->
          <!-- LEFT PANEL: FAST DOCUMENT VIEWER (Col Span 7 / 8) -->
          <!-- ========================================================================= -->
          <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-4">
            
            <div class="bg-[#121217] border border-white/10 rounded-3xl p-4 sm:p-6 shadow-xl flex flex-col">
              
              <!-- Tab Controls for Documents -->
              <div class="flex items-center justify-between gap-3 pb-3 border-b border-white/10 mb-4">
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  <h2 class="text-sm sm:text-base font-bold text-white tracking-tight">Berkas Persyaratan</h2>
                </div>

                <span class="text-xs text-gray-400 font-mono">
                  Terunggah: <strong class="text-amber-400 font-bold">{uploadedDocs.filter(d => d.isUploaded).length}</strong> / {uploadedDocs.length}
                </span>
              </div>

              <!-- Horizontal Scrollable Tabs -->
              <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-thin scrollbar-thumb-white/10">
                {uploadedDocs.map((doc, idx) => {
                  const isActive = firstAvailableDoc && firstAvailableDoc.slug === doc.slug;
                  return (
                    <button
                      type="button"
                      class={`doc-tab px-3 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all flex items-center gap-2 cursor-pointer border ${
                        isActive
                          ? 'bg-amber-400 text-black border-amber-400 shadow-md shadow-amber-500/20'
                          : doc.isUploaded
                          ? 'bg-[#181822] text-gray-200 border-white/10 hover:border-amber-400/40 hover:text-white'
                          : 'bg-white/[0.02] text-gray-500 border-white/5 hover:border-white/10'
                      }`}
                      data-slug={doc.slug}
                      data-label={doc.label}
                      data-s3-key={doc.s3Key}
                      data-is-uploaded={String(doc.isUploaded)}
                      data-is-link={String(doc.isLink)}
                    >
                      <span class={`w-2 h-2 rounded-full ${doc.isUploaded ? (isActive ? 'bg-black' : 'bg-emerald-400') : 'bg-rose-500/70'}`}></span>
                      <span>{doc.label}</span>
                    </button>
                  );
                })}
              </div>

              <!-- Active Document Header Strip -->
              <div class="mt-4 p-3 rounded-2xl bg-[#161620] border border-white/5 flex flex-wrap items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-2 min-w-0">
                  <span id="active-doc-title" class="font-bold text-white truncate">
                    {firstAvailableDoc?.label || 'Belum Memilih Dokumen'}
                  </span>
                  <span id="active-doc-badge" class="px-2 py-0.5 rounded text-[10px] font-mono"></span>
                </div>

                <div class="flex items-center gap-2">
                  <a
                    id="btn-open-new-tab"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-amber-400 hover:text-amber-300 border border-white/10 font-semibold transition-colors"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    <span>Buka Tab Baru</span>
                  </a>
                </div>
              </div>

              <!-- PREVIEWER CONTAINER -->
              <div class="mt-4 rounded-2xl bg-[#0e0e12] border border-white/10 overflow-hidden relative min-h-[480px] lg:min-h-[620px] flex items-center justify-center">
                
                <!-- Loading Overlay -->
                <div id="viewer-spinner" class="absolute inset-0 bg-[#0e0e12]/80 backdrop-blur-sm z-20 flex flex-col items-center justify-center gap-3">
                  <svg class="w-8 h-8 animate-spin text-amber-400" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <span class="text-xs text-gray-400 font-mono">Memuat pratinjau dokumen...</span>
                </div>

                <!-- Empty or Unuploaded State -->
                <div id="viewer-empty" class="hidden text-center p-8 z-10">
                  <div class="w-16 h-16 rounded-full bg-white/5 border border-white/10 text-gray-500 flex items-center justify-center mx-auto mb-3">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                  </div>
                  <h3 class="text-base font-bold text-white mb-1">Dokumen Belum Diunggah</h3>
                  <p class="text-xs text-gray-400 max-w-sm mx-auto">
                    Calon anggota belum mengunggah file atau tautan untuk persyaratan ini.
                  </p>
                </div>

                <!-- External Link State Box -->
                <div id="viewer-link" class="hidden text-center p-8 z-10">
                  <div class="w-16 h-16 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 flex items-center justify-center mx-auto mb-3">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                    </svg>
                  </div>
                  <h3 class="text-base font-bold text-white mb-1">Dokumen Berupa Tautan Eksternal</h3>
                  <p class="text-xs text-gray-400 max-w-sm mx-auto mb-5">
                    Berkas ini disimpan pada tautan eksternal (Google Drive, YouTube, Media Sosial, atau URL Portofolio).
                  </p>
                  <a
                    id="btn-visit-external-link"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-black text-xs font-bold shadow-lg shadow-cyan-500/20 transition-all"
                  >
                    <span>Buka Tautan di Tab Baru</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                  </a>
                </div>

                <!-- Live Iframe Viewer -->
                <iframe
                  id="doc-iframe"
                  src=""
                  class="w-full h-[480px] lg:h-[620px] border-0 rounded-2xl bg-white"
                  title="Pratinjau Dokumen B2"
                ></iframe>
              </div>

            </div>
          </div>

          <!-- ========================================================================= -->
          <!-- RIGHT PANEL: PROFILE BIO & FAST REVIEW FORM (Col Span 5 / 4) -->
          <!-- ========================================================================= -->
          <div class="lg:col-span-5 xl:col-span-4 flex flex-col gap-6">
            
            <!-- Participant Bio Card -->
            <div class="bg-[#121217] border border-white/10 rounded-3xl p-6 sm:p-7 shadow-xl">
              
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center gap-2">
                  <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-gray-300 text-xs font-mono">
                    #{cagen.nomorRegistrasi || '-'}
                  </span>
                  <span id="current-status-badge" class="px-2.5 py-1 rounded-full text-xs font-bold border bg-amber-500/15 text-amber-300 border-amber-500/30">
                    {cagen.statusPendaftaran}
                  </span>
                </div>

                {cagen.isVerified ? (
                  <span class="inline-flex items-center gap-1 text-[11px] text-emerald-400 font-semibold">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Verif
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1 text-[11px] text-rose-400 font-semibold">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    Unverif
                  </span>
                )}
              </div>

              <!-- Name and Major -->
              <h1 class="text-xl font-extrabold text-white tracking-tight leading-snug">
                {cagen.namaLengkap}
              </h1>
              <p class="text-xs text-amber-400 font-mono font-semibold mt-1">
                NIM: {cagen.nim}
              </p>

              <div class="mt-4 pt-4 border-t border-white/10 space-y-2.5 text-xs">
                <div class="flex items-center justify-between">
                  <span class="text-gray-400">Panggilan</span>
                  <span class="font-medium text-white">{cagen.namaPanggilan || '-'}</span>
                </div>

                <div class="flex items-center justify-between">
                  <span class="text-gray-400">Fakultas / Prodi</span>
                  <span class="font-medium text-white truncate max-w-[200px]">{cagen.jurusan}, {cagen.fakultas}</span>
                </div>

                <div class="flex items-center justify-between">
                  <span class="text-gray-400">Angkatan</span>
                  <span class="font-medium text-white">{cagen.angkatan}</span>
                </div>

                <div class="flex items-center justify-between">
                  <span class="text-gray-400">Peminatan</span>
                  <span class="font-bold text-amber-300 bg-amber-400/10 px-2 py-0.5 rounded border border-amber-400/20">
                    {cagen.peminatan || 'Belum Memilih'}
                  </span>
                </div>

                <div class="flex items-center justify-between pt-1">
                  <span class="text-gray-400">WhatsApp</span>
                  <a
                    href={formatWaUrl(cagen.noWa)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-emerald-400 hover:text-emerald-300 font-mono font-semibold flex items-center gap-1"
                  >
                    <span>{cagen.noWa}</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                  </a>
                </div>
              </div>
            </div>

            <!-- Fast Review & Decision Form -->
            <div class="bg-[#121217] border border-amber-500/30 rounded-3xl p-6 sm:p-7 shadow-xl flex flex-col justify-between relative overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>

              <div>
                <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-4">
                  <h2 class="text-base font-bold text-white tracking-tight">Keputusan Penilaian</h2>
                  <span class="text-[11px] font-mono text-amber-400">Fast Review</span>
                </div>

                <form id="review-form" class="space-y-4">
                  <!-- Status Selector -->
                  <div>
                    <label for="status-selector" class="block text-xs uppercase tracking-wider text-gray-300 font-semibold mb-2">
                      Status Seleksi Peserta *
                    </label>
                    <div class="relative">
                      <select
                        id="status-selector"
                        class="w-full px-4 py-3 rounded-xl bg-[#181822] border border-white/20 text-white text-xs sm:text-sm font-semibold focus:outline-none focus:border-amber-400 transition-colors cursor-pointer appearance-none pr-9"
                      >
                        {STATUS_PENDAFTARAN.map((s) => (
                          <option value={s} selected={cagen.statusPendaftaran === s}>{s}</option>
                        ))}
                      </select>
                      <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-gray-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                      </div>
                    </div>
                  </div>

                  <!-- Catatan Panitia Textarea -->
                  <div>
                    <label for="catatan-panitia" class="block text-xs uppercase tracking-wider text-gray-300 font-semibold mb-2">
                      Catatan Panitia / Feedback Peserta
                    </label>
                    <textarea
                      id="catatan-panitia"
                      rows="4"
                      placeholder="Contoh: KTM buram, tolong unggah ulang. Berkas karya sangat baik."
                      class="w-full px-4 py-3 rounded-xl bg-[#181822] border border-white/20 text-white placeholder-gray-500 text-xs focus:outline-none focus:border-amber-400 transition-colors resize-none leading-relaxed"
                    >{cagen.catatanPanitia || ''}</textarea>
                    <span class="text-[10px] text-gray-500 mt-1 block">Catatan ini dapat dilihat oleh panitia dan pendaftar terkait.</span>
                  </div>

                  <!-- Submit Action Button -->
                  <button
                    type="submit"
                    id="submit-review-btn"
                    class="w-full py-3.5 px-5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-extrabold text-sm shadow-lg shadow-amber-500/25 hover:shadow-amber-500/40 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer mt-2"
                  >
                    <span id="submit-btn-text">Simpan Penilaian</span>
                    <svg id="submit-btn-spinner" class="hidden w-4 h-4 animate-spin text-black" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                  </button>
                </form>
              </div>

            </div>

          </div>

        </div>

      </div>
    )}

  </div>
</MainLayout>

<!-- Client-side Fast Review & Split-Screen Document Viewer Controller -->
<script is:inline define:vars={{ applicantId, uploadedDocs }}>
  // DOM Elements
  const docTabs = document.querySelectorAll('.doc-tab');
  const iframe = document.getElementById('doc-iframe');
  const spinner = document.getElementById('viewer-spinner');
  const emptyBox = document.getElementById('viewer-empty');
  const linkBox = document.getElementById('viewer-link');
  const docTitle = document.getElementById('active-doc-title');
  const docBadge = document.getElementById('active-doc-badge');
  const openNewTabBtn = document.getElementById('btn-open-new-tab');
  const visitExternalBtn = document.getElementById('btn-visit-external-link');

  // Review Form DOM
  const reviewForm = document.getElementById('review-form');
  const statusSelector = document.getElementById('status-selector');
  const catatanInput = document.getElementById('catatan-panitia');
  const submitBtn = document.getElementById('submit-review-btn');
  const btnText = document.getElementById('submit-btn-text');
  const btnSpinner = document.getElementById('submit-btn-spinner');
  const currentBadge = document.getElementById('current-status-badge');
  const toastBox = document.getElementById('status-toast');
  const toastMessage = document.getElementById('toast-message');
  const toastIcon = document.getElementById('toast-icon');

  function showToast(isSuccess, message) {
    if (!toastBox || !toastMessage || !toastIcon) return;
    toastBox.classList.remove('hidden', 'bg-emerald-950/60', 'border-emerald-800/60', 'text-emerald-300', 'bg-rose-950/60', 'border-rose-800/60', 'text-rose-300');
    
    if (isSuccess) {
      toastBox.classList.add('bg-emerald-950/60', 'border', 'border-emerald-800/60', 'text-emerald-300');
      toastIcon.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
    } else {
      toastBox.classList.add('bg-rose-950/60', 'border', 'border-rose-800/60', 'text-rose-300');
      toastIcon.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
    }

    toastMessage.textContent = message;
    toastBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function updateBadgeColor(newStatus) {
    if (!currentBadge) return;
    currentBadge.textContent = newStatus;
    currentBadge.className = 'px-2.5 py-1 rounded-full text-xs font-bold border';

    if (newStatus === 'Review Berkas') {
      currentBadge.classList.add('bg-amber-500/15', 'text-amber-300', 'border-amber-500/30');
    } else if (newStatus === 'Berkas Diterima') {
      currentBadge.classList.add('bg-emerald-500/15', 'text-emerald-300', 'border-emerald-500/30');
    } else if (newStatus === 'Lulus') {
      currentBadge.classList.add('bg-blue-500/15', 'text-blue-300', 'border-blue-500/30');
    } else if (newStatus === 'Tidak Lulus') {
      currentBadge.classList.add('bg-rose-500/15', 'text-rose-300', 'border-rose-500/30');
    } else {
      currentBadge.classList.add('bg-gray-800', 'text-gray-300', 'border-gray-700');
    }
  }

  // Handle Document Tab Selection & Viewer Switching
  function selectDocument(doc) {
    if (!doc) return;

    // Update active tab buttons visual
    docTabs.forEach(tab => {
      const isCurrent = tab.getAttribute('data-slug') === doc.slug;
      const isUploaded = tab.getAttribute('data-is-uploaded') === 'true';

      if (isCurrent) {
        tab.className = 'doc-tab px-3 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all flex items-center gap-2 cursor-pointer border bg-amber-400 text-black border-amber-400 shadow-md shadow-amber-500/20';
        const dot = tab.querySelector('span');
        if (dot) dot.className = 'w-2 h-2 rounded-full bg-black';
      } else {
        tab.className = isUploaded
          ? 'doc-tab px-3 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all flex items-center gap-2 cursor-pointer border bg-[#181822] text-gray-200 border-white/10 hover:border-amber-400/40 hover:text-white'
          : 'doc-tab px-3 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all flex items-center gap-2 cursor-pointer border bg-white/[0.02] text-gray-500 border-white/5 hover:border-white/10';
        const dot = tab.querySelector('span');
        if (dot) dot.className = `w-2 h-2 rounded-full ${isUploaded ? 'bg-emerald-400' : 'bg-rose-500/70'}`;
      }
    });

    // Update Header Strip Info
    if (docTitle) docTitle.textContent = doc.label;
    if (docBadge) {
      if (doc.isUploaded) {
        docBadge.textContent = doc.isLink ? 'Tautan' : 'File Terunggah';
        docBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30';
      } else {
        docBadge.textContent = 'Belum Ada';
        docBadge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-500/15 text-rose-300 border border-rose-500/30';
      }
    }

    // Hide all view states initially
    if (iframe) iframe.classList.add('hidden');
    if (emptyBox) emptyBox.classList.add('hidden');
    if (linkBox) linkBox.classList.add('hidden');
    if (openNewTabBtn) openNewTabBtn.classList.add('hidden');

    if (!doc.isUploaded) {
      if (spinner) spinner.classList.add('hidden');
      if (emptyBox) emptyBox.classList.remove('hidden');
      return;
    }

    // If Document is an external URL / Link
    if (doc.isLink) {
      if (spinner) spinner.classList.add('hidden');
      if (linkBox) linkBox.classList.remove('hidden');
      if (openNewTabBtn) {
        openNewTabBtn.href = doc.s3Key;
        openNewTabBtn.classList.remove('hidden');
      }
      if (visitExternalBtn) {
        visitExternalBtn.href = doc.s3Key;
      }
      return;
    }

    // Document is a file in S3 / B2 storage
    const viewUrl = `/api/file/view?key=${encodeURIComponent(doc.s3Key)}`;
    if (openNewTabBtn) {
      openNewTabBtn.href = viewUrl;
      openNewTabBtn.classList.remove('hidden');
    }

    if (spinner) spinner.classList.remove('hidden');
    if (iframe) {
      iframe.src = viewUrl;
      iframe.classList.remove('hidden');
      iframe.onload = () => {
        if (spinner) spinner.classList.add('hidden');
      };
    }
  }

  // Attach Tab Click Listeners
  docTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const slug = tab.getAttribute('data-slug');
      const doc = uploadedDocs.find(d => d.slug === slug);
      if (doc) selectDocument(doc);
    });
  });

  // Initialize with first uploaded or available doc
  if (uploadedDocs && uploadedDocs.length > 0) {
    const defaultDoc = uploadedDocs.find(d => d.isUploaded) || uploadedDocs[0];
    selectDocument(defaultDoc);
  }

  // Handle Review Form Submission
  if (reviewForm) {
    reviewForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!applicantId) return;

      const newStatus = statusSelector ? statusSelector.value : '';
      const newCatatan = catatanInput ? catatanInput.value.trim() : '';

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Menyimpan...';
      if (btnSpinner) btnSpinner.classList.remove('hidden');

      try {
        const res = await fetch('/api/admin/status', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({
            cagenId: applicantId,
            status: newStatus,
            catatan_panitia: newCatatan,
          }),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          throw new Error(data.message || 'Gagal menyimpan penilaian peserta.');
        }

        showToast(true, data.message || 'Penilaian dan status berhasil diperbarui!');
        updateBadgeColor(newStatus);
      } catch (err) {
        showToast(false, err instanceof Error ? err.message : 'Terjadi kesalahan sistem.');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Simpan Penilaian';
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    });
  }
</script>
