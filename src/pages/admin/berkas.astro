---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';
import { createDb } from '../../db';
import { documentTypes, peminatan } from '../../db/schema';
import { eq, asc } from 'drizzle-orm';

const user = Astro.locals.user as AuthUser | null | undefined;
const isAdmin = user?.role === 'admin' || (user as any)?.isAdmin === true || String(user?.role).toLowerCase() === 'admin';

if (!user || !isAdmin) {
  return Astro.redirect('/auth/login');
}

let docList: any[] = [];
let peminatanOptions: any[] = [];
let dbError: string | null = null;

try {
  const db = createDb();
  docList = await db
    .select({
      id: documentTypes.id,
      slug: documentTypes.slug,
      label: documentTypes.label,
      group: documentTypes.group,
      peminatanId: documentTypes.peminatanId,
      peminatanNama: peminatan.nama,
      maxFiles: documentTypes.maxFiles,
      acceptMime: documentTypes.acceptMime,
      maxSizeBytes: documentTypes.maxSizeBytes,
      isActive: documentTypes.isActive,
      createdAt: documentTypes.createdAt,
    })
    .from(documentTypes)
    .leftJoin(peminatan, eq(documentTypes.peminatanId, peminatan.id))
    .orderBy(asc(documentTypes.id));

  peminatanOptions = await db
    .select({
      id: peminatan.id,
      nama: peminatan.nama,
    })
    .from(peminatan)
    .where(eq(peminatan.isActive, true))
    .orderBy(asc(peminatan.nama));
} catch (err: any) {
  console.error('Error fetching admin berkas data:', err);
  dbError = 'Gagal memuat daftar persyaratan berkas. Silakan muat ulang halaman.';
}

const totalDocs = docList.length;
const wajibDocs = docList.filter((d) => d.group === 'wajib').length;
const opsionalDocs = docList.filter((d) => d.group === 'opsional').length;
const karyaDocs = docList.filter((d) => d.group === 'karya').length;
---

<MainLayout title="Manajemen Persyaratan Berkas - Admin PERISAI UMI">
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Top Header Banner -->
    <div class="bg-gradient-to-r from-[#171720] via-[#1a1a24] to-[#121217] border border-amber-400/20 rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden mb-8">
      <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-amber-500/10 rounded-full blur-[90px] pointer-events-none"></div>

      <div class="flex flex-col xl:flex-row items-start xl:items-center justify-between gap-6 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-semibold mb-3">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            Panel Administrator (Panitia OPREC)
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Manajemen Persyaratan Berkas
          </h1>
          <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-2xl">
            Kelola aturan dokumen persyaratan secara dinamis: jenis berkas, kelompok wajib/opsional/karya, batasan format MIME, batas ukuran MB, dan kuota file pendaftar.
          </p>
        </div>

        <div class="flex items-center gap-2 sm:gap-2.5 flex-nowrap shrink-0 overflow-x-auto max-w-full pb-1">
          <a
            href="/admin/dashboard"
            class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white border border-white/10 text-xs font-bold whitespace-nowrap transition-all"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Dashboard
          </a>

          <a
            href="/admin/timeline"
            class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white border border-white/15 text-xs font-bold whitespace-nowrap transition-all"
          >
            Linimasa
          </a>

          <a
            href="/admin/qna"
            class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white border border-white/15 text-xs font-bold whitespace-nowrap transition-all"
          >
            Q&A
          </a>

          <a
            href="/admin/peminatan"
            class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white border border-white/15 text-xs font-bold whitespace-nowrap transition-all"
          >
            Peminatan
          </a>

          <a
            href="/admin/berkas"
            class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black border border-amber-400 font-bold text-xs whitespace-nowrap shadow-md shadow-amber-500/20 transition-all"
          >
            Berkas
          </a>

          <a
            href="/admin/pengaturan"
            class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white border border-white/15 text-xs font-bold whitespace-nowrap transition-all"
          >
            Pengaturan
          </a>
        </div>
      </div>
    </div>

    {dbError && (
      <div class="mb-8 p-4 rounded-2xl bg-rose-950/50 border border-rose-800/50 text-rose-300 text-sm flex items-center gap-3">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{dbError}</span>
      </div>
    )}

    <!-- KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
      <div class="bg-[#121217] border border-white/10 rounded-2xl p-5 hover:border-amber-400/40 transition-colors">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold block mb-1">Total Aturan Dokumen</span>
        <p class="text-3xl font-extrabold text-white font-mono">{totalDocs}</p>
        <span class="text-[11px] text-gray-500 mt-1 block">Tersimpan di master document_types</span>
      </div>

      <div class="bg-[#121217] border border-white/10 rounded-2xl p-5 hover:border-amber-400/40 transition-colors">
        <span class="text-xs uppercase tracking-wider text-amber-400/90 font-semibold block mb-1">Berkas Wajib</span>
        <p class="text-3xl font-extrabold text-amber-400 font-mono">{wajibDocs}</p>
        <span class="text-[11px] text-gray-500 mt-1 block">Administrasi utama & bukti medsos</span>
      </div>

      <div class="bg-[#121217] border border-white/10 rounded-2xl p-5 hover:border-blue-400/40 transition-colors">
        <span class="text-xs uppercase tracking-wider text-blue-400/90 font-semibold block mb-1">Berkas Opsional</span>
        <p class="text-3xl font-extrabold text-blue-400 font-mono">{opsionalDocs}</p>
        <span class="text-[11px] text-gray-500 mt-1 block">Sertifikat & dokumen penunjang</span>
      </div>

      <div class="bg-[#121217] border border-white/10 rounded-2xl p-5 hover:border-emerald-400/40 transition-colors">
        <span class="text-xs uppercase tracking-wider text-emerald-400/90 font-semibold block mb-1">Penugasan Karya</span>
        <p class="text-3xl font-extrabold text-emerald-400 font-mono">{karyaDocs}</p>
        <span class="text-[11px] text-gray-500 mt-1 block">Terkait peminatan khusus</span>
      </div>
    </div>

    <!-- Filter & Action Controls -->
    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 mb-6">
      <div class="flex flex-wrap items-center gap-3 flex-1">
        <!-- Search Input -->
        <div class="relative flex-1 min-w-[200px]">
          <svg class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            type="text"
            id="search-input"
            placeholder="Cari nama berkas atau slug..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[#161620] border border-white/10 text-white placeholder-gray-500 text-xs focus:outline-none focus:border-amber-400 transition-colors"
          />
        </div>

        <!-- Filter Group Dropdown -->
        <select
          id="filter-group"
          class="px-3.5 py-2.5 rounded-xl bg-[#161620] border border-white/10 text-white text-xs focus:outline-none focus:border-amber-400 cursor-pointer"
        >
          <option value="all">Semua Kelompok</option>
          <option value="wajib">Kelompok Wajib</option>
          <option value="opsional">Kelompok Opsional</option>
          <option value="karya">Kelompok Karya</option>
        </select>
      </div>

      <!-- Add New Button -->
      <button
        type="button"
        id="btn-open-add-modal"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-xs shadow-lg shadow-amber-500/20 hover:shadow-amber-500/35 transition-all cursor-pointer whitespace-nowrap"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Tambah Persyaratan Berkas</span>
      </button>
    </div>

    <!-- Documents Table Card -->
    <div class="bg-[#121217] border border-white/10 rounded-3xl overflow-hidden shadow-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="border-b border-white/10 bg-[#161622] text-gray-400 uppercase tracking-wider font-mono">
              <th class="py-4 px-5">Nama Dokumen & Slug</th>
              <th class="py-4 px-4">Kelompok</th>
              <th class="py-4 px-4">Peminatan Terkait</th>
              <th class="py-4 px-4">Format MIME</th>
              <th class="py-4 px-4 text-center">Batas Ukuran</th>
              <th class="py-4 px-4 text-center">Max File</th>
              <th class="py-4 px-4 text-center">Status</th>
              <th class="py-4 px-5 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody id="documents-tbody" class="divide-y divide-white/5">
            {docList.length === 0 ? (
              <tr>
                <td colspan="8" class="py-12 text-center text-gray-500">
                  Belum ada persyaratan dokumen yang terdaftar.
                </td>
              </tr>
            ) : (
              docList.map((doc) => {
                const sizeMB = (doc.maxSizeBytes / (1024 * 1024)).toFixed(1).replace('.0', '');
                
                let groupBadgeClass = 'bg-amber-400/10 text-amber-300 border-amber-400/30';
                if (doc.group === 'opsional') groupBadgeClass = 'bg-blue-400/10 text-blue-300 border-blue-400/30';
                if (doc.group === 'karya') groupBadgeClass = 'bg-emerald-400/10 text-emerald-300 border-emerald-400/30';

                return (
                  <tr
                    class="hover:bg-white/[0.02] transition-colors doc-row"
                    data-id={doc.id}
                    data-slug={doc.slug}
                    data-label={doc.label}
                    data-group={doc.group}
                    data-peminatan-id={doc.peminatanId || ''}
                    data-accept-mime={doc.acceptMime}
                    data-max-size-mb={sizeMB}
                    data-max-files={doc.maxFiles}
                    data-is-active={doc.isActive ? 'true' : 'false'}
                  >
                    <td class="py-4 px-5">
                      <div class="font-bold text-white text-sm">{doc.label}</div>
                      <div class="font-mono text-[11px] text-gray-500 mt-0.5">{doc.slug}</div>
                    </td>

                    <td class="py-4 px-4">
                      <span class={`inline-block px-2.5 py-1 rounded-full text-[10px] font-bold uppercase border ${groupBadgeClass}`}>
                        {doc.group}
                      </span>
                    </td>

                    <td class="py-4 px-4">
                      {doc.peminatanNama ? (
                        <span class="inline-block px-2.5 py-1 rounded-lg bg-white/5 text-amber-300 border border-white/10 font-semibold text-[11px]">
                          {doc.peminatanNama}
                        </span>
                      ) : (
                        <span class="text-gray-500 font-mono">Semua (Umum)</span>
                      )}
                    </td>

                    <td class="py-4 px-4 max-w-[220px]">
                      <div class="flex flex-wrap gap-1">
                        {doc.acceptMime.includes('pdf') && (
                          <span class="px-1.5 py-0.5 rounded bg-red-500/15 text-red-300 border border-red-500/30 text-[10px] font-mono">PDF</span>
                        )}
                        {(doc.acceptMime.includes('jpeg') || doc.acceptMime.includes('jpg') || doc.acceptMime.includes('png')) && (
                          <span class="px-1.5 py-0.5 rounded bg-sky-500/15 text-sky-300 border border-sky-500/30 text-[10px] font-mono">Gambar</span>
                        )}
                        {doc.acceptMime.includes('zip') && (
                          <span class="px-1.5 py-0.5 rounded bg-yellow-500/15 text-yellow-300 border border-yellow-500/30 text-[10px] font-mono">ZIP</span>
                        )}
                        {doc.acceptMime.includes('mp4') && (
                          <span class="px-1.5 py-0.5 rounded bg-purple-500/15 text-purple-300 border border-purple-500/30 text-[10px] font-mono">MP4</span>
                        )}
                      </div>
                    </td>

                    <td class="py-4 px-4 text-center font-mono font-bold text-gray-200">
                      {sizeMB} MB
                    </td>

                    <td class="py-4 px-4 text-center font-mono text-gray-300">
                      {doc.maxFiles} File
                    </td>

                    <td class="py-4 px-4 text-center">
                      {doc.isActive ? (
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                          Aktif
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/15 text-rose-400 border border-rose-500/30">
                          <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                          Nonaktif
                        </span>
                      )}
                    </td>

                    <td class="py-4 px-5 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <button
                          type="button"
                          class="btn-edit-doc p-2 rounded-lg bg-white/5 hover:bg-amber-400/20 text-gray-300 hover:text-amber-300 border border-white/10 transition-colors cursor-pointer"
                          title="Edit Aturan Dokumen"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                          </svg>
                        </button>

                        <button
                          type="button"
                          class="btn-toggle-active p-2 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white border border-white/10 transition-colors cursor-pointer"
                          title={doc.isActive ? 'Nonaktifkan Dokumen' : 'Aktifkan Dokumen'}
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- ============================================================ -->
  <!-- MODAL: TAMBAH / EDIT PERSYARATAN BERKAS -->
  <!-- ============================================================ -->
  <div
    id="doc-modal"
    class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/80 backdrop-blur-sm flex items-center justify-center p-4"
  >
    <div class="relative w-full max-w-xl bg-[#15151e] border border-amber-500/30 rounded-3xl p-6 sm:p-8 shadow-2xl text-left overflow-hidden">
      <!-- Glow background -->
      <div class="absolute -top-12 -right-12 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
        <div>
          <h3 id="modal-title" class="text-lg sm:text-xl font-bold text-white tracking-tight">
            Tambah Persyaratan Berkas Baru
          </h3>
          <p class="text-xs text-gray-400 mt-0.5">
            Konfigurasi batas ukuran, ekstensi yang diperbolehkan, dan grup dokumen.
          </p>
        </div>
        <button
          type="button"
          id="btn-close-modal"
          class="p-2 rounded-xl bg-white/5 hover:bg-white/10 text-gray-400 hover:text-white transition-colors cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Modal Form -->
      <form id="doc-form" class="space-y-4">
        <input type="hidden" id="form-doc-id" value="" />

        <!-- Nama Dokumen (Label) -->
        <div>
          <label for="form-label" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
            Nama Dokumen (Label) *
          </label>
          <input
            type="text"
            id="form-label"
            required
            placeholder="Contoh: Surat Izin Orang Tua / Wali"
            class="w-full px-4 py-2.5 rounded-xl bg-[#1d1d28] border border-white/15 text-white placeholder-gray-500 text-xs sm:text-sm focus:outline-none focus:border-amber-400 transition-colors"
          />
        </div>

        <!-- Slug (Identifier) -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="form-slug" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider">
              Slug Identifier
            </label>
            <span class="text-[10px] text-gray-500 font-mono">Dibuat otomatis jika dikosongkan</span>
          </div>
          <input
            type="text"
            id="form-slug"
            placeholder="contoh: surat_izin_ortu"
            class="w-full px-4 py-2 rounded-xl bg-[#1d1d28] border border-white/15 text-amber-300 font-mono placeholder-gray-600 text-xs focus:outline-none focus:border-amber-400 transition-colors"
          />
        </div>

        <!-- Kelompok (Group) & Relasi Peminatan -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="form-group" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
              Kelompok Dokumen *
            </label>
            <select
              id="form-group"
              required
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#1d1d28] border border-white/15 text-white text-xs focus:outline-none focus:border-amber-400 cursor-pointer"
            >
              <option value="wajib">Wajib (Administrasi/Medsos)</option>
              <option value="opsional">Opsional (Nilai Tambah)</option>
              <option value="karya">Karya (Tugas Peminatan)</option>
            </select>
          </div>

          <div>
            <label for="form-peminatan" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
              Relasi Peminatan
            </label>
            <select
              id="form-peminatan"
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#1d1d28] border border-white/15 text-white text-xs focus:outline-none focus:border-amber-400 cursor-pointer"
            >
              <option value="">Semua Peminatan (Umum)</option>
              {peminatanOptions.map((p) => (
                <option value={p.id}>{p.nama}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Format File yang Diterima (Checkboxes) -->
        <div class="pt-2">
          <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
            Format File yang Diterima *
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            <label class="flex items-center gap-2 p-2.5 rounded-xl bg-[#1d1d28] border border-white/10 hover:border-amber-400/40 cursor-pointer transition-colors">
              <input type="checkbox" name="mime-type" value="application/pdf" class="rounded text-amber-400 focus:ring-0" checked />
              <span class="text-xs font-medium text-gray-200">PDF (.pdf)</span>
            </label>

            <label class="flex items-center gap-2 p-2.5 rounded-xl bg-[#1d1d28] border border-white/10 hover:border-amber-400/40 cursor-pointer transition-colors">
              <input type="checkbox" name="mime-type" value="image/jpeg,image/png" class="rounded text-amber-400 focus:ring-0" />
              <span class="text-xs font-medium text-gray-200">Gambar</span>
            </label>

            <label class="flex items-center gap-2 p-2.5 rounded-xl bg-[#1d1d28] border border-white/10 hover:border-amber-400/40 cursor-pointer transition-colors">
              <input type="checkbox" name="mime-type" value="application/zip,application/x-zip-compressed" class="rounded text-amber-400 focus:ring-0" />
              <span class="text-xs font-medium text-gray-200">Arsip (.zip)</span>
            </label>

            <label class="flex items-center gap-2 p-2.5 rounded-xl bg-[#1d1d28] border border-white/10 hover:border-amber-400/40 cursor-pointer transition-colors">
              <input type="checkbox" name="mime-type" value="video/mp4" class="rounded text-amber-400 focus:ring-0" />
              <span class="text-xs font-medium text-gray-200">Video (.mp4)</span>
            </label>
          </div>
        </div>

        <!-- Ukuran Maksimal (MB) & Jumlah File -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
          <div>
            <label for="form-max-mb" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
              Ukuran Maksimal (MB) *
            </label>
            <div class="flex items-center gap-2">
              <input
                type="number"
                id="form-max-mb"
                required
                min="0.5"
                max="100"
                step="0.5"
                value="2"
                class="w-full px-4 py-2.5 rounded-xl bg-[#1d1d28] border border-white/15 text-white font-mono text-xs sm:text-sm focus:outline-none focus:border-amber-400 transition-colors"
              />
              <div class="flex items-center gap-1 shrink-0">
                <button type="button" class="btn-preset-mb px-2 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-[10px] font-mono text-gray-300" data-mb="2">2M</button>
                <button type="button" class="btn-preset-mb px-2 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-[10px] font-mono text-gray-300" data-mb="5">5M</button>
                <button type="button" class="btn-preset-mb px-2 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-[10px] font-mono text-gray-300" data-mb="50">50M</button>
              </div>
            </div>
          </div>

          <div>
            <label for="form-max-files" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
              Jumlah Maksimal File *
            </label>
            <input
              type="number"
              id="form-max-files"
              required
              min="1"
              max="10"
              value="1"
              class="w-full px-4 py-2.5 rounded-xl bg-[#1d1d28] border border-white/15 text-white font-mono text-xs sm:text-sm focus:outline-none focus:border-amber-400 transition-colors"
            />
          </div>
        </div>

        <!-- Checkbox Status Aktif -->
        <div class="pt-2">
          <label class="flex items-center gap-2.5 cursor-pointer select-none">
            <input
              type="checkbox"
              id="form-is-active"
              checked
              class="w-4 h-4 rounded text-amber-400 focus:ring-0 cursor-pointer"
            />
            <span class="text-xs font-medium text-gray-200">
              Aktifkan persyaratan ini (Tampil di dashboard pendaftar)
            </span>
          </label>
        </div>

        <!-- Form Buttons -->
        <div class="flex items-center justify-end gap-3 pt-5 border-t border-white/10 mt-6">
          <button
            type="button"
            id="btn-cancel-modal"
            class="px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 text-xs font-bold transition-colors cursor-pointer"
          >
            Batal
          </button>

          <button
            type="submit"
            id="btn-submit-modal"
            class="px-6 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black text-xs font-bold shadow-lg shadow-amber-500/20 transition-all cursor-pointer"
          >
            Simpan Persyaratan
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Toast Notification -->
  <div
    id="admin-toast"
    class="hidden fixed bottom-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all duration-300 text-xs flex items-center gap-3"
  >
    <div id="admin-toast-icon"></div>
    <div>
      <div id="admin-toast-title" class="font-bold"></div>
      <div id="admin-toast-message" class="text-gray-300 mt-0.5"></div>
    </div>
  </div>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('doc-modal');
    const modalTitle = document.getElementById('modal-title');
    const docForm = document.getElementById('doc-form') as HTMLFormElement | null;
    const btnOpenAdd = document.getElementById('btn-open-add-modal');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnCancelModal = document.getElementById('btn-cancel-modal');

    const formId = document.getElementById('form-doc-id') as HTMLInputElement | null;
    const formLabel = document.getElementById('form-label') as HTMLInputElement | null;
    const formSlug = document.getElementById('form-slug') as HTMLInputElement | null;
    const formGroup = document.getElementById('form-group') as HTMLSelectElement | null;
    const formPeminatan = document.getElementById('form-peminatan') as HTMLSelectElement | null;
    const formMaxMB = document.getElementById('form-max-mb') as HTMLInputElement | null;
    const formMaxFiles = document.getElementById('form-max-files') as HTMLInputElement | null;
    const formIsActive = document.getElementById('form-is-active') as HTMLInputElement | null;

    // Toast helper
    function showToast(type: 'success' | 'error', title: string, message: string) {
      const toast = document.getElementById('admin-toast');
      const toastIcon = document.getElementById('admin-toast-icon');
      const toastTitle = document.getElementById('admin-toast-title');
      const toastMsg = document.getElementById('admin-toast-message');
      if (!toast || !toastIcon || !toastTitle || !toastMsg) return;

      toastTitle.textContent = title;
      toastMsg.textContent = message;

      if (type === 'success') {
        toast.className = 'fixed bottom-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all duration-300 text-xs flex items-center gap-3 bg-[#121f17] border-emerald-500/40 text-emerald-300';
        toastIcon.innerHTML = `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>`;
      } else {
        toast.className = 'fixed bottom-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all duration-300 text-xs flex items-center gap-3 bg-[#261317] border-rose-500/40 text-rose-300';
        toastIcon.innerHTML = `<svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
      }

      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 5000);
    }

    // Modal Control
    function openAddModal() {
      if (!modal || !docForm) return;
      if (modalTitle) modalTitle.textContent = 'Tambah Persyaratan Berkas Baru';
      if (formId) formId.value = '';
      if (formLabel) formLabel.value = '';
      if (formSlug) formSlug.value = '';
      if (formGroup) formGroup.value = 'wajib';
      if (formPeminatan) formPeminatan.value = '';
      if (formMaxMB) formMaxMB.value = '2';
      if (formMaxFiles) formMaxFiles.value = '1';
      if (formIsActive) formIsActive.checked = true;

      // Default checkbox: PDF only
      document.querySelectorAll<HTMLInputElement>('input[name="mime-type"]').forEach((cb) => {
        cb.checked = cb.value === 'application/pdf';
      });

      modal.classList.remove('hidden');
    }

    function openEditModal(row: HTMLElement) {
      if (!modal || !docForm) return;
      if (modalTitle) modalTitle.textContent = 'Edit Persyaratan Berkas';

      const id = row.getAttribute('data-id') || '';
      const slug = row.getAttribute('data-slug') || '';
      const label = row.getAttribute('data-label') || '';
      const group = row.getAttribute('data-group') || 'wajib';
      const peminatanId = row.getAttribute('data-peminatan-id') || '';
      const acceptMime = row.getAttribute('data-accept-mime') || '';
      const maxMB = row.getAttribute('data-max-size-mb') || '2';
      const maxFiles = row.getAttribute('data-max-files') || '1';
      const isActive = row.getAttribute('data-is-active') === 'true';

      if (formId) formId.value = id;
      if (formSlug) formSlug.value = slug;
      if (formLabel) formLabel.value = label;
      if (formGroup) formGroup.value = group;
      if (formPeminatan) formPeminatan.value = peminatanId;
      if (formMaxMB) formMaxMB.value = maxMB;
      if (formMaxFiles) formMaxFiles.value = maxFiles;
      if (formIsActive) formIsActive.checked = isActive;

      // Checked mime types
      document.querySelectorAll<HTMLInputElement>('input[name="mime-type"]').forEach((cb) => {
        cb.checked = acceptMime.includes(cb.value.split(',')[0]);
      });

      modal.classList.remove('hidden');
    }

    function closeModal() {
      if (modal) modal.classList.add('hidden');
    }

    if (btnOpenAdd) btnOpenAdd.addEventListener('click', openAddModal);
    if (btnCloseModal) btnCloseModal.addEventListener('click', closeModal);
    if (btnCancelModal) btnCancelModal.addEventListener('click', closeModal);

    // Preset MB buttons
    document.querySelectorAll<HTMLButtonElement>('.btn-preset-mb').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mb = btn.getAttribute('data-mb');
        if (mb && formMaxMB) formMaxMB.value = mb;
      });
    });

    // Row Edit Buttons
    document.querySelectorAll<HTMLButtonElement>('.btn-edit-doc').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest<HTMLElement>('.doc-row');
        if (row) openEditModal(row);
      });
    });

    // Toggle Active/Inactive
    document.querySelectorAll<HTMLButtonElement>('.btn-toggle-active').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const row = btn.closest<HTMLElement>('.doc-row');
        if (!row) return;
        const id = row.getAttribute('data-id');
        const currentActive = row.getAttribute('data-is-active') === 'true';
        const newActive = !currentActive;

        try {
          const res = await fetch('/api/admin/documents', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, isActive: newActive }),
          });
          const data = await res.json() as any;
          if (!res.ok || !data.success) throw new Error(data.message || 'Gagal mengubah status');

          showToast('success', 'Status Diperbarui', `Dokumen berhasil ${newActive ? 'diaktifkan' : 'dinonaktifkan'}.`);
          setTimeout(() => window.location.reload(), 1000);
        } catch (e: any) {
          showToast('error', 'Gagal', e.message);
        }
      });
    });

    // Form Submit Handler (Create / Update)
    if (docForm) {
      docForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const id = formId?.value.trim();
        const isEdit = Boolean(id);
        const label = formLabel?.value.trim() || '';
        const slug = formSlug?.value.trim() || '';
        const group = formGroup?.value || 'wajib';
        const peminatanId = formPeminatan?.value ? Number(formPeminatan.value) : null;
        const maxSizeMB = Number(formMaxMB?.value || '2');
        const maxFiles = Number(formMaxFiles?.value || '1');
        const isActive = formIsActive?.checked ?? true;

        // Collect checked MIME types
        const selectedMimes: string[] = [];
        document.querySelectorAll<HTMLInputElement>('input[name="mime-type"]:checked').forEach((cb) => {
          selectedMimes.push(cb.value);
        });

        if (selectedMimes.length === 0) {
          showToast('error', 'Validasi Gagal', 'Pilih minimal satu format file yang diperbolehkan.');
          return;
        }

        const acceptMime = selectedMimes.join(',');

        const payload: Record<string, any> = {
          label,
          slug: slug || undefined,
          group,
          peminatanId,
          acceptMime,
          maxSizeMB,
          maxFiles,
          isActive,
        };

        if (isEdit) {
          payload.id = Number(id);
        }

        const submitBtn = document.getElementById('btn-submit-modal') as HTMLButtonElement | null;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Menyimpan...';
        }

        try {
          const res = await fetch('/api/admin/documents', {
            method: isEdit ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json() as any;
          if (!res.ok || !data.success) {
            throw new Error(data.message || 'Gagal menyimpan data persyaratan.');
          }

          showToast('success', 'Berhasil', data.message || 'Persyaratan berkas berhasil disimpan.');
          closeModal();
          setTimeout(() => window.location.reload(), 1000);
        } catch (err: any) {
          showToast('error', 'Gagal Menyimpan', err.message);
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Simpan Persyaratan';
          }
        }
      });
    }

    // Search and Group Filter
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const filterGroup = document.getElementById('filter-group') as HTMLSelectElement | null;
    const rows = document.querySelectorAll<HTMLElement>('.doc-row');

    function filterRows() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const groupVal = filterGroup?.value || 'all';

      rows.forEach((row) => {
        const label = (row.getAttribute('data-label') || '').toLowerCase();
        const slug = (row.getAttribute('data-slug') || '').toLowerCase();
        const group = (row.getAttribute('data-group') || '').toLowerCase();

        const matchesQuery = !q || label.includes(q) || slug.includes(q);
        const matchesGroup = groupVal === 'all' || group === groupVal;

        if (matchesQuery && matchesGroup) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    if (searchInput) searchInput.addEventListener('input', filterRows);
    if (filterGroup) filterGroup.addEventListener('change', filterRows);
  });
</script>
