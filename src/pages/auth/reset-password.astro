---
import MainLayout from '../../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import logoPerisai from '../../assets/img/logoperisai.webp';

const token = Astro.url.searchParams.get('token') || '';
---

<MainLayout title="Atur Ulang Kata Sandi - PERISAI UMI">
  <div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative">
    <!-- Ambient Glow Effect -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-amber-500/10 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="max-w-md w-full relative z-10">
      <!-- Card Container -->
      <div class="bg-[#141418] border border-amber-400/20 rounded-3xl p-8 sm:p-10 shadow-2xl relative overflow-hidden backdrop-blur-xl">
        <!-- Top Accent Line -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>

        <!-- Logo & Title -->
        <div class="text-center mb-8">
          <Image
            src={logoPerisai}
            alt="Logo PERISAI UMI"
            width={490}
            height={112}
            quality={95}
            format="webp"
            loading="eager"
            class="h-12 w-auto mx-auto mb-4 drop-shadow-[0_0_15px_rgba(245,158,11,0.25)]"
          />
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Atur Ulang Kata Sandi</h1>
          <p class="text-xs sm:text-sm text-gray-400 mt-1">
            Masukkan kata sandi baru untuk akun pendaftaran Anda.
          </p>
        </div>

        {!token ? (
          <div class="text-center py-6 space-y-6">
            <div class="w-16 h-16 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 flex items-center justify-center mx-auto">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-lg font-bold text-white mb-1">Tautan Tidak Valid</h2>
              <p class="text-sm text-gray-400 leading-relaxed">
                Tautan pengaturan ulang kata sandi tidak memiliki token verifikasi. Silakan ajukan permohonan tautan baru melalui dashboard akun Anda.
              </p>
            </div>
            <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
              <a
                href="/auth/login"
                class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-sm shadow-md transition-colors"
              >
                Halaman Masuk
              </a>
              <a
                href="/"
                class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white text-sm font-semibold border border-white/10 transition-colors"
              >
                Beranda
              </a>
            </div>
          </div>
        ) : (
          <div>
            <!-- Alert Messages -->
            <div
              id="error-alert"
              class="hidden mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm flex items-start gap-3"
              role="alert"
            >
              <svg class="w-5 h-5 flex-shrink-0 text-rose-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span id="error-message">Terjadi kesalahan. Silakan coba lagi.</span>
            </div>

            <!-- Success State Box -->
            <div id="success-box" class="hidden text-center py-6 space-y-6">
              <div class="w-16 h-16 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center mx-auto">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <h2 class="text-xl font-bold text-white mb-1">Kata Sandi Berhasil Diperbarui!</h2>
                <p class="text-sm text-gray-400 leading-relaxed">
                  Kata sandi baru Anda telah aktif. Anda sekarang dapat masuk menggunakan kredensial baru.
                </p>
              </div>
              <a
                href="/auth/login"
                class="inline-block w-full py-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-sm shadow-lg shadow-amber-500/20 transition-all text-center"
              >
                Masuk Sekarang
              </a>
            </div>

            <!-- Reset Form -->
            <form id="reset-form" class="space-y-5">
              <input type="hidden" id="token" value={token} />

              <div>
                <label for="password" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
                  Kata Sandi Baru *
                </label>
                <div class="relative">
                  <input
                    type="password"
                    id="password"
                    name="password"
                    required
                    minlength="6"
                    placeholder="Minimal 6 karakter"
                    class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-amber-400 text-sm pr-11"
                  />
                  <button
                    type="button"
                    class="toggle-password absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-400 hover:text-white"
                    data-target="password"
                    aria-label="Tampilkan sandi"
                  >
                    <svg class="w-5 h-5 eye-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <div>
                <label for="confirmPassword" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
                  Konfirmasi Kata Sandi Baru *
                </label>
                <div class="relative">
                  <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    required
                    minlength="6"
                    placeholder="Ulangi kata sandi baru"
                    class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-amber-400 text-sm pr-11"
                  />
                  <button
                    type="button"
                    class="toggle-password absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-400 hover:text-white"
                    data-target="confirmPassword"
                    aria-label="Tampilkan konfirmasi sandi"
                  >
                    <svg class="w-5 h-5 eye-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="text-xs text-gray-400 space-y-1 bg-white/5 p-3.5 rounded-xl border border-white/5">
                <div class="font-semibold text-gray-300">Ketentuan Kata Sandi:</div>
                <div class="flex items-center gap-2" id="rule-length">
                  <span class="w-1.5 h-1.5 rounded-full bg-gray-500"></span>
                  <span>Minimal 6 karakter</span>
                </div>
                <div class="flex items-center gap-2" id="rule-match">
                  <span class="w-1.5 h-1.5 rounded-full bg-gray-500"></span>
                  <span>Kedua sandi harus sama persis</span>
                </div>
              </div>

              <button
                type="submit"
                id="submit-btn"
                class="w-full py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-sm shadow-lg shadow-amber-500/20 hover:shadow-amber-500/35 transition-all duration-200 flex items-center justify-center gap-2 mt-4"
              >
                <span id="btn-text">Simpan Kata Sandi Baru</span>
                <svg
                  id="btn-spinner"
                  class="hidden animate-spin h-5 w-5 text-black"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  ></path>
                </svg>
              </button>
            </form>
          </div>
        )}

        <div class="mt-8 pt-6 border-t border-white/10 text-center text-xs text-gray-400">
          Sudah ingat kata sandi Anda?{' '}
          <a href="/auth/login" class="text-amber-400 hover:underline font-semibold">
            Masuk ke Akun
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('reset-form') as HTMLFormElement | null;
    const tokenInput = document.getElementById('token') as HTMLInputElement | null;
    const passwordInput = document.getElementById('password') as HTMLInputElement | null;
    const confirmPasswordInput = document.getElementById('confirmPassword') as HTMLInputElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text') as HTMLSpanElement | null;
    const btnSpinner = document.getElementById('btn-spinner') as SVGElement | null;
    const errorAlert = document.getElementById('error-alert') as HTMLDivElement | null;
    const errorMessage = document.getElementById('error-message') as HTMLSpanElement | null;
    const successBox = document.getElementById('success-box') as HTMLDivElement | null;

    // Toggle Password Visibility
    document.querySelectorAll('.toggle-password').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const targetInput = document.getElementById(targetId) as HTMLInputElement | null;
        if (!targetInput) return;

        const isPassword = targetInput.type === 'password';
        targetInput.type = isPassword ? 'text' : 'password';

        const svg = btn.querySelector('svg');
        if (svg) {
          if (isPassword) {
            svg.innerHTML = `
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
            `;
          } else {
            svg.innerHTML = `
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            `;
          }
        }
      });
    });

    // Form Submission
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const token = tokenInput?.value?.trim() || '';
        const password = passwordInput?.value || '';
        const confirmPassword = confirmPasswordInput?.value || '';

        // Hide errors
        if (errorAlert) errorAlert.classList.add('hidden');

        if (!password || password.length < 6) {
          if (errorMessage) errorMessage.textContent = 'Kata sandi minimal terdiri dari 6 karakter.';
          if (errorAlert) errorAlert.classList.remove('hidden');
          return;
        }

        if (password !== confirmPassword) {
          if (errorMessage) errorMessage.textContent = 'Konfirmasi kata sandi tidak cocok.';
          if (errorAlert) errorAlert.classList.remove('hidden');
          return;
        }

        // Set Loading State
        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Menyimpan...';
        if (btnSpinner) btnSpinner.classList.remove('hidden');

        try {
          const res = await fetch('/api/auth/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token, password, confirmPassword }),
          });

          const data: any = await res.json();

          if (!res.ok || !data.success) {
            throw new Error(data.message || 'Gagal mengatur ulang kata sandi.');
          }

          // Show Success
          form.classList.add('hidden');
          if (successBox) successBox.classList.remove('hidden');
        } catch (err: any) {
          if (errorMessage) errorMessage.textContent = err.message || 'Terjadi kesalahan sistem.';
          if (errorAlert) errorAlert.classList.remove('hidden');
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Simpan Kata Sandi Baru';
          if (btnSpinner) btnSpinner.classList.add('hidden');
        }
      });
    }
  </script>
</MainLayout>
