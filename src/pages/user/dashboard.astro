---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';

const user = Astro.locals.user as AuthUser | null | undefined;
if (!user || user.role !== 'user') {
  return Astro.redirect('/auth/login');
}
---

<MainLayout title="Dashboard Peserta - PERISAI UMI">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Welcome Header Card -->
    <div class="bg-gradient-to-r from-[#171720] via-[#1a1a24] to-[#121217] border border-amber-400/20 rounded-3xl p-8 sm:p-10 shadow-xl relative overflow-hidden mb-8">
      <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-amber-500/10 rounded-full blur-[90px] pointer-events-none"></div>

      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold mb-3">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Status Sesi: Terotentikasi (Peserta)
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
            Selamat Datang, <span class="text-amber-400">{user.name}</span>!
          </h1>
          <p class="text-sm sm:text-base text-gray-400 mt-2 max-w-2xl">
            Ini adalah portal calon anggota baru UKM PERISAI UMI. Anda dapat memantau status seleksi dan melengkapi berkas administrasi di sini.
          </p>
        </div>

        <a
          href="/api/auth/logout"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-rose-950/40 hover:bg-rose-900/60 border border-rose-800/40 text-rose-300 hover:text-white text-sm font-semibold transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          Keluar (Logout)
        </a>
      </div>
    </div>

    <!-- User Information Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-[#121217] border border-white/10 rounded-2xl p-6">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold block mb-1">Nama Lengkap</span>
        <p class="text-lg font-bold text-white">{user.name}</p>
      </div>

      <div class="bg-[#121217] border border-white/10 rounded-2xl p-6">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold block mb-1">Nomor Induk Mahasiswa (NIM)</span>
        <p class="text-lg font-bold text-amber-400 font-mono">{user.nim || 'Belum terdata'}</p>
      </div>

      <div class="bg-[#121217] border border-white/10 rounded-2xl p-6">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold block mb-1">Alamat Email</span>
        <p class="text-lg font-bold text-white truncate">{user.email || '-'}</p>
      </div>
    </div>

    <!-- Status Overview Shell -->
    <div class="bg-[#121217] border border-white/10 rounded-2xl p-8">
      <h2 class="text-lg font-bold text-white mb-2">Status Pendaftaran & Verifikasi</h2>
      <p class="text-sm text-gray-400 mb-6">
        Middleware otentikasi JWT edge berhasil memverifikasi akun Anda. Form pengunggahan berkas dan tracking status seleksi akan dimuat pada fase selanjutnya.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/user/form-daftar" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-sm shadow-md transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
          Unggah Berkas Pendaftaran
        </a>
        <div class="inline-flex items-center gap-3 px-4 py-2.5 rounded-xl bg-amber-400/10 border border-amber-400/20 text-amber-300 text-sm">
        </div>
        <span class="font-bold">Role:</span> {user.role.toUpperCase()} &bull; <span class="font-bold">User ID:</span> #{user.id}
      </div>
    </div>

  </div>
</MainLayout>

