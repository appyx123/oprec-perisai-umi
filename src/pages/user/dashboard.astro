                            {doc.isLink ? 'Buka Tautan' : 'Lihat'}
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                            </svg>
                          </a>
                        )}
                      </>
                    ) : (
                      <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30">
                        Belum Diunggah
                      </span>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Optional Documents List -->
      {optionalDocs.length > 0 && (
        <div>
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-gray-500"></span>
            Berkas Pendukung / Nilai Tambah (Opsional)
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {optionalDocs.map((doc) => (
              <div class={`p-4 rounded-2xl border transition-all ${
                doc.uploaded
                  ? 'bg-[#15151d] border-emerald-500/20'
                  : 'bg-[#15151d] border-white/5'
              }`}>
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <div class="flex items-center gap-2">
                      <h4 class="font-bold text-xs text-white leading-snug">{doc.name}</h4>
                      {doc.inputType === 'link' && (
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-blue-500/15 text-blue-300 border border-blue-500/30">
                          LINK
                        </span>
                      )}
                    </div>
                    <p class="text-[11px] text-gray-500 mt-1">{doc.description}</p>
                  </div>

                  <div class="flex flex-col items-end gap-1 flex-shrink-0">
                    {doc.uploaded ? (
                      <>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                          Terlampir
                        </span>
                        {doc.fileName && (
                          <a
                            href={doc.isLink ? doc.fileName : `/api/file/view?name=${encodeURIComponent(doc.fileName)}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-[10px] text-amber-400 hover:underline"
                          >
                            {doc.isLink ? 'Buka Tautan' : 'Lihat'}
                          </a>
                        )}
                      </>
                    ) : (
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-white/5 text-gray-500 border border-white/5">
                        Opsional
                      </span>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

    </div>

  </div>
</MainLayout>
