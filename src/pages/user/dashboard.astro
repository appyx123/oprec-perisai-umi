---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';
import { createDb } from '../../db';
import { cagens, berkasCagens, systemSettings, peminatan as peminatanTable, documentTypes, cagenDocuments } from '../../db/schema';
import { eq, asc } from 'drizzle-orm';

const user = Astro.locals.user as AuthUser | null | undefined;
if (!user || user.role !== 'user') {
  return Astro.redirect('/auth/login');
}

let cagenData: any = null;
let berkasData: any = null;
let settingData: any = null;
let peminatanDetail: any = null;
let activeDocRequirements: any[] = [];
let docMap = new Map<string, string>();
let userPeminatanId: number | null = null;
let dbError: string | null = null;

const DOC_METADATA: Record<string, { desc: string; typeHint?: string }> = {
  ktm: {
    desc: 'KTM resmi UMI atau Surat Keterangan Aktif Kuliah dari fakultas.',
    typeHint: 'PDF/JPG/PNG (Maks. 2MB)',
  },
  transkrip: {
    desc: 'Transkrip nilai semester terakhir dari portal akademik UMI.',
    typeHint: 'PDF (Maks. 2MB)',
  },
  pas_foto: {
    desc: 'Pas foto formal terbaru dengan latar belakang merah rapi (rasio 4:6 atau 3:4).',
    typeHint: 'JPG/PNG (Latar Merah, Maks. 2MB)',
  },
  cv: {
    desc: 'Daftar riwayat hidup, pengalaman organisasi/kepanitiaan, dan keahlian.',
    typeHint: 'PDF ATS/Kreatif (Maks. 2MB)',
  },
  bukti_follow: {
    desc: 'Screenshot bukti mengikuti Instagram resmi @perisai.umi dan akun TikTok.',
    typeHint: 'JPG/PNG (Maks. 2MB)',
  },
  bukti_subscribe: {
    desc: 'Screenshot bukti berlangganan kanal YouTube resmi UKM PERISAI UMI.',
    typeHint: 'JPG/PNG (Maks. 2MB)',
  },
  bukti_share: {
    desc: 'Screenshot bukti menyebarkan pamflet OPREC ke minimal 3 grup WA atau status medsos.',
    typeHint: 'JPG/PNG (Maks. 5 Foto, 2MB/foto)',
  },
  sertifikat_prestasi: {
    desc: 'Piagam penghargaan kompetisi akademik/non-akademik (Opsional).',
    typeHint: 'PDF (Opsional, Maks. 2MB)',
  },
  sertifikat_bahasa: {
    desc: 'Sertifikat TOEFL, IELTS, atau tes kemampuan bahasa asing lainnya (Opsional).',
    typeHint: 'PDF (Opsional, Maks. 2MB)',
  },
  sertifikat_organisasi: {
    desc: 'Bukti partisipasi kepengurusan organisasi kampus atau kepanitiaan (Opsional).',
    typeHint: 'PDF (Opsional, Maks. 2MB)',
  },
  portfolio_linkedin: {
    desc: 'Cantumkan tautan akun LinkedIn atau portofolio daring (GitHub/Behance/Dribbble/dll) untuk nilai tambah seleksi.',
    typeHint: 'Tautan URL (Opsional)',
  },
};

const LEGACY_COLUMN_FALLBACK: Record<string, string> = {
  ktm: 'ktm',
  transkrip: 'transkripNilai',
  pas_foto: 'pasFoto',
  cv: 'cv',
  bukti_follow: 'buktiFollow',
  bukti_subscribe: 'buktiFollow',
  bukti_share: 'buktiShare',
  sertifikat_prestasi: 'sertifikatPrestasi',
  sertifikat_bahasa: 'sertifikatBahasa',
  sertifikat_organisasi: 'sertifikatOrganisasi',
  file_karya: 'fileKarya',
  karya_kti: 'fileKarya',
  karya_poster: 'fileKarya',
  karya_debat: 'fileKarya',
  karya_videograph: 'fileKarya',
  karya_business_plan: 'fileKarya',
};

try {
  const db = createDb();

  // 1. Ambil data profil & status terkini peserta dari database Turso
  const [cagenRow] = await db
    .select()
    .from(cagens)
    .where(eq(cagens.id, user.id))
    .limit(1);

  cagenData = cagenRow || null;

  // 2. Ambil catatan berkas pendaftaran peserta
  const [berkasRow] = await db
    .select()
    .from(berkasCagens)
    .where(eq(berkasCagens.cagenId, user.id))
    .limit(1);

  berkasData = berkasRow || null;

  // 3. Ambil konfigurasi WhatsApp Call Center
  const [settingRow] = await db
    .select({ waNumber: systemSettings.waNumber, waMessage: systemSettings.waMessage })
    .from(systemSettings)
    .where(eq(systemSettings.id, 1))
    .limit(1);

  settingData = settingRow || null;

  // 4. Ambil referensi semua peminatan aktif
  const allPeminatan = await db
    .select()
    .from(peminatanTable)
    .where(eq(peminatanTable.isActive, true));

  const resolvedPeminatan = cagenData?.peminatan || berkasData?.peminatan || null;
  if (resolvedPeminatan) {
    peminatanDetail =
      allPeminatan.find((p) => p.nama.toLowerCase() === resolvedPeminatan.toLowerCase()) ||
      allPeminatan.find(
        (p) =>
          p.nama.toLowerCase().replace(/[^a-z0-9]/g, '') ===
          resolvedPeminatan.toLowerCase().replace(/[^a-z0-9]/g, '')
      ) ||
      null;
  }
  userPeminatanId = peminatanDetail?.id || null;

  // 5. Query Master Dokumen yang AKTIF (isActive = true)
  activeDocRequirements = await db
    .select({
      id: documentTypes.id,
      slug: documentTypes.slug,
      label: documentTypes.label,
      group: documentTypes.group,
      peminatanId: documentTypes.peminatanId,
      maxFiles: documentTypes.maxFiles,
      inputType: documentTypes.inputType,
      acceptMime: documentTypes.acceptMime,
      maxSizeBytes: documentTypes.maxSizeBytes,
      isActive: documentTypes.isActive,
    })
    .from(documentTypes)
    .where(eq(documentTypes.isActive, true))
    .orderBy(asc(documentTypes.id));

  // 6. Query relasional cagen_documents peserta
  const relDocs = await db
    .select({
      slug: documentTypes.slug,
      s3Key: cagenDocuments.s3Key,
    })
    .from(cagenDocuments)
    .innerJoin(documentTypes, eq(cagenDocuments.documentTypeId, documentTypes.id))
    .where(eq(cagenDocuments.cagenId, user.id));

  docMap = new Map(relDocs.map((d) => [d.slug, d.s3Key]));
} catch (err) {
  console.error('Error fetching applicant dashboard data:', err);
  dbError = 'Gagal memuat sebagian data profil/berkas. Silakan muat ulang halaman.';
}

const statusPendaftaran = cagenData?.statusPendaftaran || 'Belum Melengkapi';
const peminatan = cagenData?.peminatan || berkasData?.peminatan || null;

let cleanWa = (settingData?.waNumber || '081234567890').replace(/\D/g, '');
if (cleanWa.startsWith('0')) cleanWa = '62' + cleanWa.slice(1);
else if (cleanWa.startsWith('8')) cleanWa = '62' + cleanWa;

const waText = settingData?.waMessage || 'Halo Admin Panitia OPREC PERISAI UMI, saya mengalami kendala pada berkas/tahapan seleksi.';
const dashboardWaUrl = `https://wa.me/${cleanWa}?text=${encodeURIComponent(waText)}`;

function resolveFileKey(slug: string): string {
  if (docMap.has(slug)) return docMap.get(slug)!;
  const legacyCol = LEGACY_COLUMN_FALLBACK[slug];
  if (legacyCol && berkasData && berkasData[legacyCol]) {
    return String(berkasData[legacyCol]).trim();
  }
  return '';
}

const formattedDocs = activeDocRequirements.map((d) => {
  const fileKey = resolveFileKey(d.slug);
  const isUploaded = Boolean(fileKey && fileKey.trim().length > 0);
  const isLink = d.inputType === 'link' || fileKey.startsWith('http://') || fileKey.startsWith('https://');
  const meta = DOC_METADATA[d.slug];
  const desc = meta?.desc || (d.inputType === 'link' ? 'Cantumkan tautan URL sesuai ketentuan penugasan.' : `Unggah berkas persyaratan ${d.label}.`);

  return {
    id: d.id,
    slug: d.slug,
    name: d.label,
    description: desc,
    fileName: fileKey || null,
    uploaded: isUploaded,
    isLink,
    group: d.group,
    peminatanId: d.peminatanId,
    inputType: d.inputType || 'file',
  };
});

// Daftar Berkas Wajib (group 'wajib' & peminatan sesuai)
const mandatoryDocs = formattedDocs.filter((d) =>
  d.group === 'wajib' &&
  (d.peminatanId === null || d.peminatanId === userPeminatanId)
);

// Daftar Berkas Karya Peminatan (group 'karya' & peminatan sesuai)
const karyaDocs = formattedDocs.filter((d) =>
  d.group === 'karya' &&
  (d.peminatanId === null || d.peminatanId === userPeminatanId)
);

// Daftar Berkas Pendukung (group 'opsional' & peminatan sesuai)
const optionalDocs = formattedDocs.filter((d) =>
  d.group === 'opsional' &&
  (d.peminatanId === null || d.peminatanId === userPeminatanId)
);

const totalMandatory = mandatoryDocs.length;
const uploadedMandatoryCount = mandatoryDocs.filter((d) => d.uploaded).length;
const isAllMandatoryUploaded = totalMandatory > 0 ? uploadedMandatoryCount === totalMandatory : true;
const progressPercentage = totalMandatory > 0 ? Math.round((uploadedMandatoryCount / totalMandatory) * 100) : 100;

// Logika Stepper Tahapan Seleksi
let activeStep = 1; // 1: Pendaftaran, 2: Seleksi Berkas, 3: Pengumuman
if (statusPendaftaran === 'Belum Melengkapi') {
  activeStep = isAllMandatoryUploaded ? 2 : 1;
} else if (statusPendaftaran === 'Review Berkas') {
  activeStep = 2;
} else if (statusPendaftaran === 'Berkas Diterima') {
  activeStep = 2;
} else if (statusPendaftaran === 'Lulus' || statusPendaftaran === 'Tidak Lulus') {
  activeStep = 3;
}
---

<MainLayout title="Dashboard Calon Anggota - PERISAI UMI">
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Welcome Header Card (Cleaned up: No redundant logout button) -->
    <div class="bg-gradient-to-r from-[#171720] via-[#1a1a24] to-[#121217] border border-amber-400/20 rounded-3xl p-8 sm:p-10 shadow-xl relative overflow-hidden mb-8">
      <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-amber-500/10 rounded-full blur-[90px] pointer-events-none"></div>

      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold mb-3">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Portal Calon Anggota Baru
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
            Selamat Datang, <span class="text-amber-400">{cagenData?.namaLengkap || user.name}</span>!
          </h1>
          <p class="text-sm sm:text-base text-gray-400 mt-2 max-w-2xl">
            Pantau status verifikasi berkas dan tahapan seleksi Anda secara real-time melalui dashboard ini.
          </p>
        </div>

        <div class="flex flex-col items-start sm:items-end text-left sm:text-right">
          <span class="text-[11px] text-gray-500 font-mono uppercase tracking-wider">Nomor Registrasi</span>
          <span class="text-lg font-black text-amber-400 font-mono tracking-wider">#{cagenData?.nomorRegistrasi || user.nomorRegistrasi || '-'}</span>
        </div>
      </div>
    </div>

    {dbError && (
      <div class="mb-8 p-4 rounded-2xl bg-rose-950/50 border border-rose-800/50 text-rose-300 text-sm flex items-center gap-3">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{dbError}</span>
      </div>
    )}

    <!-- Prominent Guidebook & Peminatan Card -->
    {peminatan ? (
      <div class="bg-gradient-to-r from-[#171722] via-[#1a1a26] to-[#121217] border border-amber-400/30 rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden mb-8">
        <div class="absolute -right-12 -top-12 w-56 h-56 bg-amber-500/10 rounded-full blur-[80px] pointer-events-none"></div>

        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 relative z-10">
          <div class="space-y-2 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              Bidang Peminatan Pilihan Anda
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-3">
              <span>{peminatan}</span>
            </h2>
            <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
              {peminatanDetail?.deskripsi || 'Persiapkan berkas dan karya inovatif Anda sesuai dengan ketentuan resmi yang tertuang di dalam Guidebook peminatan Anda.'}
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full lg:w-auto flex-shrink-0">
            {peminatanDetail?.guidebookUrl ? (
              <a
                href={`/api/guidebook?id=${peminatanDetail.id}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-sm shadow-lg shadow-amber-500/20 hover:shadow-amber-500/35 transition-all duration-200 group/btn"
              >
                <svg class="w-5 h-5 text-black flex-shrink-0 group-hover/btn:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <span>Unduh Guidebook Peminatan Anda</span>
              </a>
            ) : (
              <button
                type="button"
                disabled
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white/5 border border-white/10 text-gray-500 text-sm font-semibold cursor-not-allowed"
              >
                <svg class="w-5 h-5 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Guidebook Segera Hadir</span>
              </button>
            )}

            <a
              href="/dashboard/settings"
              class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-300 hover:text-white text-sm font-semibold transition-colors"
            >
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Ubah Peminatan
            </a>
          </div>
        </div>
      </div>
    ) : (
      <div class="bg-[#14141b] border border-amber-400/20 rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden mb-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs font-semibold mb-2">
              Perhatian Pendaftaran
            </div>
            <h2 class="text-xl font-bold text-white">Anda Belum Memilih Bidang Peminatan</h2>
            <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-xl">
              Pilihlah bidang peminatan Anda agar Anda dapat mengunduh guidebook resmi dan mengunggah berkas karya yang sesuai.
            </p>
          </div>
          <a
            href="/dashboard/settings"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-xs sm:text-sm transition-all shadow-md shadow-amber-500/20 flex-shrink-0"
          >
            Pilih Peminatan Sekarang
          </a>
        </div>
      </div>
    )}

    <!-- Selection Stage Stepper Card -->
    <div class="bg-[#121217] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-6 border-b border-white/10 mb-8">
        <div>
          <h2 class="text-lg font-bold text-white tracking-tight">Alur Tahapan Seleksi</h2>
          <p class="text-xs text-gray-400 mt-0.5">Proses seleksi berlangsung secara bertahap dan transparan.</p>
        </div>
        <div>
          <span class="text-xs font-semibold text-gray-400 mr-2">Status Saat Ini:</span>
          <span class={`inline-block px-3 py-1 rounded-full text-xs font-bold border ${
            statusPendaftaran === 'Lulus'
              ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30'
              : statusPendaftaran === 'Tidak Lulus'
              ? 'bg-rose-500/15 text-rose-300 border-rose-500/30'
              : statusPendaftaran === 'Berkas Diterima'
              ? 'bg-blue-500/15 text-blue-300 border-blue-500/30'
              : statusPendaftaran === 'Review Berkas'
              ? 'bg-amber-500/15 text-amber-300 border-amber-500/30'
              : 'bg-gray-800 text-gray-300 border-gray-700'
          }`}>
            {statusPendaftaran}
          </span>
        </div>
      </div>

      <!-- Stepper Component -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
        
        <!-- Step 1: Pendaftaran -->
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center font-bold flex-shrink-0 shadow-lg shadow-emerald-500/10">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold text-emerald-400">TAHAP 1</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-semibold">Selesai</span>
            </div>
            <h3 class="text-sm font-bold text-white mt-1">Pendaftaran Akun</h3>
            <p class="text-xs text-gray-400 mt-1 leading-relaxed">
              Akun calon anggota berhasil didaftarkan di sistem.
            </p>
          </div>
        </div>

        <!-- Step 2: Seleksi Berkas -->
        <div class="flex items-start gap-4">
          <div class={`w-10 h-10 rounded-2xl flex items-center justify-center font-bold flex-shrink-0 shadow-lg ${
            activeStep > 2 || statusPendaftaran === 'Berkas Diterima' || statusPendaftaran === 'Lulus'
              ? 'bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 shadow-emerald-500/10'
              : activeStep === 2
              ? 'bg-amber-400/20 border border-amber-400/50 text-amber-400 shadow-amber-500/20 animate-pulse'
              : 'bg-white/5 border border-white/10 text-gray-500'
          }`}>
            {activeStep > 2 || statusPendaftaran === 'Berkas Diterima' || statusPendaftaran === 'Lulus' ? (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
            ) : (
              <span class="text-sm">2</span>
            )}
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class={`text-xs font-mono font-bold ${activeStep === 2 ? 'text-amber-400' : activeStep > 2 ? 'text-emerald-400' : 'text-gray-500'}`}>
                TAHAP 2
              </span>
              <span class={`text-[10px] px-2 py-0.5 rounded font-semibold ${
                statusPendaftaran === 'Berkas Diterima' || statusPendaftaran === 'Lulus'
                  ? 'bg-emerald-500/10 text-emerald-400'
                  : activeStep === 2
                  ? 'bg-amber-400/10 text-amber-300'
                  : 'bg-white/5 text-gray-500'
              }`}>
                {statusPendaftaran === 'Berkas Diterima' || statusPendaftaran === 'Lulus'
                  ? 'Lolos Berkas'
                  : statusPendaftaran === 'Review Berkas'
                  ? 'Sedang Ditinjau'
                  : 'Proses Dokumen'}
              </span>
            </div>
            <h3 class="text-sm font-bold text-white mt-1">Seleksi & Verifikasi Berkas</h3>
            <p class="text-xs text-gray-400 mt-1 leading-relaxed">
              {statusPendaftaran === 'Review Berkas'
                ? 'Berkas Anda sedang dalam proses verifikasi oleh panitia seleksi.'
                : statusPendaftaran === 'Berkas Diterima'
                ? 'Berkas administrasi telah diverifikasi dan dinyatakan lengkap.'
                : 'Lengkapi seluruh dokumen persyaratan wajib di bawah.'}
            </p>
          </div>
        </div>

        <!-- Step 3: Pengumuman Kelulusan -->
        <div class="flex items-start gap-4">
          <div class={`w-10 h-10 rounded-2xl flex items-center justify-center font-bold flex-shrink-0 shadow-lg ${
            statusPendaftaran === 'Lulus'
              ? 'bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 shadow-emerald-500/20'
              : statusPendaftaran === 'Tidak Lulus'
              ? 'bg-rose-500/20 border border-rose-500/40 text-rose-400 shadow-rose-500/20'
              : 'bg-white/5 border border-white/10 text-gray-500'
          }`}>
            {statusPendaftaran === 'Lulus' ? (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
            ) : statusPendaftaran === 'Tidak Lulus' ? (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            ) : (
              <span class="text-sm">3</span>
            )}
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class={`text-xs font-mono font-bold ${activeStep === 3 ? 'text-amber-400' : 'text-gray-500'}`}>
                TAHAP 3
              </span>
              <span class={`text-[10px] px-2 py-0.5 rounded font-semibold ${
                statusPendaftaran === 'Lulus'
