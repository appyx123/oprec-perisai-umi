---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';
import { createDb } from '../../db';
import { berkasCagens, cagens } from '../../db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user as AuthUser | null | undefined;
if (!user || user.role !== 'user') {
  return Astro.redirect('/auth/login');
}

let berkasData: any = null;
let cagenData: any = null;

try {
  const db = createDb();
  const [cagenRow] = await db
    .select()
    .from(cagens)
    .where(eq(cagens.id, user.id))
    .limit(1);
  cagenData = cagenRow || null;

  const [berkasRow] = await db
    .select()
    .from(berkasCagens)
    .where(eq(berkasCagens.cagenId, user.id))
    .limit(1);
  berkasData = berkasRow || null;
} catch (err) {
  console.error('Error fetching berkas in form-daftar:', err);
}

const userNim = cagenData?.nim || user.nim || String(user.id);

// 7 Berkas Wajib
const mandatoryDocs = [
  {
    id: 'ktm',
    label: 'Kartu Tanda Mahasiswa (KTM)',
    desc: 'KTM resmi atau surat keterangan aktif kuliah dari fakultas.',
    accept: '.pdf,.jpg,.jpeg,.png',
    formatHint: 'PDF, JPG, PNG (Maks 10MB)',
    fileKey: berkasData?.ktm || '',
    isUploaded: Boolean(berkasData?.ktm && berkasData.ktm.trim().length > 0),
  },
  {
    id: 'pasFoto',
    label: 'Pas Foto Formal',
    desc: 'Pas foto formal terbaru dengan latar belakang polos dan rapi.',
    accept: '.jpg,.jpeg,.png',
    formatHint: 'JPG, PNG (Maks 5MB)',
    fileKey: berkasData?.pasFoto || '',
    isUploaded: Boolean(berkasData?.pasFoto && berkasData.pasFoto.trim().length > 0),
  },
  {
    id: 'cv',
    label: 'Curriculum Vitae (CV)',
    desc: 'Daftar riwayat hidup, pengalaman organisasi, dan keahlian.',
    accept: '.pdf',
    formatHint: 'PDF (Maks 10MB)',
    fileKey: berkasData?.cv || '',
    isUploaded: Boolean(berkasData?.cv && berkasData.cv.trim().length > 0),
  },
  {
    id: 'transkripNilai',
    label: 'Transkrip Nilai',
    desc: 'Transkrip nilai semester terakhir dari portal akademik UMI.',
    accept: '.pdf',
    formatHint: 'PDF (Maks 10MB)',
    fileKey: berkasData?.transkripNilai || '',
    isUploaded: Boolean(berkasData?.transkripNilai && berkasData.transkripNilai.trim().length > 0),
  },
  {
    id: 'buktiFollow',
    label: 'Bukti Follow Media Sosial',
    desc: 'Tangkapan layar bukti mengikuti Instagram resmi @perisai.umi.',
    accept: '.jpg,.jpeg,.png',
    formatHint: 'JPG, PNG (Maks 5MB)',
    fileKey: berkasData?.buktiFollow || '',
    isUploaded: Boolean(berkasData?.buktiFollow && berkasData.buktiFollow.trim().length > 0),
  },
  {
    id: 'buktiShare',
    label: 'Bukti Share Pamflet OREC',
    desc: 'Tangkapan layar bukti membagikan pamflet OREC ke grup atau status medsos.',
    accept: '.jpg,.jpeg,.png',
    formatHint: 'JPG, PNG (Maks 5MB)',
    fileKey: berkasData?.buktiShare || '',
    isUploaded: Boolean(berkasData?.buktiShare && berkasData.buktiShare.trim().length > 0),
  },
  {
    id: 'fileKarya',
    label: 'File Karya Peminatan',
    desc: 'Karya inovatif sesuai dengan bidang peminatan yang dipilih.',
    accept: '.pdf,.zip,.rar,.mp4,.ppt,.pptx,.docx',
    formatHint: 'PDF, ZIP, RAR, MP4, PPTX (Maks 50MB)',
    fileKey: berkasData?.fileKarya || '',
    isUploaded: Boolean(berkasData?.fileKarya && berkasData.fileKarya.trim().length > 0),
  },
];

// 3 Berkas Pendukung (Opsional)
const optionalDocs = [
  {
    id: 'sertifikatPrestasi',
    label: 'Sertifikat Prestasi',
    desc: 'Piagam kejuaraan atau kompetisi akademik/non-akademik.',
    accept: '.pdf',
    formatHint: 'PDF (Maks 10MB)',
    fileKey: berkasData?.sertifikatPrestasi || '',
    isUploaded: Boolean(berkasData?.sertifikatPrestasi && berkasData.sertifikatPrestasi.trim().length > 0),
  },
  {
    id: 'sertifikatBahasa',
    label: 'Sertifikat Kemampuan Bahasa',
    desc: 'Sertifikat TOEFL, IELTS, atau tes kemampuan bahasa asing lainnya.',
    accept: '.pdf',
    formatHint: 'PDF (Maks 10MB)',
    fileKey: berkasData?.sertifikatBahasa || '',
    isUploaded: Boolean(berkasData?.sertifikatBahasa && berkasData.sertifikatBahasa.trim().length > 0),
  },
  {
    id: 'sertifikatOrganisasi',
    label: 'Sertifikat Organisasi / Kepanitiaan',
    desc: 'Bukti keikutsertaan kepengurusan organisasi atau kepanitiaan.',
    accept: '.pdf',
    formatHint: 'PDF (Maks 10MB)',
    fileKey: berkasData?.sertifikatOrganisasi || '',
    isUploaded: Boolean(berkasData?.sertifikatOrganisasi && berkasData.sertifikatOrganisasi.trim().length > 0),
  },
];

const totalMandatory = mandatoryDocs.length;
const uploadedMandatoryCount = mandatoryDocs.filter((d) => d.isUploaded).length;
const initialProgressPercent = Math.round((uploadedMandatoryCount / totalMandatory) * 100);
---

<MainLayout title="Unggah Berkas Pendaftaran - PERISAI UMI">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10" data-user-nim={userNim}>
    
    <!-- Top Bar: Navigation & Progress Summary -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold mb-2">
          Tahapan Seleksi Berkas
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          Unggah Berkas Pendaftaran
        </h1>
        <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-2xl">
          Setiap dokumen dapat diunggah secara fleksibel dan mandiri tanpa urutan tertentu. Dokumen yang berhasil diunggah langsung tersimpan otomatis.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/user/dashboard"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white border border-white/10 text-xs font-semibold transition-all"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Kembali ke Dashboard
        </a>
      </div>
    </div>

    <!-- Progress Card -->
    <div class="bg-[#121217] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl mb-8 relative overflow-hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-gray-400">Progres Berkas Wajib</span>
          <div class="flex items-center gap-2 mt-1">
            <h3 class="text-xl sm:text-2xl font-black text-white font-mono">
              <span id="stat-uploaded-count">{uploadedMandatoryCount}</span> / {totalMandatory}
            </h3>
            <span class="text-xs text-gray-400">Dokumen Wajib Terkumpul</span>
          </div>
        </div>

        <div class="text-right">
          <span id="stat-percent-text" class="text-lg sm:text-xl font-black text-amber-400 font-mono">
            {initialProgressPercent}%
          </span>
          <span class="block text-[11px] text-gray-500">
            {uploadedMandatoryCount === totalMandatory ? 'Lengkap & Siap Dinilai' : 'Lengkapi sebelum batas waktu'}
          </span>
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="w-full bg-white/5 rounded-full h-2.5 overflow-hidden border border-white/5">
        <div
          id="stat-progress-bar"
          class="h-full bg-gradient-to-r from-amber-500 to-amber-300 rounded-full transition-all duration-500"
          style={`width: ${initialProgressPercent}%`}
        ></div>
      </div>
    </div>

    <!-- Global Floating Toast Notification -->
    <div
      id="upload-toast"
      class="hidden fixed bottom-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all duration-300 transform translate-y-4 text-xs flex items-center gap-3"
    >
      <div id="toast-icon" class="flex-shrink-0"></div>
      <div class="flex-1">
        <strong id="toast-title" class="block font-bold mb-0.5"></strong>
        <span id="toast-msg" class="text-gray-300"></span>
      </div>
    </div>

    <!-- SECTION 1: Berkas Wajib Persyaratan -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6 pb-3 border-b border-white/10">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        <h2 class="text-base sm:text-lg font-bold text-white tracking-tight">
          1. Dokumen Wajib Persyaratan (7 Berkas)
        </h2>
        <span class="text-xs text-amber-400 font-mono bg-amber-400/10 px-2.5 py-0.5 rounded-full border border-amber-400/20">
          Wajib Dilengkapi
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {mandatoryDocs.map((doc) => (
          <div
            id={`card-${doc.id}`}
            class={`doc-card bg-[#13131b] border rounded-3xl p-6 transition-all duration-200 relative flex flex-col justify-between ${
              doc.isUploaded
                ? 'border-emerald-500/30 hover:border-emerald-500/50 shadow-emerald-500/5'
                : 'border-white/10 hover:border-white/20'
            }`}
            data-category={doc.id}
            data-label={doc.label}
          >
            <!-- Card Header -->
            <div>
              <div class="flex items-start justify-between gap-3 mb-2">
                <h3 class="font-bold text-sm sm:text-base text-white leading-snug">
                  {doc.label}
                </h3>

                <!-- Status Badge -->
                <div id={`badge-${doc.id}`} class="flex-shrink-0">
                  {doc.isUploaded ? (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      Selesai ✅
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-white/5 text-gray-400 border border-white/5">
                      Belum Diunggah
                    </span>
                  )}
                </div>
              </div>

              <p class="text-xs text-gray-400 leading-relaxed mb-4">
                {doc.desc}
              </p>

              <!-- Uploaded File Details (if exists) -->
              <div id={`preview-${doc.id}`} class={`mb-4 p-3 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between gap-2 ${doc.isUploaded ? '' : 'hidden'}`}>
                <div class="flex items-center gap-2 overflow-hidden">
                  <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span id={`filename-text-${doc.id}`} class="text-xs font-mono text-gray-300 truncate" title={doc.fileKey}>
                    {doc.fileKey || 'Berkas tersimpan'}
                  </span>
                </div>

                <a
                  id={`view-btn-${doc.id}`}
                  href={doc.fileKey ? `/api/file/view?name=${encodeURIComponent(doc.fileKey)}` : '#'}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/15 text-amber-300 hover:text-white text-[11px] font-semibold flex-shrink-0 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  Lihat
                </a>
              </div>

              <!-- Error Alert on Card -->
              <div id={`error-box-${doc.id}`} class="hidden mb-4 p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs"></div>
            </div>

            <!-- Upload Dropzone / Button Trigger -->
            <div class="pt-2 border-t border-white/5">
              <input
                type="file"
                id={`input-${doc.id}`}
                class="doc-file-input hidden"
                data-category={doc.id}
                data-label={doc.label}
                accept={doc.accept}
              />

              <div class="flex items-center justify-between gap-3">
                <span class="text-[11px] text-gray-500 font-mono">
                  {doc.formatHint}
                </span>

                <button
                  type="button"
                  id={`btn-trigger-${doc.id}`}
                  class="upload-trigger-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer bg-amber-400 hover:bg-amber-300 text-black shadow-md shadow-amber-500/20"
                  data-target-input={`input-${doc.id}`}
                >
                  <span id={`btn-text-${doc.id}`}>{doc.isUploaded ? 'Ganti Berkas' : 'Unggah Berkas'}</span>
                  <svg id={`btn-spin-${doc.id}`} class="hidden w-3.5 h-3.5 animate-spin text-black" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </button>
              </div>
            </div>

          </div>
        ))}
      </div>
    </div>

    <!-- SECTION 2: Berkas Pendukung / Opsional -->
    <div>
      <div class="flex items-center gap-3 mb-6 pb-3 border-b border-white/10">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
        <h2 class="text-base sm:text-lg font-bold text-white tracking-tight">
          2. Dokumen Pendukung (Opsional)
        </h2>
        <span class="text-xs text-blue-400 font-mono bg-blue-400/10 px-2.5 py-0.5 rounded-full border border-blue-400/20">
          Nilai Tambah
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {optionalDocs.map((doc) => (
          <div
            id={`card-${doc.id}`}
            class={`doc-card bg-[#13131b] border rounded-3xl p-6 transition-all duration-200 relative flex flex-col justify-between ${
              doc.isUploaded
                ? 'border-emerald-500/30 hover:border-emerald-500/50 shadow-emerald-500/5'
                : 'border-white/10 hover:border-white/20'
            }`}
            data-category={doc.id}
            data-label={doc.label}
          >
            <div>
              <div class="flex items-start justify-between gap-3 mb-2">
                <h3 class="font-bold text-sm text-white leading-snug">
                  {doc.label}
                </h3>

                <div id={`badge-${doc.id}`} class="flex-shrink-0">
                  {doc.isUploaded ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                      Selesai ✅
                    </span>
                  ) : (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-white/5 text-gray-500 border border-white/5">
                      Opsional
                    </span>
                  )}
                </div>
              </div>

              <p class="text-xs text-gray-400 leading-relaxed mb-4">
                {doc.desc}
              </p>

              <!-- Uploaded Preview -->
              <div id={`preview-${doc.id}`} class={`mb-4 p-2.5 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between gap-2 ${doc.isUploaded ? '' : 'hidden'}`}>
                <span id={`filename-text-${doc.id}`} class="text-xs font-mono text-gray-300 truncate" title={doc.fileKey}>
                  {doc.fileKey || 'Berkas tersimpan'}
                </span>
                <a
                  id={`view-btn-${doc.id}`}
                  href={doc.fileKey ? `/api/file/view?name=${encodeURIComponent(doc.fileKey)}` : '#'}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-2 py-0.5 rounded bg-white/10 text-amber-300 text-[10px] font-semibold hover:text-white"
                >
                  Lihat
                </a>
              </div>

              <div id={`error-box-${doc.id}`} class="hidden mb-4 p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs"></div>
            </div>

            <!-- Upload Trigger -->
            <div class="pt-2 border-t border-white/5">
              <input
                type="file"
                id={`input-${doc.id}`}
                class="doc-file-input hidden"
                data-category={doc.id}
                data-label={doc.label}
                accept={doc.accept}
              />

              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] text-gray-500 font-mono">
                  {doc.formatHint}
                </span>

                <button
                  type="button"
                  id={`btn-trigger-${doc.id}`}
                  class="upload-trigger-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer bg-white/10 hover:bg-white/15 text-gray-200 border border-white/10"
                  data-target-input={`input-${doc.id}`}
                >
                  <span id={`btn-text-${doc.id}`}>{doc.isUploaded ? 'Ganti' : 'Unggah'}</span>
                  <svg id={`btn-spin-${doc.id}`} class="hidden w-3 h-3 animate-spin text-white" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </button>
              </div>
            </div>

          </div>
        ))}
      </div>
    </div>

  </div>

  <!-- Client-side Asynchronous & Independent Upload Script -->
  <script>
    function initIndependentUploader() {
      const container = document.querySelector('[data-user-nim]') as HTMLElement | null;
      const userNim = container?.getAttribute('data-user-nim') || '';

      const toast = document.getElementById('upload-toast');
      const toastTitle = document.getElementById('toast-title');
      const toastMsg = document.getElementById('toast-msg');
      const toastIcon = document.getElementById('toast-icon');

      function showToast(type: 'success' | 'error', title: string, message: string) {
        if (!toast || !toastTitle || !toastMsg || !toastIcon) return;
        toastTitle.textContent = title;
        toastMsg.textContent = message;

        if (type === 'success') {
          toast.className = 'fixed bottom-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all duration-300 text-xs flex items-center gap-3 bg-[#131d16] border-emerald-500/40 text-emerald-300';
          toastIcon.innerHTML = `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>`;
        } else {
          toast.className = 'fixed bottom-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all duration-300 text-xs flex items-center gap-3 bg-[#201316] border-rose-500/40 text-rose-300';
          toastIcon.innerHTML = `<svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
        }

        toast.classList.remove('hidden');
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 5000);
      }

      // Bind all Trigger Buttons to their respective file inputs
      const triggerButtons = document.querySelectorAll<HTMLButtonElement>('.upload-trigger-btn');
      triggerButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetInputId = btn.getAttribute('data-target-input');
          if (!targetInputId) return;
          const input = document.getElementById(targetInputId) as HTMLInputElement | null;
          if (input) {
            input.click();
          }
        });
      });

      // Bind File Change on each isolated input
      const fileInputs = document.querySelectorAll<HTMLInputElement>('.doc-file-input');
      fileInputs.forEach((input) => {
        input.addEventListener('change', async () => {
          if (!input.files || input.files.length === 0) return;
          const file = input.files[0];
          const category = input.getAttribute('data-category') || '';
          const label = input.getAttribute('data-label') || 'Dokumen';

          await handleSingleUpload(category, label, file, input);
        });
      });

      async function handleSingleUpload(category: string, label: string, file: File, inputEl: HTMLInputElement) {
        const card = document.getElementById(`card-${category}`);
        const badge = document.getElementById(`badge-${category}`);
        const btnText = document.getElementById(`btn-text-${category}`);
        const btnSpin = document.getElementById(`btn-spin-${category}`);
        const btnTrigger = document.getElementById(`btn-trigger-${category}`) as HTMLButtonElement | null;
        const errorBox = document.getElementById(`error-box-${category}`);
        const preview = document.getElementById(`preview-${category}`);
        const filenameText = document.getElementById(`filename-text-${category}`);
        const viewBtn = document.getElementById(`view-btn-${category}`) as HTMLAnchorElement | null;

        // Reset error
        if (errorBox) {
          errorBox.classList.add('hidden');
          errorBox.textContent = '';
        }

        // Set Loading State for THIS card only
        if (btnTrigger) btnTrigger.disabled = true;
        if (btnSpin) btnSpin.classList.remove('hidden');
        if (btnText) btnText.textContent = 'Mengunggah...';
        if (badge) {
          badge.innerHTML = `
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-400/15 text-amber-300 border border-amber-400/30 animate-pulse">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              Mengunggah...
            </span>
          `;
        }

        try {
          // STEP 1: Request presigned PUT URL
          const presignRes = await fetch('/api/upload/presign', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify({
              nim: userNim,
              jenisBerkas: label,
              fileName: file.name,
              contentType: file.type || 'application/octet-stream',
              category: category,
            }),
          });

          const presignData = (await presignRes.json()) as any;
          if (!presignRes.ok || !presignData.success) {
            throw new Error(presignData.message || 'Gagal menyiapkan izin unggah berkas.');
          }

          const uploadUrl = presignData.presignedUrl || presignData.uploadUrl;
          const fileKey = presignData.fileKey || presignData.finalFileName;

          // STEP 2: Upload file directly to S3/B2 via presigned URL
          if (btnText) btnText.textContent = 'Menyimpan S3...';
          const s3Res = await fetch(uploadUrl, {
            method: 'PUT',
            headers: {
              'Content-Type': file.type || 'application/octet-stream',
            },
            body: file,
          });

          if (!s3Res.ok) {
            throw new Error('Gagal mengunggah berkas ke server penyimpanan.');
          }

          // STEP 3: Confirm and save to Turso database via PATCH /api/upload/confirm
          if (btnText) btnText.textContent = 'Mencatat Data...';
          const confirmRes = await fetch('/api/upload/confirm', {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify({
              fileKey: fileKey,
              finalFileName: fileKey,
              category: category,
            }),
          });

          const confirmData = (await confirmRes.json()) as any;
          if (!confirmRes.ok || !confirmData.success) {
            throw new Error(confirmData.message || 'Berkas terunggah namun gagal dicatat di database.');
          }

          // STEP 4: Success State Update
          if (badge) {
            badge.innerHTML = `
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Selesai ✅
              </span>
            `;
          }

          if (card) {
            card.classList.remove('border-white/10');
            card.classList.add('border-emerald-500/30');
          }

          if (preview) preview.classList.remove('hidden');
          if (filenameText) filenameText.textContent = fileKey;
          if (viewBtn) {
            viewBtn.href = `/api/file/view?name=${encodeURIComponent(fileKey)}`;
          }

          if (btnText) btnText.textContent = 'Ganti Berkas';

          // Update Progress Stats
          if (confirmData.data && typeof confirmData.data.completedMandatoryCount === 'number') {
            const count = confirmData.data.completedMandatoryCount;
            const countEl = document.getElementById('stat-uploaded-count');
            const percentEl = document.getElementById('stat-percent-text');
            const barEl = document.getElementById('stat-progress-bar');

            if (countEl) countEl.textContent = String(count);
            const pct = Math.round((count / 7) * 100);
            if (percentEl) percentEl.textContent = `${pct}%`;
            if (barEl) barEl.style.width = `${pct}%`;
          }

          showToast('success', `${label} Berhasil Disimpan!`, 'Dokumen Anda telah tersimpan aman.');
        } catch (err: any) {
          console.error(`Error uploading ${category}:`, err);
          if (errorBox) {
            errorBox.textContent = err.message || 'Terjadi kesalahan saat mengunggah.';
            errorBox.classList.remove('hidden');
          }
          if (badge) {
            badge.innerHTML = `
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-500/15 text-rose-300 border border-rose-500/30">
                Gagal Unggah
              </span>
            `;
          }
          if (btnText) btnText.textContent = 'Coba Lagi';
          showToast('error', `Gagal Mengunggah ${label}`, err.message || 'Silakan periksa koneksi dan coba lagi.');
        } finally {
          if (btnTrigger) btnTrigger.disabled = false;
          if (btnSpin) btnSpin.classList.add('hidden');
          inputEl.value = ''; // Reset input to allow selecting same file again if desired
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initIndependentUploader);
    } else {
      initIndependentUploader();
    }
  </script>
</MainLayout>
