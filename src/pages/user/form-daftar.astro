---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';
import { createDb } from '../../db';
import { berkasCagens, cagens, systemSettings } from '../../db/schema';
import { eq } from 'drizzle-orm';
import 'cropperjs/dist/cropper.css';

const user = Astro.locals.user as AuthUser | null | undefined;
if (!user || user.role !== 'user') {
  return Astro.redirect('/auth/login');
}

let berkasData: any = null;
let cagenData: any = null;
let settingData: any = null;

try {
  const db = createDb();
  const [cagenRow] = await db
    .select()
    .from(cagens)
    .where(eq(cagens.id, user.id))
    .limit(1);
  cagenData = cagenRow || null;

  const [berkasRow] = await db
    .select()
    .from(berkasCagens)
    .where(eq(berkasCagens.cagenId, user.id))
    .limit(1);
  berkasData = berkasRow || null;

  const [settingRow] = await db
    .select({ waNumber: systemSettings.waNumber, waMessage: systemSettings.waMessage })
    .from(systemSettings)
    .where(eq(systemSettings.id, 1))
    .limit(1);
  settingData = settingRow || null;
} catch (err) {
  console.error('Error fetching berkas in form-daftar:', err);
}

const userNim = cagenData?.nim || user.nim || String(user.id);

let cleanWa = (settingData?.waNumber || '081234567890').replace(/\D/g, '');
if (cleanWa.startsWith('0')) cleanWa = '62' + cleanWa.slice(1);
else if (cleanWa.startsWith('8')) cleanWa = '62' + cleanWa;

const waText = settingData?.waMessage || 'Halo Admin Panitia OPREC PERISAI UMI, saya butuh bantuan terkait pengunggahan berkas pendaftaran.';
const formWaUrl = `https://wa.me/${cleanWa}?text=${encodeURIComponent(waText)}`;

// 7 Berkas Wajib dengan aturan validasi ketat
const mandatoryDocs = [
  {
    id: 'ktm',
    label: 'Kartu Tanda Mahasiswa (KTM)',
    desc: 'KTM resmi atau surat keterangan aktif kuliah dari fakultas.',
    accept: '.pdf,application/pdf',
    typeHint: 'PDF (Maks 2MB)',
    maxSizeMB: 2,
    isMultiple: false,
    maxFiles: 1,
    fileKey: berkasData?.ktm || '',
    isUploaded: Boolean(berkasData?.ktm && berkasData.ktm.trim().length > 0),
  },
  {
    id: 'pasFoto',
    label: 'Pas Foto Formal',
    desc: 'Pas foto formal terbaru dengan rasio 4:6 latar belakang polos.',
    accept: '.jpg,.jpeg,.png,image/jpeg,image/png',
    typeHint: 'JPG, PNG (Maks 2MB, Crop 4:6)',
    maxSizeMB: 2,
    isMultiple: false,
    maxFiles: 1,
    fileKey: berkasData?.pasFoto || '',
    isUploaded: Boolean(berkasData?.pasFoto && berkasData.pasFoto.trim().length > 0),
  },
  {
    id: 'cv',
    label: 'Curriculum Vitae (CV)',
    desc: 'Daftar riwayat hidup, pengalaman organisasi, dan keahlian.',
    accept: '.pdf,application/pdf',
    typeHint: 'PDF (Maks 2MB)',
    maxSizeMB: 2,
    isMultiple: false,
    maxFiles: 1,
    fileKey: berkasData?.cv || '',
    isUploaded: Boolean(berkasData?.cv && berkasData.cv.trim().length > 0),
  },
  {
    id: 'transkripNilai',
    label: 'Transkrip Nilai',
    desc: 'Transkrip nilai semester terakhir dari portal akademik UMI.',
    accept: '.pdf,application/pdf',
    typeHint: 'PDF (Maks 2MB)',
    maxSizeMB: 2,
    isMultiple: false,
    maxFiles: 1,
    fileKey: berkasData?.transkripNilai || '',
    isUploaded: Boolean(berkasData?.transkripNilai && berkasData.transkripNilai.trim().length > 0),
  },
  {
    id: 'buktiFollow',
    label: 'Bukti Follow Media Sosial',
    desc: 'Tangkapan layar bukti mengikuti Instagram resmi @perisai.umi.',
    accept: '.jpg,.jpeg,.png,image/jpeg,image/png',
    typeHint: 'JPG, PNG (Maks 5 Foto, 1MB/foto)',
    maxSizeMB: 1,
    isMultiple: true,
    maxFiles: 5,
    fileKey: berkasData?.buktiFollow || '',
    isUploaded: Boolean(berkasData?.buktiFollow && berkasData.buktiFollow.trim().length > 0),
  },
  {
    id: 'buktiShare',
    label: 'Bukti Share Pamflet OPREC',
    desc: 'Tangkapan layar bukti membagikan pamflet OPREC ke grup atau status medsos.',
    accept: '.jpg,.jpeg,.png,image/jpeg,image/png',
    typeHint: 'JPG, PNG (Maks 5 Foto, 1MB/foto)',
    maxSizeMB: 1,
    isMultiple: true,
    maxFiles: 5,
    fileKey: berkasData?.buktiShare || '',
    isUploaded: Boolean(berkasData?.buktiShare && berkasData.buktiShare.trim().length > 0),
  },
  {
    id: 'fileKarya',
    label: 'File Karya Peminatan',
    desc: 'Karya inovatif sesuai peminatan yang diarsipkan dalam format ZIP.',
    accept: '.zip,application/zip,application/x-zip-compressed',
    typeHint: 'ZIP (Maks 50MB)',
    maxSizeMB: 50,
    isMultiple: false,
    maxFiles: 1,
    fileKey: berkasData?.fileKarya || '',
    isUploaded: Boolean(berkasData?.fileKarya && berkasData.fileKarya.trim().length > 0),
  },
];

// 3 Berkas Pendukung (Opsional)
const optionalDocs = [
  {
    id: 'sertifikatPrestasi',
    label: 'Sertifikat Prestasi',
    desc: 'Piagam kejuaraan atau kompetisi akademik/non-akademik.',
    accept: '.pdf,application/pdf',
    typeHint: 'PDF (Maks 2MB)',
    maxSizeMB: 2,
    isMultiple: false,
    maxFiles: 1,
    fileKey: berkasData?.sertifikatPrestasi || '',
    isUploaded: Boolean(berkasData?.sertifikatPrestasi && berkasData.sertifikatPrestasi.trim().length > 0),
  },
  {
    id: 'sertifikatBahasa',
    label: 'Sertifikat Kemampuan Bahasa',
    desc: 'Sertifikat TOEFL, IELTS, atau tes kemampuan bahasa asing lainnya.',
    accept: '.pdf,application/pdf',
    typeHint: 'PDF (Maks 2MB)',
    maxSizeMB: 2,
    isMultiple: false,
    maxFiles: 1,
    fileKey: berkasData?.sertifikatBahasa || '',
    isUploaded: Boolean(berkasData?.sertifikatBahasa && berkasData.sertifikatBahasa.trim().length > 0),
  },
  {
    id: 'sertifikatOrganisasi',
    label: 'Sertifikat Organisasi / Kepanitiaan',
    desc: 'Bukti keikutsertaan kepengurusan organisasi atau kepanitiaan.',
    accept: '.pdf,application/pdf',
    typeHint: 'PDF (Maks 2MB)',
    maxSizeMB: 2,
    isMultiple: false,
    maxFiles: 1,
    fileKey: berkasData?.sertifikatOrganisasi || '',
    isUploaded: Boolean(berkasData?.sertifikatOrganisasi && berkasData.sertifikatOrganisasi.trim().length > 0),
  },
];

const totalMandatory = mandatoryDocs.length;
const uploadedMandatoryCount = mandatoryDocs.filter((d) => d.isUploaded).length;
const initialProgressPercent = Math.round((uploadedMandatoryCount / totalMandatory) * 100);
---

<MainLayout title="Unggah Berkas Pendaftaran - PERISAI UMI">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10" data-user-nim={userNim}>
    
    <!-- Top Bar: Navigation & Progress Summary -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold mb-2">
          Tahapan Seleksi Berkas
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          Unggah Berkas Pendaftaran
        </h1>
        <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-2xl">
          Setiap berkas dapat diunggah secara independen. Foto dipotong otomatis dengan rasio 4:6, gambar dikompresi di browser, dan karya ZIP dilengkapi indikator progres.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/user/dashboard"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white border border-white/10 text-xs font-semibold transition-all"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Kembali ke Dashboard
        </a>
      </div>
    </div>

    <!-- Progress Card -->
    <div class="bg-[#121217] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl mb-8 relative overflow-hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-gray-400">Progres Berkas Wajib</span>
          <div class="flex items-center gap-2 mt-1">
            <h3 class="text-xl sm:text-2xl font-black text-white font-mono">
              <span id="stat-uploaded-count">{uploadedMandatoryCount}</span> / {totalMandatory}
            </h3>
            <span class="text-xs text-gray-400">Dokumen Wajib Terkumpul</span>
          </div>
        </div>

        <div class="text-right">
          <span id="stat-percent-text" class="text-lg sm:text-xl font-black text-amber-400 font-mono">
            {initialProgressPercent}%
          </span>
          <span class="block text-[11px] text-gray-500">
            {uploadedMandatoryCount === totalMandatory ? 'Lengkap & Siap Dinilai' : 'Lengkapi sebelum batas waktu'}
          </span>
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="w-full bg-white/5 rounded-full h-2.5 overflow-hidden border border-white/5">
        <div
          id="stat-progress-bar"
          class="h-full bg-gradient-to-r from-amber-500 to-amber-300 rounded-full transition-all duration-500"
          style={`width: ${initialProgressPercent}%`}
        ></div>
      </div>
    </div>

    <!-- Global Floating Toast Notification -->
    <div
      id="upload-toast"
      class="hidden fixed bottom-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all duration-300 text-xs flex items-center gap-3"
      role="alert"
    >
      <div id="toast-icon" class="flex-shrink-0"></div>
      <div class="flex-1">
        <strong id="toast-title" class="block font-bold mb-0.5"></strong>
        <span id="toast-msg" class="text-gray-300 leading-relaxed"></span>
      </div>
    </div>

    <!-- Static Pusat Bantuan WhatsApp Banner -->
    <div class="mb-8 p-5 sm:p-6 rounded-3xl bg-gradient-to-r from-emerald-950/30 via-[#131d17] to-[#121217] border border-emerald-500/25 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-lg">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6 fill-currentColor" viewBox="0 0 16 16">
            <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-white tracking-tight">Butuh Bantuan Unggah Berkas?</h3>
          <p class="text-xs text-gray-400 mt-0.5">Admin Panitia OPREC siap membantu jika ukuran file terlalu besar, gagal upload, atau ada kendala format dokumen.</p>
        </div>
      </div>

      <a
        href={formWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-xs shadow-md shadow-emerald-500/20 hover:shadow-emerald-500/35 transition-all flex-shrink-0 cursor-pointer"
      >
        <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 16 16">
          <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
        </svg>
        <span>Hubungi Admin WA</span>
      </a>
    </div>

    <!-- SECTION 1: Berkas Wajib Persyaratan -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6 pb-3 border-b border-white/10">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        <h2 class="text-base sm:text-lg font-bold text-white tracking-tight">
          1. Dokumen Wajib Persyaratan (7 Berkas)
        </h2>
        <span class="text-xs text-amber-400 font-mono bg-amber-400/10 px-2.5 py-0.5 rounded-full border border-amber-400/20">
          Wajib Dilengkapi
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {mandatoryDocs.map((doc) => (
          <div
            id={`card-${doc.id}`}
            class={`doc-card bg-[#13131b] border rounded-3xl p-6 transition-all duration-200 relative flex flex-col justify-between ${
              doc.isUploaded
                ? 'border-emerald-500/30 hover:border-emerald-500/50 shadow-emerald-500/5'
                : 'border-white/10 hover:border-white/20'
            }`}
            data-category={doc.id}
            data-label={doc.label}
            data-max-size={doc.maxSizeMB}
            data-multiple={doc.isMultiple ? 'true' : 'false'}
            data-max-files={doc.maxFiles}
          >
            <!-- Card Content Top -->
            <div>
              <div class="flex items-start justify-between gap-3 mb-2">
                <h3 class="font-bold text-sm sm:text-base text-white leading-snug">
                  {doc.label}
                </h3>

                <!-- Status Badge -->
                <div id={`badge-${doc.id}`} class="flex-shrink-0">
                  {doc.isUploaded ? (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      Selesai ✅
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-white/5 text-gray-400 border border-white/5">
                      Belum Diunggah
                    </span>
                  )}
                </div>
              </div>

              <p class="text-xs text-gray-400 leading-relaxed mb-4">
                {doc.desc}
              </p>

              <!-- Uploaded Preview List -->
              <div id={`preview-${doc.id}`} class={`mb-4 p-3 rounded-xl bg-black/40 border border-white/5 flex flex-col gap-2 ${doc.isUploaded ? '' : 'hidden'}`}>
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2 overflow-hidden">
                    <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span id={`filename-text-${doc.id}`} class="text-xs font-mono text-gray-300 truncate" title={doc.fileKey}>
                      {doc.fileKey ? (doc.isMultiple ? `${doc.fileKey.split(',').length} foto tersimpan` : doc.fileKey) : 'Berkas tersimpan'}
                    </span>
                  </div>

                  <div id={`view-links-container-${doc.id}`} class="flex items-center gap-1.5 flex-wrap flex-shrink-0">
                    {doc.fileKey && (
                      doc.fileKey.split(',').map((k: string, idx: number) => (
                        <a
                          href={`/api/file/view?name=${encodeURIComponent(k.trim())}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/15 text-amber-300 hover:text-white text-[11px] font-semibold transition-colors"
                        >
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                          </svg>
                          {doc.isMultiple ? `Foto ${idx + 1}` : 'Lihat'}
                        </a>
                      ))
                    )}
                  </div>
                </div>
              </div>

              <!-- Real-time Progress Bar for ZIP / Large Uploads -->
              <div id={`progress-wrap-${doc.id}`} class="hidden mb-4 p-3 rounded-xl bg-black/50 border border-amber-500/20">
                <div class="flex items-center justify-between text-xs mb-1.5">
                  <span id={`progress-status-${doc.id}`} class="text-amber-300 font-semibold font-mono">Mengunggah...</span>
                  <span id={`progress-percent-${doc.id}`} class="text-amber-400 font-mono font-bold">0%</span>
                </div>
                <div class="w-full bg-white/10 rounded-full h-2 overflow-hidden">
                  <div id={`progress-bar-${doc.id}`} class="h-full bg-amber-400 rounded-full transition-all duration-150" style="width: 0%"></div>
                </div>
              </div>

              <!-- Error Alert on Card -->
              <div id={`error-box-${doc.id}`} class="hidden mb-4 p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs leading-relaxed"></div>
            </div>

            <!-- Upload Input & Button Trigger -->
            <div class="pt-3 border-t border-white/5">
              <input
                type="file"
                id={`input-${doc.id}`}
                class="doc-file-input hidden"
                data-category={doc.id}
                data-label={doc.label}
                data-max-size={doc.maxSizeMB}
                data-multiple={doc.isMultiple ? 'true' : 'false'}
                data-max-files={doc.maxFiles}
                accept={doc.accept}
                multiple={doc.isMultiple}
              />

              <div class="flex items-center justify-between gap-3">
                <span class="text-[11px] text-gray-500 font-mono">
                  {doc.typeHint}
                </span>

                <button
                  type="button"
                  id={`btn-trigger-${doc.id}`}
                  class="upload-trigger-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer bg-amber-400 hover:bg-amber-300 text-black shadow-md shadow-amber-500/20 disabled:opacity-50 disabled:cursor-not-allowed"
                  data-target-input={`input-${doc.id}`}
                >
                  <span id={`btn-text-${doc.id}`}>{doc.isUploaded ? 'Ganti Berkas' : 'Unggah Berkas'}</span>
                  <svg id={`btn-spin-${doc.id}`} class="hidden w-3.5 h-3.5 animate-spin text-black" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </button>
              </div>
            </div>

          </div>
        ))}
      </div>
    </div>

    <!-- SECTION 2: Berkas Pendukung / Opsional -->
    <div>
      <div class="flex items-center gap-3 mb-6 pb-3 border-b border-white/10">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
        <h2 class="text-base sm:text-lg font-bold text-white tracking-tight">
          2. Dokumen Pendukung (Opsional)
        </h2>
        <span class="text-xs text-blue-400 font-mono bg-blue-400/10 px-2.5 py-0.5 rounded-full border border-blue-400/20">
          Nilai Tambah
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {optionalDocs.map((doc) => (
          <div
            id={`card-${doc.id}`}
            class={`doc-card bg-[#13131b] border rounded-3xl p-6 transition-all duration-200 relative flex flex-col justify-between ${
              doc.isUploaded
                ? 'border-emerald-500/30 hover:border-emerald-500/50 shadow-emerald-500/5'
                : 'border-white/10 hover:border-white/20'
            }`}
            data-category={doc.id}
            data-label={doc.label}
            data-max-size={doc.maxSizeMB}
            data-multiple="false"
            data-max-files="1"
          >
            <div>
              <div class="flex items-start justify-between gap-3 mb-2">
                <h3 class="font-bold text-sm text-white leading-snug">
                  {doc.label}
                </h3>

                <div id={`badge-${doc.id}`} class="flex-shrink-0">
                  {doc.isUploaded ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                      Selesai ✅
                    </span>
                  ) : (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-white/5 text-gray-500 border border-white/5">
                      Opsional
                    </span>
                  )}
                </div>
              </div>

              <p class="text-xs text-gray-400 leading-relaxed mb-4">
                {doc.desc}
              </p>

              <!-- Uploaded Preview -->
              <div id={`preview-${doc.id}`} class={`mb-4 p-2.5 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between gap-2 ${doc.isUploaded ? '' : 'hidden'}`}>
                <span id={`filename-text-${doc.id}`} class="text-xs font-mono text-gray-300 truncate" title={doc.fileKey}>
                  {doc.fileKey || 'Berkas tersimpan'}
                </span>
                <div id={`view-links-container-${doc.id}`}>
                  {doc.fileKey && (
                    <a
                      href={`/api/file/view?name=${encodeURIComponent(doc.fileKey)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-2 py-0.5 rounded bg-white/10 text-amber-300 text-[10px] font-semibold hover:text-white"
                    >
                      Lihat
                    </a>
                  )}
                </div>
              </div>

              <!-- Progress Bar -->
              <div id={`progress-wrap-${doc.id}`} class="hidden mb-4 p-3 rounded-xl bg-black/50 border border-amber-500/20">
                <div class="flex items-center justify-between text-xs mb-1">
                  <span id={`progress-status-${doc.id}`} class="text-amber-300 font-mono">Mengunggah...</span>
                  <span id={`progress-percent-${doc.id}`} class="text-amber-400 font-mono font-bold">0%</span>
                </div>
                <div class="w-full bg-white/10 rounded-full h-1.5 overflow-hidden">
                  <div id={`progress-bar-${doc.id}`} class="h-full bg-amber-400 rounded-full transition-all" style="width: 0%"></div>
                </div>
              </div>

              <div id={`error-box-${doc.id}`} class="hidden mb-4 p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs"></div>
            </div>

            <!-- Upload Trigger -->
            <div class="pt-3 border-t border-white/5">
              <input
                type="file"
                id={`input-${doc.id}`}
                class="doc-file-input hidden"
                data-category={doc.id}
                data-label={doc.label}
                data-max-size={doc.maxSizeMB}
                data-multiple="false"
                data-max-files="1"
                accept={doc.accept}
              />

              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] text-gray-500 font-mono">
                  {doc.typeHint}
                </span>

                <button
                  type="button"
                  id={`btn-trigger-${doc.id}`}
                  class="upload-trigger-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer bg-white/10 hover:bg-white/15 text-gray-200 border border-white/10 disabled:opacity-50"
                  data-target-input={`input-${doc.id}`}
                >
                  <span id={`btn-text-${doc.id}`}>{doc.isUploaded ? 'Ganti' : 'Unggah'}</span>
                  <svg id={`btn-spin-${doc.id}`} class="hidden w-3 h-3 animate-spin text-white" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </button>
              </div>
            </div>

          </div>
        ))}
      </div>
    </div>

    <!-- PAS FOTO CROPPER MODAL (Locked to 4:6 Aspect Ratio) -->
    <div
      id="cropper-modal"
      class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4"
    >
      <div class="bg-[#161622] border border-white/15 rounded-3xl max-w-xl w-full p-6 shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
        
        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
          <div>
            <h3 class="text-lg font-bold text-white tracking-tight flex items-center gap-2">
              <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              Potong Pas Foto (Rasio 4:6)
            </h3>
            <p class="text-xs text-gray-400 mt-0.5">
              Rasio terkunci 4:6. Sesuaikan bingkai agar wajah terlihat proporsional dan jelas.
            </p>
          </div>
          <button
            type="button"
            id="cropper-close-btn"
            class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-gray-300 hover:text-white flex items-center justify-center text-sm cursor-pointer transition-colors"
          >
            ✕
          </button>
        </div>

        <!-- Cropper Image Viewport -->
        <div class="flex-1 min-h-[300px] max-h-[50vh] bg-black/60 rounded-2xl overflow-hidden flex items-center justify-center border border-white/5 relative">
          <img id="cropper-target-img" class="max-w-full max-h-full block" alt="Foto Pas" />
        </div>

        <!-- Cropper Tool Controls -->
        <div class="flex items-center justify-between gap-3 pt-4 border-t border-white/10 mt-4">
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="cropper-rotate-left"
              class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 text-xs font-semibold flex items-center gap-1 border border-white/10 cursor-pointer"
              title="Putar ke Kiri"
            >
              ↺ Putar Kiri
            </button>
            <button
              type="button"
              id="cropper-rotate-right"
              class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 text-xs font-semibold flex items-center gap-1 border border-white/10 cursor-pointer"
              title="Putar ke Kanan"
            >
              ↻ Putar Kanan
            </button>
            <button
              type="button"
              id="cropper-reset"
              class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-gray-400 hover:text-white text-xs font-semibold border border-white/10 cursor-pointer"
            >
              Reset
            </button>
          </div>

          <div class="flex items-center gap-3">
            <button
              type="button"
              id="cropper-cancel-btn"
              class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 transition-colors cursor-pointer"
            >
              Batal
            </button>
            <button
              type="button"
              id="cropper-apply-btn"
              class="px-5 py-2 rounded-xl text-xs font-bold text-black bg-amber-400 hover:bg-amber-300 shadow-md shadow-amber-500/20 transition-all cursor-pointer flex items-center gap-2"
            >
              <span>Terapkan & Unggah</span>
            </button>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Client-side Advanced Upload Script (Validation, Cropper, Compression, Progress Bar) -->
  <script>
    import Cropper from 'cropperjs';
    import imageCompression from 'browser-image-compression';

    function initAdvancedUploader() {
      const container = document.querySelector('[data-user-nim]') as HTMLElement | null;
      const userNim = container?.getAttribute('data-user-nim') || '';

      // Toast feedback
      const toast = document.getElementById('upload-toast');
      const toastTitle = document.getElementById('toast-title');
      const toastMsg = document.getElementById('toast-msg');
      const toastIcon = document.getElementById('toast-icon');

      function showToast(type: 'success' | 'error', title: string, message: string) {
        if (!toast || !toastTitle || !toastMsg || !toastIcon) return;
        toastTitle.textContent = title;
        toastMsg.textContent = message;

        if (type === 'success') {
          toast.className = 'fixed bottom-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all duration-300 text-xs flex items-center gap-3 bg-[#131d16] border-emerald-500/40 text-emerald-300';
          toastIcon.innerHTML = `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>`;
        } else {
          toast.className = 'fixed bottom-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all duration-300 text-xs flex items-center gap-3 bg-[#201316] border-rose-500/40 text-rose-300';
          toastIcon.innerHTML = `<svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
        }

        toast.classList.remove('hidden');
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 5000);
      }

      // Cropper state
      let activeCropper: Cropper | null = null;
      let pendingPasFotoResolve: ((file: File | null) => void) | null = null;

      const cropperModal = document.getElementById('cropper-modal');
      const cropperImg = document.getElementById('cropper-target-img') as HTMLImageElement | null;
      const cropperCloseBtn = document.getElementById('cropper-close-btn');
      const cropperCancelBtn = document.getElementById('cropper-cancel-btn');
      const cropperApplyBtn = document.getElementById('cropper-apply-btn');
      const cropperRotateLeft = document.getElementById('cropper-rotate-left');
      const cropperRotateRight = document.getElementById('cropper-rotate-right');
      const cropperReset = document.getElementById('cropper-reset');

      function openCropperModal(file: File): Promise<File | null> {
        return new Promise((resolve) => {
          if (!cropperModal || !cropperImg) {
            resolve(file);
            return;
          }

          pendingPasFotoResolve = resolve;
          const reader = new FileReader();
          reader.onload = (e) => {
            if (!e.target?.result) {
              resolve(null);
              return;
            }

            cropperImg.src = e.target.result as string;
            cropperModal.classList.remove('hidden');

            if (activeCropper) {
              activeCropper.destroy();
            }

            activeCropper = new Cropper(cropperImg, {
              aspectRatio: 4 / 6, // 4:6 portrait ratio
              viewMode: 1,
              autoCropArea: 0.9,
              responsive: true,
              restore: false,
              guides: true,
              center: true,
              highlight: false,
              cropBoxMovable: true,
              cropBoxResizable: true,
              toggleDragModeOnDblclick: false,
            });
          };

          reader.readAsDataURL(file);
        });
      }

      function closeCropperModal(resultFile: File | null) {
        if (activeCropper) {
          activeCropper.destroy();
          activeCropper = null;
        }
        if (cropperModal) {
          cropperModal.classList.add('hidden');
        }
        if (pendingPasFotoResolve) {
          pendingPasFotoResolve(resultFile);
          pendingPasFotoResolve = null;
        }
      }

      cropperCloseBtn?.addEventListener('click', () => closeCropperModal(null));
      cropperCancelBtn?.addEventListener('click', () => closeCropperModal(null));
      cropperRotateLeft?.addEventListener('click', () => activeCropper?.rotate(-90));
      cropperRotateRight?.addEventListener('click', () => activeCropper?.rotate(90));
      cropperReset?.addEventListener('click', () => activeCropper?.reset());

      cropperApplyBtn?.addEventListener('click', () => {
        if (!activeCropper) {
          closeCropperModal(null);
          return;
        }

        const canvas = activeCropper.getCroppedCanvas({
          width: 600,
          height: 900,
          imageSmoothingQuality: 'high',
        });

        if (!canvas) {
          closeCropperModal(null);
          return;
        }

        canvas.toBlob((blob) => {
          if (!blob) {
            closeCropperModal(null);
            return;
          }
          const croppedFile = new File([blob], 'pas-foto.jpg', { type: 'image/jpeg' });
          closeCropperModal(croppedFile);
        }, 'image/jpeg', 0.92);
      });

      // Bind all Trigger Buttons
      const triggerButtons = document.querySelectorAll<HTMLButtonElement>('.upload-trigger-btn');
      triggerButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetInputId = btn.getAttribute('data-target-input');
          if (!targetInputId) return;
          const input = document.getElementById(targetInputId) as HTMLInputElement | null;
          if (input) {
            input.click();
          }
        });
      });

      // Bind all Inputs
      const fileInputs = document.querySelectorAll<HTMLInputElement>('.doc-file-input');
      fileInputs.forEach((input) => {
        input.addEventListener('change', async () => {
          if (!input.files || input.files.length === 0) return;
          const files = Array.from(input.files);
          const category = input.getAttribute('data-category') || '';
          const label = input.getAttribute('data-label') || 'Dokumen';
          const maxMB = Number(input.getAttribute('data-max-size') || '10');
          const isMultiple = input.getAttribute('data-multiple') === 'true';
          const maxFiles = Number(input.getAttribute('data-max-files') || '1');

          await handleValidationAndUpload(category, label, files, maxMB, isMultiple, maxFiles, input);
        });
      });

      // File Validation Rules
      function validateFiles(category: string, files: File[], maxMB: number, isMultiple: boolean, maxFiles: number): string | null {
        if (files.length === 0) return 'Silakan pilih berkas.';

        if (!isMultiple && files.length > 1) {
          return `Hanya dapat mengunggah 1 berkas untuk ${category}.`;
        }

        if (isMultiple && files.length > maxFiles) {
          return `Maksimal hanya dapat memilih ${maxFiles} foto sekaligus.`;
        }

        for (const file of files) {
          const name = file.name.toLowerCase();
          const ext = name.substring(name.lastIndexOf('.'));
          const sizeMB = file.size / (1024 * 1024);

          // 1. PDF Only docs
          if (['ktm', 'cv', 'transkripNilai', 'sertifikatPrestasi', 'sertifikatBahasa', 'sertifikatOrganisasi'].includes(category)) {
            if (ext !== '.pdf' && file.type !== 'application/pdf') {
              return `Format berkas salah. ${category.toUpperCase()} wajib berformat PDF (.pdf).`;
            }
            if (sizeMB > maxMB) {
              return `Ukuran berkas PDF melebihi batas maksimal ${maxMB} MB. (Ukuran saat ini: ${sizeMB.toFixed(2)} MB).`;
            }
          }

          // 2. JPG/PNG docs
          else if (['pasFoto', 'buktiFollow', 'buktiShare'].includes(category)) {
            const validImgExt = ['.jpg', '.jpeg', '.png'];
            const isImg = validImgExt.some(e => name.endsWith(e)) || file.type.startsWith('image/');
            if (!isImg) {
              return `Format salah. Berkas wajib berupa gambar JPG atau PNG (.jpg, .jpeg, .png).`;
            }
            if (sizeMB > maxMB) {
              return `Ukuran gambar melebihi batas maksimal ${maxMB} MB per foto. (Ukuran: ${sizeMB.toFixed(2)} MB).`;
            }
          }

          // 3. ZIP docs (Karya)
          else if (category === 'fileKarya') {
            const isZip = name.endsWith('.zip') || file.type.includes('zip');
            if (!isZip) {
              return 'Format berkas salah. File Karya Peminatan wajib berupa arsip ZIP (.zip).';
            }
            if (sizeMB > maxMB) {
              return `Ukuran file karya ZIP melebihi batas maksimal ${maxMB} MB. (Ukuran: ${sizeMB.toFixed(2)} MB).`;
            }
          }
        }

        return null;
      }

      // XHR Upload with Real-Time Progress Bar
      function uploadToS3WithProgress(uploadUrl: string, file: Blob, onProgress: (pct: number, loaded: number, total: number) => void): Promise<void> {
        return new Promise((resolve, reject) => {
          const xhr = new XMLHttpRequest();
          xhr.open('PUT', uploadUrl, true);
          xhr.setRequestHeader('Content-Type', file.type || 'application/octet-stream');

          xhr.upload.onprogress = (e) => {
            if (e.lengthComputable) {
              const percent = Math.round((e.loaded / e.total) * 100);
              onProgress(percent, e.loaded, e.total);
            }
          };

          xhr.onload = () => {
            if (xhr.status >= 200 && xhr.status < 300) {
              resolve();
            } else {
              reject(new Error(`Gagal mengunggah ke S3 (HTTP ${xhr.status}): ${xhr.statusText}`));
            }
          };

          xhr.onerror = () => reject(new Error('Koneksi terputus saat mengunggah berkas ke S3.'));
          xhr.onabort = () => reject(new Error('Pengunggahan dibatalkan.'));

          xhr.send(file);
        });
      }

      // Main Upload Controller
      async function handleValidationAndUpload(
        category: string,
        label: string,
        files: File[],
        maxMB: number,
        isMultiple: boolean,
        maxFiles: number,
        inputEl: HTMLInputElement
      ) {
        const card = document.getElementById(`card-${category}`);
        const badge = document.getElementById(`badge-${category}`);
        const btnText = document.getElementById(`btn-text-${category}`);
        const btnSpin = document.getElementById(`btn-spin-${category}`);
        const btnTrigger = document.getElementById(`btn-trigger-${category}`) as HTMLButtonElement | null;
        const errorBox = document.getElementById(`error-box-${category}`);
        const preview = document.getElementById(`preview-${category}`);
        const filenameText = document.getElementById(`filename-text-${category}`);
        const viewLinksContainer = document.getElementById(`view-links-container-${category}`);
        const progressWrap = document.getElementById(`progress-wrap-${category}`);
        const progressBar = document.getElementById(`progress-bar-${category}`);
        const progressPercent = document.getElementById(`progress-percent-${category}`);
        const progressStatus = document.getElementById(`progress-status-${category}`);

        // Reset error
        if (errorBox) {
          errorBox.classList.add('hidden');
          errorBox.textContent = '';
        }

        // STEP 1: Strict Validation
        const validationError = validateFiles(category, files, maxMB, isMultiple, maxFiles);
        if (validationError) {
          if (errorBox) {
            errorBox.textContent = validationError;
            errorBox.classList.remove('hidden');
          }
          showToast('error', 'Validasi Berkas Gagal', validationError);
          inputEl.value = '';
          return;
        }

        // STEP 2: Pas Foto Cropping (Rasio 4:6)
        let readyFiles: File[] = files;
        if (category === 'pasFoto') {
          const croppedResult = await openCropperModal(files[0]);
          if (!croppedResult) {
            // User cancelled cropping
            inputEl.value = '';
            return;
          }
          readyFiles = [croppedResult];
        }

        // Set Loading State on Card
        if (btnTrigger) btnTrigger.disabled = true;
        if (btnSpin) btnSpin.classList.remove('hidden');
        if (btnText) btnText.textContent = 'Memproses...';
        if (progressWrap) progressWrap.classList.remove('hidden');
        if (progressBar) progressBar.style.width = '0%';
        if (progressPercent) progressPercent.textContent = '0%';
        if (progressStatus) progressStatus.textContent = 'Menyiapkan berkas...';

        if (badge) {
          badge.innerHTML = `
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-400/15 text-amber-300 border border-amber-400/30 animate-pulse">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              Memproses...
            </span>
          `;
        }

        try {
          const uploadedFileKeys: string[] = [];

          // Process each file (supports multiple for buktiFollow/Share, single for others)
          for (let i = 0; i < readyFiles.length; i++) {
            let fileToUpload = readyFiles[i];

            // STEP 3: Client-Side Image Compression for JPG/PNG
            if (['pasFoto', 'buktiFollow', 'buktiShare'].includes(category)) {
              if (progressStatus) progressStatus.textContent = `Mengompresi gambar ${i + 1}/${readyFiles.length}...`;
              try {
                const compressionOptions = {
                  maxSizeMB: 0.5, // 500 KB target
                  maxWidthOrHeight: category === 'pasFoto' ? 1200 : 1920,
                  useWebWorker: true,
                  initialQuality: 0.8, // visually lossless
                };
                fileToUpload = await imageCompression(fileToUpload, compressionOptions);
              } catch (compErr) {
                console.warn('Image compression fallback to original:', compErr);
              }
            }

            // Presign API
            if (progressStatus) progressStatus.textContent = `Minta izin unggah ${i + 1}/${readyFiles.length}...`;
            const presignRes = await fetch('/api/upload/presign', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
              },
              body: JSON.stringify({
                nim: userNim,
                jenisBerkas: label,
                fileName: fileToUpload.name,
                contentType: fileToUpload.type || 'application/octet-stream',
                category: category,
              }),
            });

            const presignData = (await presignRes.json()) as any;
            if (!presignRes.ok || !presignData.success) {
              throw new Error(presignData.message || 'Gagal menyiapkan izin upload.');
            }

            const uploadUrl = presignData.presignedUrl || presignData.uploadUrl;
            const fileKey = presignData.fileKey || presignData.finalFileName;

            // STEP 4: S3 Upload with Progress Event
            if (progressStatus) progressStatus.textContent = `Mengunggah ke S3 (${i + 1}/${readyFiles.length})...`;
            await uploadToS3WithProgress(uploadUrl, fileToUpload, (pct, loaded, total) => {
              if (progressBar) progressBar.style.width = `${pct}%`;
              if (progressPercent) progressPercent.textContent = `${pct}%`;
              if (category === 'fileKarya' && progressStatus) {
                const loadedMB = (loaded / (1024 * 1024)).toFixed(1);
                const totalMB = (total / (1024 * 1024)).toFixed(1);
                progressStatus.textContent = `Mengunggah ZIP: ${loadedMB} MB / ${totalMB} MB (${pct}%)`;
              }
            });

            uploadedFileKeys.push(fileKey);
          }

          // STEP 5: Partial Database Update via PATCH /api/upload/confirm
          if (progressStatus) progressStatus.textContent = 'Mencatat data ke database...';
          const combinedKeys = uploadedFileKeys.join(',');

          const confirmRes = await fetch('/api/upload/confirm', {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify({
              fileKey: combinedKeys,
              finalFileName: combinedKeys,
              category: category,
            }),
          });

          const confirmData = (await confirmRes.json()) as any;
          if (!confirmRes.ok || !confirmData.success) {
            throw new Error(confirmData.message || 'Berkas terunggah namun gagal dicatat di database.');
          }

          // Success UI Update
          if (badge) {
            badge.innerHTML = `
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Selesai ✅
              </span>
            `;
          }

          if (card) {
            card.classList.remove('border-white/10');
            card.classList.add('border-emerald-500/30');
          }

          if (preview) preview.classList.remove('hidden');
          if (filenameText) {
            filenameText.textContent = isMultiple ? `${uploadedFileKeys.length} foto berhasil diunggah` : combinedKeys;
          }

          if (viewLinksContainer) {
            viewLinksContainer.innerHTML = uploadedFileKeys
              .map((k, idx) => `
                <a
                  href="/api/file/view?name=${encodeURIComponent(k)}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/15 text-amber-300 hover:text-white text-[11px] font-semibold transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                  ${isMultiple ? `Foto ${idx + 1}` : 'Lihat'}
                </a>
              `)
              .join('');
          }

          if (btnText) btnText.textContent = 'Ganti Berkas';

          // Update Progress Stats
          if (confirmData.data && typeof confirmData.data.completedMandatoryCount === 'number') {
            const count = confirmData.data.completedMandatoryCount;
            const countEl = document.getElementById('stat-uploaded-count');
            const percentEl = document.getElementById('stat-percent-text');
            const barEl = document.getElementById('stat-progress-bar');

            if (countEl) countEl.textContent = String(count);
            const pct = Math.round((count / 7) * 100);
            if (percentEl) percentEl.textContent = `${pct}%`;
            if (barEl) barEl.style.width = `${pct}%`;
          }

          showToast('success', `${label} Berhasil Disimpan!`, `${uploadedFileKeys.length} berkas tersimpan aman di cloud.`);
        } catch (err: any) {
          console.error(`Error uploading ${category}:`, err);
          if (errorBox) {
            errorBox.textContent = err.message || 'Terjadi kesalahan saat mengunggah berkas.';
            errorBox.classList.remove('hidden');
          }
          if (badge) {
            badge.innerHTML = `
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-500/15 text-rose-300 border border-rose-500/30">
                Gagal Unggah
              </span>
            `;
          }
          if (btnText) btnText.textContent = 'Coba Lagi';
          showToast('error', `Gagal Mengunggah ${label}`, err.message || 'Silakan coba kembali.');
        } finally {
          if (btnTrigger) btnTrigger.disabled = false;
          if (btnSpin) btnSpin.classList.add('hidden');
          if (progressWrap) progressWrap.classList.add('hidden');
          inputEl.value = '';
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAdvancedUploader);
    } else {
      initAdvancedUploader();
    }
  </script>
</MainLayout>
