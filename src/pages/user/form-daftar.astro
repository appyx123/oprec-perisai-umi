---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';

const user = Astro.locals.user as AuthUser | null | undefined;
if (!user || user.role !== 'user') {
  return Astro.redirect('/auth/login');
}
---

<MainLayout title="Unggah Berkas Pendaftaran - PERISAI UMI">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Header -->
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold mb-3">
        Tahapan Seleksi Berkas
      </div>
      <h1 class="text-3xl font-black text-white tracking-tight">
        Unggah Berkas Pendaftaran
      </h1>
      <p class="text-sm text-gray-400 mt-2">
        Silakan unggah dokumen persyaratan calon anggota baru UKM PERISAI UMI sesuai instruksi di bawah ini.
      </p>
    </div>

    <!-- Upload Card -->
    <div class="bg-[#121217] border border-white/10 rounded-3xl p-8 shadow-xl relative overflow-hidden">
      
      <!-- User Identification Strip -->
      <div class="flex items-center justify-between pb-6 mb-6 border-b border-white/10 text-sm">
        <div>
          <span class="text-gray-400">Peserta: </span>
          <span class="font-bold text-white">{user.name}</span>
          <span class="text-xs text-amber-400 font-mono ml-2">({user.nim || 'NIM belum terdaftar'})</span>
        </div>
        <div class="text-xs text-gray-500 font-mono">
          ID Pendaftar: #{user.id}
        </div>
      </div>

      <!-- Alert Box -->
      <div
        id="status-alert"
        class="hidden mb-6 p-5 rounded-2xl text-sm"
        role="alert"
      >
        <div class="flex items-start gap-3">
          <div id="status-icon" class="flex-shrink-0 mt-0.5"></div>
          <div class="flex-1">
            <h4 id="status-title" class="font-bold text-base mb-1"></h4>
            <p id="status-message" class="text-xs leading-relaxed"></p>
            <div id="status-details" class="mt-3 text-xs font-mono break-all hidden bg-black/50 p-3 rounded-xl border border-white/10"></div>
          </div>
        </div>
      </div>

      <!-- Upload Form -->
      <form id="upload-form" data-nim={user.nim || ''} class="space-y-6">
        <div>
          <label for="ktm-file" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
            Unggah Kartu Tanda Mahasiswa (KTM)
          </label>
          <div class="relative border-2 border-dashed border-white/20 hover:border-amber-400/50 rounded-2xl p-6 text-center transition-colors bg-[#181820]/50">
            <input
              type="file"
              id="ktm-file"
              name="ktm-file"
              required
              accept="image/*,application/pdf"
              class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
            />
            <div class="space-y-2 pointer-events-none">
              <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div class="text-sm text-gray-300">
                <span class="font-semibold text-amber-400">Pilih berkas KTM</span> atau seret ke area ini
              </div>
              <p class="text-xs text-gray-500">
                Format: PDF, JPG, PNG (Maksimum 10MB)
              </p>
              <p id="file-name-display" class="text-xs font-mono text-emerald-400 pt-2 hidden"></p>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          id="upload-btn"
          class="w-full py-3.5 px-4 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-sm shadow-lg shadow-amber-500/20 hover:shadow-amber-500/35 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span id="btn-text">Unggah Berkas</span>
          <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin text-black" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>

    </div>
  </div>

  <!-- Client-side Upload Script -->
  <script>
    const form = document.getElementById('upload-form') as HTMLFormElement | null;
    const fileInput = document.getElementById('ktm-file') as HTMLInputElement | null;
    const fileNameDisplay = document.getElementById('file-name-display') as HTMLParagraphElement | null;
    const uploadBtn = document.getElementById('upload-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text') as HTMLSpanElement | null;
    const btnSpinner = document.getElementById('btn-spinner') as SVGElement | null;

    const alertBox = document.getElementById('status-alert') as HTMLDivElement | null;
    const alertTitle = document.getElementById('status-title') as HTMLHeadingElement | null;
    const alertMessage = document.getElementById('status-message') as HTMLParagraphElement | null;
    const alertDetails = document.getElementById('status-details') as HTMLDivElement | null;

    if (fileInput && fileNameDisplay) {
      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files[0]) {
          fileNameDisplay.textContent = `Berkas dipilih: ${fileInput.files[0].name} (${(fileInput.files[0].size / 1024).toFixed(1)} KB)`;
          fileNameDisplay.classList.remove('hidden');
        } else {
          fileNameDisplay.classList.add('hidden');
        }
      });
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
          showAlert('error', 'Pilih Berkas', 'Silakan pilih berkas KTM terlebih dahulu sebelum mengunggah.');
          return;
        }

        const file = fileInput.files[0];
        hideAlert();
        setLoading(true, 'Menyiapkan pengunggahan...');

        try {
          // 1. Minta izin unggah dokumen
          const userNim = form.getAttribute('data-nim') || '';
          const presignRes = await fetch('/api/upload/presign', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify({
              nim: userNim,
              jenisBerkas: 'KTM',
              fileName: file.name,
              filename: file.name,
              contentType: file.type || 'application/octet-stream',
              category: 'ktm',
            }),
          });

          const presignData = (await presignRes.json()) as any;

          if (!presignRes.ok || !presignData.success) {
            throw new Error(presignData.message || 'Gagal menyiapkan pengunggahan berkas.');
          }

          const uploadUrl = presignData.presignedUrl || presignData.uploadUrl;
          const finalFileName = presignData.fileKey || presignData.finalFileName;

          // 2. Unggah file dokumen
          setLoading(true, 'Mengunggah berkas...');

          const uploadRes = await fetch(uploadUrl, {
            method: 'PUT',
            headers: {
              'Content-Type': file.type || 'application/octet-stream',
            },
            body: file,
          });

          if (!uploadRes.ok) {
            throw new Error('Terjadi kendala saat mengirim berkas. Silakan coba kembali.');
          }

          // 3. Konfirmasi kelengkapan berkas
          setLoading(true, 'Menyimpan data...');

          const confirmRes = await fetch('/api/upload/confirm', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify({
              finalFileName,
              category: 'ktm',
            }),
          });

          const confirmData = (await confirmRes.json()) as any;

          if (!confirmRes.ok || !confirmData.success) {
            throw new Error(confirmData.message || 'Berkas berhasil dikirim namun belum tercatat. Silakan coba lagi.');
          }

          // 4. Berhasil
          const viewUrl = `/api/file/view?name=${encodeURIComponent(finalFileName)}`;

          showAlert(
            'success',
            'Berkas Berhasil Diunggah!',
            'Dokumen Anda telah berhasil disimpan dan siap diverifikasi oleh panitia seleksi.',
            `<div class="space-y-2">
              <div><span class="text-gray-400">Jenis Dokumen:</span> <span class="text-white font-semibold">Kartu Tanda Mahasiswa (KTM)</span></div>
              <div><span class="text-gray-400">Status Dokumen:</span> <span class="text-emerald-400 font-semibold">Lengkap & Tersimpan</span></div>
              <div class="pt-2">
                <a href="${viewUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 font-bold text-xs border border-emerald-500/40 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                  Lihat Dokumen &rarr;
                </a>
              </div>
            </div>`
          );

          // Reset formulir
          form.reset();
          if (fileNameDisplay) fileNameDisplay.classList.add('hidden');
        } catch (err: any) {
          console.error('Upload/confirm error:', err);
          showAlert(
            'error',
            'Pengunggahan Gagal',
            err.message || 'Terjadi kendala saat mengunggah berkas. Silakan coba beberapa saat lagi.'
          );
        } finally {
          setLoading(false, 'Unggah Berkas');
        }
      });
    }

    function showAlert(type: 'success' | 'error', title: string, message: string, detailsHtml?: string) {
      if (!alertBox || !alertTitle || !alertMessage) return;

      alertBox.className = type === 'success'
        ? 'mb-6 p-5 rounded-2xl text-sm bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 block'
        : 'mb-6 p-5 rounded-2xl text-sm bg-rose-500/10 border border-rose-500/30 text-rose-300 block';

      alertTitle.textContent = title;
      alertMessage.textContent = message;

      if (alertDetails) {
        if (detailsHtml) {
          alertDetails.innerHTML = detailsHtml;
          alertDetails.classList.remove('hidden');
        } else {
          alertDetails.classList.add('hidden');
        }
      }

      if (alertBox) alertBox.classList.remove('hidden');
    }

    function hideAlert() {
      if (alertBox) alertBox.classList.add('hidden');
    }

    function setLoading(isLoading: boolean, message: string) {
      if (uploadBtn) uploadBtn.disabled = isLoading;
      if (btnText) btnText.textContent = message;
      if (btnSpinner) {
        if (isLoading) {
          btnSpinner.classList.remove('hidden');
        } else {
          btnSpinner.classList.add('hidden');
        }
      }
    }
  </script>
</MainLayout>
