---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';
import { createDb } from '../../db';
import { cagens, berkasCagens, systemSettings, documentTypes, cagenDocuments, peminatan } from '../../db/schema';
import { eq, asc } from 'drizzle-orm';

const user = Astro.locals.user as AuthUser | null | undefined;
if (!user || user.role !== 'user') {
  return Astro.redirect('/auth/login');
}

let cagenData: any = null;
let berkasData: any = null;
let settingData: any = null;
let dbError: string | null = null;
let activeDocRequirements: any[] = [];
let userPeminatanId: number | null = null;

// Metadata default per slug untuk deskripsi & hint format
const DOC_METADATA: Record<string, { desc: string; typeHint?: string }> = {
  ktm: {
    desc: 'KTM resmi UMI atau Surat Keterangan Aktif Kuliah dari fakultas.',
    typeHint: 'PDF/JPG/PNG (Maks. 2MB)',
  },
  transkrip: {
    desc: 'Transkrip nilai semester terakhir dari portal akademik UMI.',
    typeHint: 'PDF (Maks. 2MB)',
  },
  pas_foto: {
    desc: 'Pas foto formal terbaru dengan latar belakang merah rapi (rasio 4:6 atau 3:4).',
    typeHint: 'JPG/PNG (Latar Merah, Maks. 2MB)',
  },
  cv: {
    desc: 'Daftar riwayat hidup, pengalaman organisasi/kepanitiaan, dan keahlian.',
    typeHint: 'PDF ATS/Kreatif (Maks. 2MB)',
  },
  bukti_follow: {
    desc: 'Screenshot bukti mengikuti Instagram resmi @perisai.umi dan akun TikTok.',
    typeHint: 'JPG/PNG (Maks. 2MB)',
  },
  bukti_subscribe: {
    desc: 'Screenshot bukti berlangganan kanal YouTube resmi UKM PERISAI UMI.',
    typeHint: 'JPG/PNG (Maks. 2MB)',
  },
  bukti_share: {
    desc: 'Screenshot bukti menyebarkan pamflet OPREC ke minimal 3 grup WA atau status medsos.',
    typeHint: 'JPG/PNG (Maks. 5 Foto, 2MB/foto)',
  },
  sertifikat_prestasi: {
    desc: 'Piagam penghargaan kompetisi akademik/non-akademik (Opsional).',
    typeHint: 'PDF (Opsional, Maks. 2MB)',
  },
  sertifikat_bahasa: {
    desc: 'Sertifikat TOEFL, IELTS, atau tes kemampuan bahasa asing lainnya (Opsional).',
    typeHint: 'PDF (Opsional, Maks. 2MB)',
  },
  sertifikat_organisasi: {
    desc: 'Bukti partisipasi kepengurusan organisasi kampus atau kepanitiaan (Opsional).',
    typeHint: 'PDF (Opsional, Maks. 2MB)',
  },
  portfolio_linkedin: {
    desc: 'Cantumkan tautan akun LinkedIn atau portofolio daring (GitHub/Behance/Dribbble/dll) untuk nilai tambah seleksi.',
    typeHint: 'Tautan URL (Opsional)',
  },
};

const LEGACY_COLUMN_FALLBACK: Record<string, string> = {
  ktm: 'ktm',
  transkrip: 'transkripNilai',
  pas_foto: 'pasFoto',
  cv: 'cv',
  bukti_follow: 'buktiFollow',
  bukti_subscribe: 'buktiFollow',
  bukti_share: 'buktiShare',
  sertifikat_prestasi: 'sertifikatPrestasi',
  sertifikat_bahasa: 'sertifikatBahasa',
  sertifikat_organisasi: 'sertifikatOrganisasi',
  file_karya: 'fileKarya',
  karya_kti: 'fileKarya',
  karya_poster: 'fileKarya',
  karya_debat: 'fileKarya',
  karya_videograph: 'fileKarya',
  karya_business_plan: 'fileKarya',
};

let docMap = new Map<string, string>();

try {
  const db = createDb();
  const [cagenRow] = await db
    .select()
    .from(cagens)
    .where(eq(cagens.id, user.id))
    .limit(1);
  cagenData = cagenRow || null;

  const [berkasRow] = await db
    .select()
    .from(berkasCagens)
    .where(eq(berkasCagens.cagenId, user.id))
    .limit(1);
  berkasData = berkasRow || null;

  // STEP 1: Query strict hanya dokumen aktif (isActive = true)
  activeDocRequirements = await db
    .select({
      id: documentTypes.id,
      slug: documentTypes.slug,
      label: documentTypes.label,
      group: documentTypes.group,
      peminatanId: documentTypes.peminatanId,
      maxFiles: documentTypes.maxFiles,
      inputType: documentTypes.inputType,
      acceptMime: documentTypes.acceptMime,
      maxSizeBytes: documentTypes.maxSizeBytes,
      isActive: documentTypes.isActive,
    })
    .from(documentTypes)
    .where(eq(documentTypes.isActive, true))
    .orderBy(asc(documentTypes.id));

  // Ambil referensi peminatan untuk matching peminatan peserta
  const peminatanRows = await db
    .select({ id: peminatan.id, nama: peminatan.nama })
    .from(peminatan);

  const candidatePeminatanStr = cagenData?.peminatan || berkasData?.peminatan || 'KTI/ESSAY';
  const cleanCandPem = candidatePeminatanStr.toLowerCase().replace(/[^a-z0-9]/g, '');
  const matchedPem = peminatanRows.find(p => {
    const cleanP = p.nama.toLowerCase().replace(/[^a-z0-9]/g, '');
    return cleanP === cleanCandPem || cleanCandPem.includes(cleanP) || cleanP.includes(cleanCandPem);
  });
  userPeminatanId = matchedPem?.id || null;

  // Baca dokumen peserta dari skema relasional baru (cagen_documents)
  const relDocs = await db
    .select({
      slug: documentTypes.slug,
      s3Key: cagenDocuments.s3Key,
    })
    .from(cagenDocuments)
    .innerJoin(documentTypes, eq(cagenDocuments.documentTypeId, documentTypes.id))
    .where(eq(cagenDocuments.cagenId, user.id));

  docMap = new Map(relDocs.map((d) => [d.slug, d.s3Key]));

  const [settingRow] = await db
    .select({ waNumber: systemSettings.waNumber, waMessage: systemSettings.waMessage })
    .from(systemSettings)
    .where(eq(systemSettings.id, 1))
    .limit(1);
  settingData = settingRow || null;
} catch (err: any) {
  console.error('Error fetching berkas portal data:', err);
  dbError = 'Gagal memuat sebagian data profil/berkas. Silakan muat ulang halaman.';
}

const userNim = cagenData?.nim || user.nim || String(user.id);
const chosenPeminatan = cagenData?.peminatan || berkasData?.peminatan || 'KTI/Esai';

// Helper resolusi key berkas
function resolveFileKey(slug: string): string {
  if (docMap.has(slug)) return docMap.get(slug)!;
  const legacyCol = LEGACY_COLUMN_FALLBACK[slug];
  if (legacyCol && berkasData && berkasData[legacyCol]) {
    return String(berkasData[legacyCol]).trim();
  }
  return '';
}

// Format dokumen aktif menjadi view-model
const formattedDocs = activeDocRequirements.map((d) => {
  const fileKey = resolveFileKey(d.slug);
  const isUploaded = Boolean(fileKey && fileKey.trim().length > 0);
  const maxSizeMB = Math.round(d.maxSizeBytes / (1024 * 1024)) || 2;
  const meta = DOC_METADATA[d.slug];
  const desc = meta?.desc || (d.inputType === 'link' ? 'Cantumkan tautan URL sesuai ketentuan penugasan.' : `Unggah berkas persyaratan ${d.label}.`);
  
  let typeHint = '';
  if (d.inputType === 'link') {
    typeHint = 'Tautan / URL (Google Drive, YouTube, dll)';
  } else if (meta?.typeHint) {
    typeHint = meta.typeHint;
  } else {
    let fmt = 'Berkas';
    if (d.acceptMime.includes('pdf')) fmt = 'PDF';
    else if (d.acceptMime.includes('jpeg') || d.acceptMime.includes('png')) fmt = 'JPG/PNG';
    else if (d.acceptMime.includes('zip')) fmt = 'ZIP';
    else if (d.acceptMime.includes('mp4')) fmt = 'MP4';
    typeHint = `${fmt} (Maks. ${maxSizeMB}MB)`;
  }

  return {
    id: d.id,
    slug: d.slug,
    label: d.label,
    group: d.group,
    peminatanId: d.peminatanId,
    inputType: (d.inputType || 'file') as 'file' | 'link',
    acceptMime: d.acceptMime,
    maxSizeMB,
    desc,
    typeHint,
    fileKey,
    isUploaded,
    isRequired: d.group === 'wajib',
  };
});

// Pembagian ke dalam 3 Tab:
// 1. Administrasi Utama: wajib, bukan bukti medsos, dan peminatanId null
const adminDocsList = formattedDocs.filter((d) => 
  d.group === 'wajib' && 
  !d.slug.startsWith('bukti_') && 
  d.peminatanId === null
);

// 2. Media Sosial & Opsional: bukti medsos ATAU group opsional
const mediaDocsList = formattedDocs.filter((d) => 
  d.slug.startsWith('bukti_') || 
  d.group === 'opsional'
);

// 3. Karya Peminatan: group karya & (peminatanId null atau cocok dengan peminatan peserta)
const karyaDocsList = formattedDocs.filter((d) => 
  d.group === 'karya' && 
  (d.peminatanId === null || d.peminatanId === userPeminatanId)
);

// Perhitungan progress kelengkapan berkas wajib
const mandatoryDocs = formattedDocs.filter((d) => 
  d.group === 'wajib' && 
  (d.peminatanId === null || d.peminatanId === userPeminatanId)
);
const totalMandatory = mandatoryDocs.length;
const currentMandatoryUploaded = mandatoryDocs.filter((d) => d.isUploaded).length;
const progressPercent = totalMandatory > 0 ? Math.min(100, Math.round((currentMandatoryUploaded / totalMandatory) * 100)) : 100;

let cleanWa = (settingData?.waNumber || '081234567890').replace(/\D/g, '');
if (cleanWa.startsWith('0')) cleanWa = '62' + cleanWa.slice(1);
else if (cleanWa.startsWith('8')) cleanWa = '62' + cleanWa;
const waHelpUrl = `https://wa.me/${cleanWa}?text=${encodeURIComponent('Halo Panitia OPREC PERISAI UMI, saya butuh bantuan pada upload berkas.')}`;
---

<MainLayout title="Pusat Unggah Berkas Pendaftaran - PERISAI UMI">
  <div class="max-w-7xl mx-auto w-full px-3 sm:px-6 lg:px-8 py-6 md:py-10" data-user-nim={userNim} data-chosen-peminatan={chosenPeminatan}>
    
    <!-- Top Header & Breadcrumb -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold mb-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
          </svg>
          Portal Berkas & Karya OPREC
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          Pusat Unggah Dokumen Pendaftaran
        </h1>
        <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-2xl">
          Lengkapi seluruh dokumen persyaratan administrasi, interaksi media sosial, serta penugasan karya sesuai pilihan peminatan Anda.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/user/dashboard"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-300 hover:text-white text-xs font-semibold transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Dashboard
        </a>
        <a
          href={waHelpUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-xs font-semibold transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
          Bantuan
        </a>
      </div>
    </div>

    <!-- Progress Indicator Banner -->
    <div class="mb-8 p-6 rounded-3xl bg-[#13131a] border border-amber-500/20 shadow-xl relative overflow-hidden">
      <div class="absolute -right-16 -top-16 w-48 h-48 bg-amber-500/5 blur-3xl rounded-full pointer-events-none"></div>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-amber-400 font-bold">Status Kelengkapan Berkas Wajib</span>
          <h2 class="text-lg font-bold text-white mt-0.5">
            {progressPercent === 100 && totalMandatory > 0 ? 'Semua Berkas Wajib Lengkap 🎉' : `${currentMandatoryUploaded} dari ${totalMandatory} Berkas Wajib Dilengkapi`}
          </h2>
        </div>
        <div class="text-right">
          <span class="text-2xl font-black text-amber-400 font-mono">{progressPercent}%</span>
        </div>
      </div>
      <div class="w-full bg-white/5 rounded-full h-2.5 overflow-hidden p-0.5 border border-white/5">
        <div 
          id="global-progress-bar"
          class="h-full bg-gradient-to-r from-amber-500 to-amber-300 rounded-full transition-all duration-500" 
          style={`width: ${progressPercent}%`}
        ></div>
      </div>
    </div>

    {dbError && (
      <div class="mb-8 p-4 rounded-2xl bg-rose-950/50 border border-rose-800/50 text-rose-300 text-sm flex items-center gap-3">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{dbError}</span>
      </div>
    )}

    <!-- TAB NAVIGATION BUTTONS -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-3 border-b border-white/10 pb-4 mb-8">
      <button
        id="tab-btn-admin"
        type="button"
        class="tab-btn active flex items-center gap-2.5 px-5 py-3 rounded-2xl font-bold text-xs sm:text-sm transition-all duration-200 bg-amber-400 text-black shadow-lg shadow-amber-500/20 cursor-pointer"
        data-target="tab-section-admin"
      >
        <span class="tab-num w-5 h-5 rounded-full bg-black/20 text-black flex items-center justify-center text-xs font-black transition-colors">1</span>
        <span>Administrasi Utama</span>
        <span class="tab-pill ml-1 text-[10px] px-2 py-0.5 rounded-full bg-black/15 text-black font-mono transition-colors">{adminDocsList.length} Item</span>
      </button>

      <button
        id="tab-btn-media"
        type="button"
        class="tab-btn flex items-center gap-2.5 px-5 py-3 rounded-2xl font-bold text-xs sm:text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200 cursor-pointer"
        data-target="tab-section-media"
      >
        <span class="tab-num w-5 h-5 rounded-full bg-gray-800 text-gray-200 border border-white/10 flex items-center justify-center text-xs font-black transition-colors">2</span>
        <span>Media Sosial & Opsional</span>
        <span class="tab-pill ml-1 text-[10px] px-2 py-0.5 rounded-full bg-white/10 text-gray-400 font-mono transition-colors">{mediaDocsList.length} Item</span>
      </button>

      <button
        id="tab-btn-karya"
        type="button"
        class="tab-btn flex items-center gap-2.5 px-5 py-3 rounded-2xl font-bold text-xs sm:text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200 relative cursor-pointer"
        data-target="tab-section-karya"
      >
        <span class="tab-num w-5 h-5 rounded-full bg-gray-800 text-gray-200 border border-white/10 flex items-center justify-center text-xs font-black transition-colors">3</span>
        <span>Karya Peminatan</span>
        <span class="tab-pill ml-1 text-[10px] px-2 py-0.5 rounded-full bg-white/10 text-gray-400 font-mono transition-colors">{karyaDocsList.length > 0 ? `${karyaDocsList.length} Tugas` : 'Dinamis'}</span>
      </button>
    </div>

    <!-- ============================================================ -->
    <!-- TAB 1: ADMINISTRASI UTAMA -->
    <!-- ============================================================ -->
    <div id="tab-section-admin" class="tab-content block space-y-6">
      <div class="bg-[#121217] border border-white/10 rounded-3xl p-6 sm:p-8">
        <div class="mb-6">
          <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
            <span class="text-amber-400">1.</span> Dokumen Administrasi Utama
          </h2>
          <p class="text-xs sm:text-sm text-gray-400 mt-1">
            Persyaratan berkas identitas akademik dan profil pribadi yang wajib dilengkapi setiap calon anggota.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {adminDocsList.length === 0 ? (
            <div class="col-span-2 py-8 text-center text-gray-500 text-xs font-mono">
              Tidak ada persyaratan administrasi utama yang aktif saat ini.
            </div>
          ) : (
            adminDocsList.map((doc) => (
              <div 
                id={`card-${doc.id}`} 
                class={`p-6 rounded-2xl border transition-all flex flex-col justify-between ${
                  doc.isUploaded ? 'bg-[#121c15]/60 border-emerald-500/30' : 'bg-[#161620] border-white/10 hover:border-amber-500/30'
                }`}
              >
                <div>
                  <div class="flex items-start justify-between gap-3 mb-3">
                    <div>
                      <div class="flex items-center gap-2">
                        <h3 class="font-bold text-sm sm:text-base text-white">{doc.label}</h3>
                        {doc.inputType === 'link' && (
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/30 text-[10px] font-mono">
                            <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                            Tautan
                          </span>
                        )}
                      </div>
                      <p class="text-xs text-gray-400 mt-0.5">{doc.desc}</p>
                    </div>
                    <div id={`badge-${doc.id}`}>
                      {doc.isUploaded ? (
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                          Terunggah
                        </span>
                      ) : doc.isRequired ? (
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-400/10 text-amber-400 border border-amber-400/20">
                          Wajib
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-white/5 text-gray-400 border border-white/10">
                          Opsional
                        </span>
                      )}
                    </div>
                  </div>

                  <!-- Progress box for file uploads -->
                  {doc.inputType === 'file' && (
                    <div id={`progress-box-${doc.id}`} class="hidden mb-3 p-3 rounded-xl bg-black/40 border border-amber-500/20">
                      <div class="flex justify-between text-xs font-mono text-amber-300 mb-1">
                        <span id={`progress-status-${doc.id}`}>Mengunggah...</span>
                        <span id={`progress-percent-${doc.id}`}>0%</span>
                      </div>
                      <div class="w-full bg-white/10 h-1.5 rounded-full overflow-hidden">
                        <div id={`progress-bar-${doc.id}`} class="h-full bg-amber-400 transition-all duration-200" style="width: 0%"></div>
                      </div>
                    </div>
                  )}

                  <!-- Error message -->
                  <div id={`error-${doc.id}`} class="hidden mb-3 p-2.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs"></div>

                  <!-- Current file/link preview -->
                  {doc.fileKey && (
                    <div id={`current-file-${doc.id}`} class="mb-4 text-xs font-mono text-gray-400 bg-black/20 p-2.5 rounded-xl border border-white/5 break-all">
                      {doc.inputType === 'link' || doc.fileKey.startsWith('http') ? (
                        <span>Tautan aktif: <a href={doc.fileKey} target="_blank" rel="noopener noreferrer" class="text-amber-400 underline">{doc.fileKey}</a></span>
                      ) : (
                        <span>Berkas aktif: <span class="text-emerald-400">{doc.fileKey}</span></span>
                      )}
                    </div>
                  )}
                </div>

                <div class="pt-4 border-t border-white/5">
                  {doc.inputType === 'file' ? (
                    <div class="flex items-center justify-between gap-3">
                      <span class="text-[11px] font-mono text-gray-500">{doc.typeHint}</span>
                      <div class="flex items-center gap-2">
                        <input
                          type="file"
                          id={`input-${doc.id}`}
                          class="file-input-trigger hidden"
                          data-category={doc.slug}
                          data-label={doc.label}
                          data-max-mb={doc.maxSizeMB}
                          accept={doc.acceptMime}
                        />
                        <button
                          type="button"
                          class="btn-select-file px-4 py-2 rounded-xl text-xs font-bold transition-all bg-amber-400 hover:bg-amber-300 text-black shadow-md shadow-amber-500/15 flex items-center gap-1.5 cursor-pointer disabled:opacity-50"
                          data-target={`input-${doc.id}`}
                        >
