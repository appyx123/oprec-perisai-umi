---
import MainLayout from '../../layouts/MainLayout.astro';
import type { AuthUser } from '../../lib/auth';
import { createDb } from '../../db';
import { cagens, berkasCagens } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { FAKULTAS_PRODI_MAP, ANGKATAN_OPTIONS, PEMINATAN_OPTIONS } from '../../lib/constants/academic';

const user = Astro.locals.user as AuthUser | null | undefined;
if (!user || user.role !== 'user') {
  return Astro.redirect('/auth/login');
}

let cagenData: any = null;
let dbError: string | null = null;

try {
  const db = createDb();
  const [cagenRow] = await db
    .select({
      id: cagens.id,
      email: cagens.email,
      namaLengkap: cagens.namaLengkap,
      namaPanggilan: cagens.namaPanggilan,
      nim: cagens.nim,
      noWa: cagens.noWa,
      fakultas: cagens.fakultas,
      jurusan: cagens.jurusan,
      angkatan: cagens.angkatan,
      peminatan: cagens.peminatan,
      nomorRegistrasi: cagens.nomorRegistrasi,
      statusPendaftaran: cagens.statusPendaftaran,
      isVerified: cagens.isVerified,
    })
    .from(cagens)
    .where(eq(cagens.id, user.id))
    .limit(1);

  if (cagenRow && !cagenRow.peminatan) {
    const [berkas] = await db
      .select({ peminatan: berkasCagens.peminatan })
      .from(berkasCagens)
      .where(eq(berkasCagens.cagenId, user.id))
      .limit(1);
    if (berkas?.peminatan) {
      cagenRow.peminatan = berkas.peminatan;
    }
  }

  cagenData = cagenRow || null;
} catch (err) {
  console.error('Error fetching settings profile data:', err);
  dbError = 'Gagal memuat profil akun. Silakan muat ulang halaman.';
}

const fakultasList = Object.keys(FAKULTAS_PRODI_MAP);
---

<MainLayout title="Pengaturan Profil & Keamanan - PERISAI UMI">
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Top Breadcrumb & Navigation -->
    <div class="flex items-center gap-2 text-xs font-medium text-gray-400 mb-6">
      <a href="/user/dashboard" class="hover:text-amber-400 flex items-center gap-1.5 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        Dashboard
      </a>
      <span>/</span>
      <span class="text-white font-semibold">Pengaturan Profil</span>
    </div>

    <!-- Header Banner Card -->
    <div class="bg-gradient-to-r from-[#171720] via-[#1a1a24] to-[#121217] border border-amber-400/20 rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden mb-8">
      <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-amber-500/10 rounded-full blur-[90px] pointer-events-none"></div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold mb-3">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Pengaturan Akun Peserta
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Pengaturan Profil & Keamanan
          </h1>
          <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-2xl">
            Perbarui data diri pendaftaran Anda atau kelola keamanan kata sandi akun secara terpisah dan aman.
          </p>
        </div>

        <div class="flex items-center gap-2.5">
          <a
            href="/user/dashboard"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-300 hover:text-white text-xs font-semibold transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Kembali
          </a>
        </div>
      </div>
    </div>

    {dbError && (
      <div class="mb-8 p-4 rounded-2xl bg-rose-950/50 border border-rose-800/50 text-rose-300 text-sm flex items-center gap-3">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{dbError}</span>
      </div>
    )}

    <!-- Navigation Tabs Switcher -->
    <div class="flex items-center gap-2 border-b border-white/10 pb-4 mb-8">
      <button
        id="tab-btn-profile"
        type="button"
        class="tab-button active flex items-center gap-2.5 px-5 py-2.5 rounded-xl font-bold text-sm transition-all duration-200 bg-amber-400 text-black shadow-md shadow-amber-500/20"
        data-target="section-profile"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        Data Diri
      </button>

      <button
        id="tab-btn-security"
        type="button"
        class="tab-button flex items-center gap-2.5 px-5 py-2.5 rounded-xl font-bold text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200"
        data-target="section-security"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        Keamanan
      </button>
    </div>

    <!-- ============================================================ -->
    <!-- SECTION 1: DATA DIRI (PERSONAL INFO) -->
    <!-- ============================================================ -->
    <div id="section-profile" class="tab-content block space-y-6">
      
      <!-- Notification Alerts for Profile -->
      <div
        id="profile-alert-success"
        class="hidden p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-sm flex items-start gap-3"
      >
        <svg class="w-5 h-5 flex-shrink-0 text-emerald-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span id="profile-success-msg">Data profil berhasil diperbarui!</span>
      </div>

      <div
        id="profile-alert-error"
        class="hidden p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm flex items-start gap-3"
      >
        <svg class="w-5 h-5 flex-shrink-0 text-rose-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span id="profile-error-msg">Terjadi kesalahan saat menyimpan profil.</span>
      </div>

      <form id="profile-form" class="space-y-6">
        <!-- Personal Info Card -->
        <div class="bg-[#121217] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl">
          <div class="flex items-center gap-3 pb-5 border-b border-white/10 mb-6">
            <div class="w-9 h-9 rounded-xl bg-amber-400/10 border border-amber-400/30 text-amber-400 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-base font-bold text-white tracking-tight">Identitas Diri</h2>
              <p class="text-xs text-gray-400">Informasi nama dan nomor kontak WhatsApp aktif Anda.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Nama Lengkap -->
            <div>
              <label for="namaLengkap" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
                Nama Lengkap *
              </label>
              <input
                type="text"
                id="namaLengkap"
                name="namaLengkap"
                required
                value={cagenData?.namaLengkap || user.name || ''}
                class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-amber-400 text-sm transition-colors"
              />
            </div>

            <!-- Nama Panggilan -->
            <div>
              <label for="namaPanggilan" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
                Nama Panggilan *
              </label>
              <input
                type="text"
                id="namaPanggilan"
                name="namaPanggilan"
                required
                value={cagenData?.namaPanggilan || ''}
                class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-amber-400 text-sm transition-colors"
              />
            </div>

            <!-- Nomor WhatsApp -->
            <div>
              <label for="noWa" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
                Nomor WhatsApp Aktif *
              </label>
              <div class="relative">
                <input
                  type="tel"
                  id="noWa"
                  name="noWa"
                  required
                  value={cagenData?.noWa || ''}
                  placeholder="08xxxxxxxxxx"
                  class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-amber-400 text-sm transition-colors"
                />
              </div>
              <p class="text-[11px] text-gray-500 mt-1">Digunakan untuk koordinasi dan undangan grup calon anggota.</p>
            </div>

            <!-- Email (Locked) -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider">
                  Alamat Email
                </label>
                <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-amber-400/80 bg-amber-400/10 px-2 py-0.5 rounded-md border border-amber-400/20">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                  Terkunci
                </span>
              </div>
              <input
                type="email"
                disabled
                value={cagenData?.email || user.email || ''}
                class="w-full px-4 py-3 rounded-xl bg-white/[0.03] border border-white/5 text-gray-400 cursor-not-allowed text-sm select-none"
              />
              <p class="text-[11px] text-gray-500 mt-1">Identitas utama login sistem pendaftaran.</p>
            </div>
          </div>
        </div>

        <!-- Academic Info Card -->
        <div class="bg-[#121217] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl">
          <div class="flex items-center gap-3 pb-5 border-b border-white/10 mb-6">
            <div class="w-9 h-9 rounded-xl bg-amber-400/10 border border-amber-400/30 text-amber-400 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-base font-bold text-white tracking-tight">Data Akademik</h2>
              <p class="text-xs text-gray-400">Data perguruan tinggi dan program studi aktif Anda di UMI.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- NIM (Locked) -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider">
                  Nomor Induk Mahasiswa (NIM)
                </label>
                <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-amber-400/80 bg-amber-400/10 px-2 py-0.5 rounded-md border border-amber-400/20">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                  Terkunci
                </span>
              </div>
              <input
                type="text"
                disabled
                value={cagenData?.nim || user.nim || ''}
                class="w-full px-4 py-3 rounded-xl bg-white/[0.03] border border-white/5 text-gray-400 cursor-not-allowed text-sm select-none font-mono"
              />
              <p class="text-[11px] text-gray-500 mt-1">NIM terikat permanen dengan berkas KTM Anda.</p>
            </div>

            <!-- Angkatan -->
            <div>
              <label for="angkatan" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
                Tahun Angkatan *
              </label>
              <select
                id="angkatan"
                name="angkatan"
                required
                class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white focus:outline-none focus:border-amber-400 text-sm transition-colors cursor-pointer"
              >
                {ANGKATAN_OPTIONS.map((thn) => (
                  <option
                    value={thn}
                    selected={cagenData?.angkatan === thn}
                    class="bg-[#1c1c24] text-white"
                  >
                    {thn}
                  </option>
                ))}
              </select>
            </div>

            <!-- Fakultas -->
            <div>
              <label for="fakultas" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
                Fakultas *
              </label>
              <select
                id="fakultas"
                name="fakultas"
                required
                class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white focus:outline-none focus:border-amber-400 text-sm transition-colors cursor-pointer"
              >
                {fakultasList.map((fak) => (
                  <option
                    value={fak}
                    selected={cagenData?.fakultas === fak}
                    class="bg-[#1c1c24] text-white"
                  >
                    {fak}
                  </option>
                ))}
              </select>
            </div>

            <!-- Program Studi -->
            <div>
              <label for="jurusan" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
                Program Studi *
              </label>
              <select
                id="jurusan"
                name="jurusan"
                required
                data-current={cagenData?.jurusan || ''}
                class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white focus:outline-none focus:border-amber-400 text-sm transition-colors cursor-pointer"
              >
                <!-- Populated via script -->
              </select>
            </div>
          </div>
        </div>

        <!-- Pilihan Bidang Peminatan Card -->
        <div class="bg-[#121217] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl">
          <div class="flex items-center gap-3 pb-5 border-b border-white/10 mb-6">
            <div class="w-9 h-9 rounded-xl bg-amber-400/10 border border-amber-400/30 text-amber-400 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-base font-bold text-white tracking-tight">Bidang Peminatan</h2>
              <p class="text-xs text-gray-400">Pilihan bidang peminatan yang Anda ikuti di UKM PERISAI UMI.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="peminatan" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
                Peminatan *
              </label>
              <select
                id="peminatan"
                name="peminatan"
                required
                class="w-full px-4 py-3 rounded-xl bg-[#1c1c24] border border-white/10 text-white focus:outline-none focus:border-amber-400 text-sm transition-colors cursor-pointer"
              >
                <option value="" disabled selected={!cagenData?.peminatan} class="bg-[#1c1c24] text-gray-400">
                  Pilih Bidang Peminatan
                </option>
                {PEMINATAN_OPTIONS.map((opt) => (
                  <option
                    value={opt}
                    selected={cagenData?.peminatan === opt}
                    class="bg-[#1c1c24] text-white"
                  >
                    {opt}
                  </option>
                ))}
              </select>
              <p class="text-[11px] text-gray-500 mt-2">
                Pilihan peminatan ini dapat Anda sesuaikan kapan saja dan akan disinkronkan dengan berkas seleksi Anda.
              </p>
            </div>
          </div>
        </div>

        <!-- Submit Button for Profile -->
        <div class="flex items-center justify-end gap-3 pt-2">
          <a
            href="/user/dashboard"
            class="px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white text-sm font-semibold border border-white/10 transition-colors"
          >
            Batal
          </a>
          <button
            type="submit"
            id="profile-submit-btn"
            class="px-8 py-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-sm shadow-lg shadow-amber-500/20 hover:shadow-amber-500/35 transition-all duration-200 flex items-center justify-center gap-2"
          >
            <span id="profile-btn-text">Simpan Perubahan</span>
            <svg
              id="profile-btn-spinner"
              class="hidden animate-spin h-4 w-4 text-black"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
          </button>
        </div>
      </form>
    </div>

    <!-- ============================================================ -->
    <!-- SECTION 2: KEAMANAN (SECURITY & PASSWORD RESET FLOW) -->
    <!-- ============================================================ -->
    <div id="section-security" class="tab-content hidden space-y-6">

      <!-- Alert for Password Reset Email -->
      <div
        id="reset-alert-success"
        class="hidden p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-sm flex items-start gap-3"
      >
        <svg class="w-5 h-5 flex-shrink-0 text-emerald-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        <span id="reset-success-msg">Tautan ganti kata sandi berhasil dikirim! Silakan periksa kotak masuk atau spam email Anda.</span>
      </div>

      <div
        id="reset-alert-error"
        class="hidden p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm flex items-start gap-3"
      >
        <svg class="w-5 h-5 flex-shrink-0 text-rose-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span id="reset-error-msg">Gagal mengirim tautan ganti kata sandi.</span>
      </div>

      <!-- Security Notice Card -->
      <div class="bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent border border-amber-400/20 rounded-3xl p-6 sm:p-8">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-2xl bg-amber-400/20 border border-amber-400/30 text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-white tracking-tight">Prosedur Keamanan Penggantian Kata Sandi</h3>
            <p class="text-xs sm:text-sm text-gray-300 mt-1.5 leading-relaxed">
              Demi keamanan akun calon anggota, kata sandi <strong class="text-amber-400">tidak dapat diubah langsung</strong> di halaman profil. Anda wajib melakukan verifikasi kepemilikan akun melalui tautan rahasia yang dikirimkan ke alamat email terdaftar Anda.
            </p>
          </div>
        </div>
      </div>

      <!-- Reset Action Card -->
      <div class="bg-[#121217] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-xl">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 pb-6 border-b border-white/10 mb-6">
          <div>
            <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Email Terverifikasi Akun</div>
            <div class="text-lg font-bold text-white flex items-center gap-2">
              <span>{cagenData?.email || user.email}</span>
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Terdaftar
              </span>
            </div>
            <p class="text-xs text-gray-400 mt-1">
              Tautan penggantian sandi akan dikirimkan ke alamat email di atas via Resend.
            </p>
          </div>

          <button
            type="button"
            id="btn-request-reset"
            class="w-full sm:w-auto px-6 py-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-sm shadow-md shadow-amber-500/20 hover:shadow-amber-500/35 transition-all duration-200 flex items-center justify-center gap-2 flex-shrink-0"
          >
            <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span id="reset-btn-text">Kirim Tautan Ganti Sandi</span>
            <svg
              id="reset-btn-spinner"
              class="hidden animate-spin h-4 w-4 text-black"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
          </button>
        </div>

        <div class="space-y-3 text-xs text-gray-400">
          <div class="flex items-center gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>Tautan reset berlaku selama <strong>1 jam</strong> sejak tombol ditekan.</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>Setelah membuka tautan di email, Anda dapat memasukkan kata sandi baru secara langsung.</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>Jika Anda tidak menerima email, periksa folder <strong>Spam / Junk</strong> Anda.</span>
          </div>
        </div>
      </div>
    </div>

  </div>

  <script>
    import { FAKULTAS_PRODI_MAP } from '../../lib/constants/academic';

    // Tab switching logic
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabContents = document.querySelectorAll('.tab-content');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        tabButtons.forEach((b) => {
          b.classList.remove('active', 'bg-amber-400', 'text-black', 'shadow-md', 'shadow-amber-500/20');
          b.classList.add('text-gray-400', 'hover:text-white', 'hover:bg-white/5');
        });

        btn.classList.add('active', 'bg-amber-400', 'text-black', 'shadow-md', 'shadow-amber-500/20');
        btn.classList.remove('text-gray-400', 'hover:text-white', 'hover:bg-white/5');

        tabContents.forEach((c) => {
          if (c.id === targetId) {
            c.classList.remove('hidden');
            c.classList.add('block');
          } else {
            c.classList.add('hidden');
            c.classList.remove('block');
          }
        });
      });
    });

    // Dependent Dropdown for Fakultas -> Jurusan
    const fakultasSelect = document.getElementById('fakultas') as HTMLSelectElement | null;
    const jurusanSelect = document.getElementById('jurusan') as HTMLSelectElement | null;

    function populateJurusan(selectedFakultas: string, preselectValue?: string) {
      if (!jurusanSelect) return;
      const prodis = FAKULTAS_PRODI_MAP[selectedFakultas] || [];
      jurusanSelect.innerHTML = '<option value="" disabled selected class="bg-[#1c1c24] text-gray-400">Pilih Program Studi</option>';

      prodis.forEach((prodi) => {
        const opt = document.createElement('option');
        opt.value = prodi;
        opt.textContent = prodi;
        opt.className = 'bg-[#1c1c24] text-white';
        if (preselectValue && preselectValue === prodi) {
          opt.selected = true;
        }
        jurusanSelect.appendChild(opt);
      });
    }

    if (fakultasSelect && jurusanSelect) {
      const initialFakultas = fakultasSelect.value;
      const initialJurusan = jurusanSelect.getAttribute('data-current') || '';
      populateJurusan(initialFakultas, initialJurusan);

      fakultasSelect.addEventListener('change', () => {
        populateJurusan(fakultasSelect.value, '');
      });
    }

    // PROFILE FORM SUBMISSION
    const profileForm = document.getElementById('profile-form') as HTMLFormElement | null;
    const profileSubmitBtn = document.getElementById('profile-submit-btn') as HTMLButtonElement | null;
    const profileBtnText = document.getElementById('profile-btn-text');
    const profileBtnSpinner = document.getElementById('profile-btn-spinner');
    const profileAlertSuccess = document.getElementById('profile-alert-success');
    const profileSuccessMsg = document.getElementById('profile-success-msg');
    const profileAlertError = document.getElementById('profile-alert-error');
    const profileErrorMsg = document.getElementById('profile-error-msg');

    if (profileForm) {
      profileForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Reset alerts
        if (profileAlertSuccess) profileAlertSuccess.classList.add('hidden');
        if (profileAlertError) profileAlertError.classList.add('hidden');

        const formData = new FormData(profileForm);
        const payload = {
          namaLengkap: formData.get('namaLengkap'),
          namaPanggilan: formData.get('namaPanggilan'),
          noWa: formData.get('noWa'),
          fakultas: formData.get('fakultas'),
          jurusan: formData.get('jurusan'),
          angkatan: formData.get('angkatan'),
          peminatan: formData.get('peminatan'),
        };

        if (profileSubmitBtn) profileSubmitBtn.disabled = true;
        if (profileBtnText) profileBtnText.textContent = 'Menyimpan...';
        if (profileBtnSpinner) profileBtnSpinner.classList.remove('hidden');

        try {
          const res = await fetch('/api/user/profile', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data: any = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.message || 'Gagal menyimpan perubahan profil.');
          }

          if (profileSuccessMsg) profileSuccessMsg.textContent = data.message || 'Data profil Anda berhasil diperbarui!';
          if (profileAlertSuccess) profileAlertSuccess.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (err: any) {
          if (profileErrorMsg) profileErrorMsg.textContent = err.message || 'Terjadi kesalahan saat menyimpan.';
          if (profileAlertError) profileAlertError.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } finally {
          if (profileSubmitBtn) profileSubmitBtn.disabled = false;
          if (profileBtnText) profileBtnText.textContent = 'Simpan Perubahan';
          if (profileBtnSpinner) profileBtnSpinner.classList.add('hidden');
        }
      });
    }

    // SECURITY: REQUEST PASSWORD RESET
    const btnRequestReset = document.getElementById('btn-request-reset') as HTMLButtonElement | null;
    const resetBtnText = document.getElementById('reset-btn-text');
    const resetBtnSpinner = document.getElementById('reset-btn-spinner');
    const resetAlertSuccess = document.getElementById('reset-alert-success');
    const resetSuccessMsg = document.getElementById('reset-success-msg');
    const resetAlertError = document.getElementById('reset-alert-error');
    const resetErrorMsg = document.getElementById('reset-error-msg');

    let cooldownTimer = 0;
    let timerInterval: any = null;

    if (btnRequestReset) {
      btnRequestReset.addEventListener('click', async () => {
        if (cooldownTimer > 0) return;

        if (resetAlertSuccess) resetAlertSuccess.classList.add('hidden');
        if (resetAlertError) resetAlertError.classList.add('hidden');

        btnRequestReset.disabled = true;
        if (resetBtnText) resetBtnText.textContent = 'Mengirim...';
        if (resetBtnSpinner) resetBtnSpinner.classList.remove('hidden');

        try {
          const res = await fetch('/api/auth/request-reset', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({}),
          });

          const data: any = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.message || 'Gagal mengirim email reset kata sandi.');
          }

          if (resetSuccessMsg) resetSuccessMsg.textContent = data.message || 'Tautan reset telah dikirim ke email Anda!';
          if (resetAlertSuccess) resetAlertSuccess.classList.remove('hidden');

          // Start 60s cooldown
          cooldownTimer = 60;
          if (resetBtnText) resetBtnText.textContent = `Kirim Ulang (${cooldownTimer}s)`;
          timerInterval = setInterval(() => {
            cooldownTimer--;
            if (cooldownTimer <= 0) {
              clearInterval(timerInterval);
              btnRequestReset.disabled = false;
              if (resetBtnText) resetBtnText.textContent = 'Kirim Tautan Ganti Sandi';
            } else {
              if (resetBtnText) resetBtnText.textContent = `Kirim Ulang (${cooldownTimer}s)`;
            }
          }, 1000);
        } catch (err: any) {
          if (resetErrorMsg) resetErrorMsg.textContent = err.message || 'Terjadi kesalahan sistem.';
          if (resetAlertError) resetAlertError.classList.remove('hidden');
          btnRequestReset.disabled = false;
          if (resetBtnText) resetBtnText.textContent = 'Kirim Tautan Ganti Sandi';
        } finally {
          if (resetBtnSpinner) resetBtnSpinner.classList.add('hidden');
        }
      });
    }
  </script>
</MainLayout>
