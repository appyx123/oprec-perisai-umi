---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import maskotImg from '../assets/img/maskot.webp';
import type { AuthUser } from '../lib/auth';
import { createDb } from '../db';
import { systemSettings, timelineEvents, publicQna, peminatan } from '../db/schema';
import { eq, asc } from 'drizzle-orm';

const user = Astro.locals.user as AuthUser | null | undefined;
const dashboardUrl = user?.role === 'admin' ? '/admin/dashboard' : '/user/dashboard';

let registrationConfig = {
  isOpen: false,
  start: null as string | null,
  end: null as string | null,
};

let timelineList: any[] = [];
let qnaPublishedList: any[] = [];
let peminatanList: any[] = [];
let kriteriaList: Array<{
  title: string;
  pill?: string;
  desc?: string;
  tag?: string;
}> = [];

try {
  const db = createDb();
  const [settings] = await db
    .select()
    .from(systemSettings)
    .where(eq(systemSettings.id, 1))
    .limit(1);

  if (settings) {
    registrationConfig = {
      isOpen: Boolean(settings.isRegistrationOpen),
      start: settings.registrationStart ? new Date(settings.registrationStart).toISOString() : null,
      end: settings.registrationEnd ? new Date(settings.registrationEnd).toISOString() : null,
    };

    // ponytail: Render kriteria umum dinamis dari database
    if (settings.kriteriaUmum && settings.kriteriaUmum.trim().length > 0) {
      try {
        const parsed = JSON.parse(settings.kriteriaUmum);
        if (Array.isArray(parsed)) {
          kriteriaList = parsed.map((item, idx) => {
            if (typeof item === 'string') {
              return {
                title: item,
                pill: `Kriteria 0${idx + 1}`,
                desc: 'Persyaratan kualifikasi resmi calon anggota UKM PERISAI UMI.',
                tag: 'Standar Penerimaan',
              };
            }
            return {
              title: item.title || item.nama || `Kriteria 0${idx + 1}`,
              pill: item.pill || item.sub || '',
              desc: item.desc || item.deskripsi || '',
              tag: item.tag || 'Kualifikasi',
            };
          });
        }
      } catch {
        const lines = settings.kriteriaUmum
          .split('\n')
          .map((l: string) => l.trim())
          .filter(Boolean);
        kriteriaList = lines.map((line: string, idx: number) => ({
          title: line,
          pill: `Kriteria 0${idx + 1}`,
          desc: 'Persyaratan kualifikasi resmi calon anggota UKM PERISAI UMI.',
          tag: 'Standar Penerimaan',
        }));
      }
    }
  }

  timelineList = await db
    .select()
    .from(timelineEvents)
    .orderBy(asc(timelineEvents.sequenceOrder), asc(timelineEvents.startDate));

  qnaPublishedList = await db
    .select()
    .from(publicQna)
    .where(eq(publicQna.isPublished, true))
    .orderBy(asc(publicQna.id));

  peminatanList = await db
    .select()
    .from(peminatan)
    .where(eq(peminatan.isActive, true))
    .orderBy(asc(peminatan.id));
} catch (err) {
  console.error('Error loading settings, timeline, QnA, or peminatan on homepage:', err);
}

// Fallback jika kriteria belum terisi di database
if (kriteriaList.length === 0) {
  kriteriaList = [
    {
      title: 'Mahasiswa Aktif UMI',
      pill: 'Angkatan 2024 atau 2025',
      desc: 'Terdaftar sebagai mahasiswa aktif Universitas Muslim Indonesia pada jenjang Sarjana (S1) maupun Diploma, dari seluruh program studi di lingkungan kampus UMI.',
      tag: 'Status Kampus',
    },
    {
      title: 'Akademik Cemerlang',
      pill: 'IPK Minimal 3.25',
      desc: 'Memiliki Indeks Prestasi Kumulatif (IPK) minimal 3.25 sebagai cerminan komitmen belajar, disiplin intelektual, serta kemampuan analisis yang matang.',
      tag: 'Standar Prestasi',
    },
    {
      title: 'Rekam Jejak Bersih',
      pill: 'Bebas Sanksi Akademik & Organisasi',
      desc: 'Bersih dari segala sanksi akademik institusi maupun catatan buruk organisasi, serta bersedia mematuhi nilai-nilai kejujuran ilmiah UKM PERISAI UMI.',
      tag: 'Etika & Integritas',
    },
  ];
}

// Fallback jika database belum memiliki data peminatan
if (peminatanList.length === 0) {
  peminatanList = [
    {
      id: 1,
      nama: 'KTI / Essay',
      deskripsi: 'Pengembangan kemampuan penulisan karya tulis ilmiah, esai kritis, serta perumusan gagasan solutif berbasis riset metodologis.',
      guidebookUrl: 'https://oprec.perisai.site/docs/guidebook-kti-essay.pdf',
    },
    {
      id: 2,
      nama: 'Business Plan',
      deskripsi: 'Penyusunan model bisnis inovatif, studi kelayakan pasar, perancangan proposal usaha rintisan berdaya saing tinggi.',
      guidebookUrl: 'https://oprec.perisai.site/docs/guidebook-business-plan.pdf',
    },
    {
      id: 3,
      nama: 'Debat',
      deskripsi: 'Asah ketajaman berpikir kritis, retorika argumentasi logis, dan penguasaan isu-isu strategis nasional maupun global.',
      guidebookUrl: 'https://oprec.perisai.site/docs/guidebook-debat.pdf',
    },
    {
      id: 4,
      nama: 'Poster',
      deskripsi: 'Visualisasi komunikasi data dan gagasan ilmiah ke dalam media grafis yang komunikatif, estetis, dan informatif.',
      guidebookUrl: 'https://oprec.perisai.site/docs/guidebook-poster.pdf',
    },
    {
      id: 5,
      nama: 'Video Graph',
      deskripsi: 'Eksplorasi sinematografi, storytelling visual, serta produksi video edukasi dan dokumenter berbobot ilmiah.',
      guidebookUrl: 'https://oprec.perisai.site/docs/guidebook-videograph.pdf',
    },
  ];
}


const now = new Date();

function formatWITA(date: Date | null | undefined): string {
  if (!date) return '-';
  const d = new Date(date);
  if (isNaN(d.getTime())) return '-';
  return d.toLocaleDateString('id-ID', {
    timeZone: 'Asia/Makassar',
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}

function formatTimelineDate(startDate: Date | null | undefined, endDate: Date | null | undefined): string {
  if (!startDate) return '-';
  const startStr = formatWITA(startDate);
  if (!endDate) {
    return startStr;
  }
  const endStr = formatWITA(endDate);
  if (startStr === endStr) {
    return startStr;
  }
  return `${startStr} - ${endStr}`;
}
---

<MainLayout title="Open Recruitment PERISAI UMI">
  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden py-16 lg:py-24">
    <!-- Ambient Background Glows -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-amber-500/15 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute top-1/3 -right-32 w-96 h-96 bg-yellow-600/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Text Column -->
        <div class="lg:col-span-7 text-center lg:text-left space-y-6">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            Open Recruitment Calon Anggota Baru
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
            PUSAT PENGEMBANGAN <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500">
              RISET MAHASISWA
            </span>
          </h1>

          <p class="text-base sm:text-lg text-gray-400 max-w-2xl leading-relaxed">
            Selamat datang di Portal Open Recruitment UKM PERISAI Universitas Muslim Indonesia. Wadah kolaborasi inovator muda dalam riset, penalaran, dan teknologi untuk mencetak generasi intelektual berprestasi.
          </p>

          <!-- Real-Time Countdown Card -->
          <div
            id="registration-countdown-root"
            data-open={String(registrationConfig.isOpen)}
            data-start={registrationConfig.start || ''}
            data-end={registrationConfig.end || ''}
            class="max-w-xl mx-auto lg:mx-0 p-5 rounded-2xl bg-[#131318]/90 border border-white/10 shadow-xl backdrop-blur-sm"
          >
            <div class="flex items-center gap-2 mb-3">
              <span id="countdown-status-indicator" class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
              <span id="countdown-label" class="text-xs font-bold uppercase tracking-wider text-amber-300">
                Memuat Status Pendaftaran...
              </span>
            </div>

            <!-- Timer Digits Grid -->
            <div id="countdown-timer-grid" class="grid grid-cols-4 gap-2 sm:gap-3">
              <div class="bg-[#1a1a24] border border-white/5 rounded-xl p-2.5 sm:p-3 text-center">
                <span id="timer-days" class="block text-2xl sm:text-3xl font-black text-white font-mono leading-none">00</span>
                <span class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wider font-semibold mt-1 block">Hari</span>
              </div>
              <div class="bg-[#1a1a24] border border-white/5 rounded-xl p-2.5 sm:p-3 text-center">
                <span id="timer-hours" class="block text-2xl sm:text-3xl font-black text-white font-mono leading-none">00</span>
                <span class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wider font-semibold mt-1 block">Jam</span>
              </div>
              <div class="bg-[#1a1a24] border border-white/5 rounded-xl p-2.5 sm:p-3 text-center">
                <span id="timer-mins" class="block text-2xl sm:text-3xl font-black text-white font-mono leading-none">00</span>
                <span class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wider font-semibold mt-1 block">Menit</span>
              </div>
              <div class="bg-[#1a1a24] border border-white/5 rounded-xl p-2.5 sm:p-3 text-center">
                <span id="timer-secs" class="block text-2xl sm:text-3xl font-black text-amber-400 font-mono leading-none">00</span>
                <span class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wider font-semibold mt-1 block">Detik</span>
              </div>
            </div>

            <!-- Closed Notice (Displayed when registration is closed) -->
            <div id="countdown-closed-notice" class="hidden text-center py-4 px-3 rounded-xl bg-rose-950/20 border border-rose-800/30">
              <p class="text-sm font-semibold text-rose-300">Pendaftaran Telah Ditutup</p>
              <p class="text-xs text-gray-400 mt-1">
                Akses pendaftaran calon anggota baru saat ini sedang tidak dibuka.
              </p>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
            {user ? (
              <a
                href={dashboardUrl}
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-base shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 transition-all duration-200"
              >
                Dashboard
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            ) : (
              <>
                <!-- Register Button (Dynamically toggled by countdown timer) -->
                <a
                  id="register-cta-btn"
                  href="/auth/register"
                  class="hidden w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-base shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 transition-all duration-200"
                >
                  Daftar Sekarang
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                  </svg>
                </a>

                <!-- Kenali Kami Link -->
                <a
                  href="https://youtu.be/LUKKRN1EK70"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white border border-white/10 text-base font-semibold transition-all duration-200"
                >
                  <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M10 16.5l6-4.5-6-4.5v9zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                  </svg>
                  Kenali Kami
                </a>
              </>
            )}
          </div>
        </div>

        <!-- Mascot / Visual Column -->
        <div class="lg:col-span-5 flex justify-center items-center relative">
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-tr from-amber-500/25 to-yellow-300/10 rounded-full blur-[80px] scale-90"></div>
            <Image
              src={maskotImg}
              alt="Maskot PERISAI UMI"
              width={840}
              height={1252}
              quality={95}
              format="webp"
              loading="eager"
              fetchpriority="high"
              class="relative z-10 w-full max-w-[340px] sm:max-w-[420px] h-auto drop-shadow-[0_20px_40px_rgba(0,0,0,0.8)]"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- KUALIFIKASI INOVATOR (DINAMIS DARI DATABASE) -->
  <!-- ============================================================ -->
  {kriteriaList.length > 0 && (
    <section id="kualifikasi" class="py-24 bg-[#0a0a0f] border-t border-white/5 relative overflow-hidden">
      <!-- Ambient Glow Effects -->
      <div class="absolute top-0 right-1/4 w-96 h-96 bg-amber-500/5 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-emerald-500/5 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-3">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
            Standar Penerimaan Calon Anggota
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">
            Kualifikasi <span class="bg-clip-text text-transparent bg-gradient-to-r from-amber-400 to-amber-200">Inovator</span>
          </h2>
          <p class="text-xs sm:text-sm text-gray-400 mt-3 leading-relaxed max-w-2xl mx-auto">
            Pastikan Anda memenuhi kriteria fundamental resmi dari Buku Panduan OPREC PERISAI UMI sebelum melangkah ke tahap pendaftaran.
          </p>
        </div>

        <!-- Dynamic Criteria Grid Cards -->
        <div class={`grid grid-cols-1 ${kriteriaList.length === 2 ? 'md:grid-cols-2 max-w-4xl mx-auto' : kriteriaList.length === 1 ? 'max-w-xl mx-auto' : 'md:grid-cols-3'} gap-6 lg:gap-8`}>
          {kriteriaList.map((item, idx) => (
            <div class="group relative p-8 rounded-3xl bg-[#121218] hover:bg-[#161622] border border-white/10 hover:border-amber-400/40 transition-all duration-300 shadow-xl hover:shadow-amber-500/10 flex flex-col justify-between">
              <div class="absolute -top-3 right-6 px-3 py-1 rounded-full bg-amber-400 text-black text-[10px] font-black uppercase tracking-wider shadow-md shadow-amber-500/20">
                {item.pill && item.pill.toLowerCase().startsWith('kriteria') ? item.pill : `Kriteria 0${idx + 1}`}
              </div>
              <div>
                <div class="w-14 h-14 rounded-2xl bg-amber-400/10 border border-amber-400/30 flex items-center justify-center text-amber-400 mb-6 group-hover:scale-110 transition-transform duration-300">
                  {idx === 0 && (
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
                    </svg>
                  )}
                  {idx === 1 && (
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                  )}
                  {idx >= 2 && (
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                  )}
                </div>

                <span class="text-xs font-mono font-semibold text-amber-400 uppercase tracking-wider block mb-1">
                  {item.tag || 'Status Syarat'}
                </span>
                <h3 class="text-xl font-bold text-white mb-2 group-hover:text-amber-300 transition-colors">
                  {item.title}
                </h3>
                
                {item.pill && (
                  <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white/5 border border-white/10 text-amber-300 text-xs font-bold font-mono mb-4">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    {item.pill}
                  </div>
                )}

                {item.desc && (
                  <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
                    {item.desc}
                  </p>
                )}
              </div>

              <div class="pt-6 mt-6 border-t border-white/5 flex items-center gap-2 text-xs text-gray-400">
                <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Standar Mutu & Integritas UMI</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Interactive Callout Banner -->
        <div class="mt-12 p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-amber-500/10 via-[#181822] to-amber-500/5 border border-amber-500/20 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div>
            <h4 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
              <span>Memenuhi seluruh kualifikasi di atas?</span>
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            </h4>
            <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-xl">
              Jangan tunda lagi. Mulai langkah Anda menjadi bagian dari ekosistem riset, penalaran, dan kepemimpinan ilmiah terbaik di Universitas Muslim Indonesia.
            </p>
          </div>
          <a
            href="/auth/register"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-xs sm:text-sm shadow-lg shadow-amber-500/20 hover:shadow-amber-500/35 transition-all duration-200 whitespace-nowrap"
          >
            <span>Daftar Sekarang</span>
            <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>

      </div>
    </section>
  )}

  <!-- Pilihan Peminatan Section -->
  <section id="peminatan" class="py-20 bg-[#0f0f14] border-y border-white/5 relative overflow-hidden">
    <!-- Ambient Lighting Glows -->
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-amber-500/5 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-yellow-600/5 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          Pilihan Peminatan
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          Eksplorasi Bidang Peminatan & Guidebook
        </h2>
        <p class="text-sm sm:text-base text-gray-400 mt-2.5 leading-relaxed">
          Pilih bidang peminatan sesuai minat dan keahlian Anda. Pelajari panduan dan ketentuan karya melalui Guidebook resmi di bawah ini sebelum mendaftar.
        </p>
