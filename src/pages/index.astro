---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import maskotImg from '../assets/img/maskot.webp';
import type { AuthUser } from '../lib/auth';
import { createDb } from '../db';
import { systemSettings, timelineEvents, publicQna } from '../db/schema';
import { eq, asc } from 'drizzle-orm';

const user = Astro.locals.user as AuthUser | null | undefined;
const dashboardUrl = user?.role === 'admin' ? '/admin/dashboard' : '/user/dashboard';

let registrationConfig = {
  isOpen: false,
  start: null as string | null,
  end: null as string | null,
};

let timelineList: any[] = [];
let qnaPublishedList: any[] = [];

try {
  const db = createDb();
  const [settings] = await db
    .select()
    .from(systemSettings)
    .where(eq(systemSettings.id, 1))
    .limit(1);

  if (settings) {
    registrationConfig = {
      isOpen: Boolean(settings.isRegistrationOpen),
      start: settings.registrationStart ? new Date(settings.registrationStart).toISOString() : null,
      end: settings.registrationEnd ? new Date(settings.registrationEnd).toISOString() : null,
    };
  }

  timelineList = await db
    .select()
    .from(timelineEvents)
    .orderBy(asc(timelineEvents.sequenceOrder), asc(timelineEvents.startDate));

  qnaPublishedList = await db
    .select()
    .from(publicQna)
    .where(eq(publicQna.isPublished, true))
    .orderBy(asc(publicQna.id));
} catch (err) {
  console.error('Error loading settings, timeline, or QnA on homepage:', err);
}


const now = new Date();

function formatWITA(date: Date | null | undefined): string {
  if (!date) return '-';
  const d = new Date(date);
  if (isNaN(d.getTime())) return '-';
  return d.toLocaleDateString('id-ID', {
    timeZone: 'Asia/Makassar',
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}

function formatTimelineDate(startDate: Date | null | undefined, endDate: Date | null | undefined): string {
  if (!startDate) return '-';
  const startStr = formatWITA(startDate);
  if (!endDate) {
    return startStr;
  }
  const endStr = formatWITA(endDate);
  if (startStr === endStr) {
    return startStr;
  }
  return `${startStr} - ${endStr}`;
}
---

<MainLayout title="Open Recruitment PERISAI UMI">
  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden py-16 lg:py-24">
    <!-- Ambient Background Glows -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-amber-500/15 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute top-1/3 -right-32 w-96 h-96 bg-yellow-600/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Text Column -->
        <div class="lg:col-span-7 text-center lg:text-left space-y-6">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            Open Recruitment Calon Anggota Baru
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
            PUSAT PENGEMBANGAN <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500">
              RISET MAHASISWA
            </span>
          </h1>

          <p class="text-base sm:text-lg text-gray-400 max-w-2xl leading-relaxed">
            Selamat datang di Portal Open Recruitment UKM PERISAI Universitas Muslim Indonesia. Wadah kolaborasi inovator muda dalam riset, penalaran, dan teknologi untuk mencetak generasi intelektual berprestasi.
          </p>

          <!-- Real-Time Countdown Card -->
          <div
            id="registration-countdown-root"
            data-open={String(registrationConfig.isOpen)}
            data-start={registrationConfig.start || ''}
            data-end={registrationConfig.end || ''}
            class="max-w-xl mx-auto lg:mx-0 p-5 rounded-2xl bg-[#131318]/90 border border-white/10 shadow-xl backdrop-blur-sm"
          >
            <div class="flex items-center gap-2 mb-3">
              <span id="countdown-status-indicator" class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
              <span id="countdown-label" class="text-xs font-bold uppercase tracking-wider text-amber-300">
                Memuat Status Pendaftaran...
              </span>
            </div>

            <!-- Timer Digits Grid -->
            <div id="countdown-timer-grid" class="grid grid-cols-4 gap-2 sm:gap-3">
              <div class="bg-[#1a1a24] border border-white/5 rounded-xl p-2.5 sm:p-3 text-center">
                <span id="timer-days" class="block text-2xl sm:text-3xl font-black text-white font-mono leading-none">00</span>
                <span class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wider font-semibold mt-1 block">Hari</span>
              </div>
              <div class="bg-[#1a1a24] border border-white/5 rounded-xl p-2.5 sm:p-3 text-center">
                <span id="timer-hours" class="block text-2xl sm:text-3xl font-black text-white font-mono leading-none">00</span>
                <span class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wider font-semibold mt-1 block">Jam</span>
              </div>
              <div class="bg-[#1a1a24] border border-white/5 rounded-xl p-2.5 sm:p-3 text-center">
                <span id="timer-mins" class="block text-2xl sm:text-3xl font-black text-white font-mono leading-none">00</span>
                <span class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wider font-semibold mt-1 block">Menit</span>
              </div>
              <div class="bg-[#1a1a24] border border-white/5 rounded-xl p-2.5 sm:p-3 text-center">
                <span id="timer-secs" class="block text-2xl sm:text-3xl font-black text-amber-400 font-mono leading-none">00</span>
                <span class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wider font-semibold mt-1 block">Detik</span>
              </div>
            </div>

            <!-- Closed Notice (Displayed when registration is closed) -->
            <div id="countdown-closed-notice" class="hidden text-center py-4 px-3 rounded-xl bg-rose-950/20 border border-rose-800/30">
              <p class="text-sm font-semibold text-rose-300">Pendaftaran Telah Ditutup</p>
              <p class="text-xs text-gray-400 mt-1">
                Akses pendaftaran calon anggota baru saat ini sedang tidak dibuka.
              </p>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
            {user ? (
              <a
                href={dashboardUrl}
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-base shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 transition-all duration-200"
              >
                Dashboard
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            ) : (
              <>
                <!-- Register Button (Dynamically toggled by countdown timer) -->
                <a
                  id="register-cta-btn"
                  href="/auth/register"
                  class="hidden w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-base shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 transition-all duration-200"
                >
                  Daftar Sekarang
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                  </svg>
                </a>

                <!-- Kenali Kami Link -->
                <a
                  href="https://youtu.be/LUKKRN1EK70"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white border border-white/10 text-base font-semibold transition-all duration-200"
                >
                  <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M10 16.5l6-4.5-6-4.5v9zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                  </svg>
                  Kenali Kami
                </a>
              </>
            )}
          </div>
        </div>

        <!-- Mascot / Visual Column -->
        <div class="lg:col-span-5 flex justify-center items-center relative">
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-tr from-amber-500/25 to-yellow-300/10 rounded-full blur-[80px] scale-90"></div>
            <Image
              src={maskotImg}
              alt="Maskot PERISAI UMI"
              width={840}
              height={1252}
              quality={95}
              format="webp"
              loading="eager"
              fetchpriority="high"
              class="relative z-10 w-full max-w-[340px] sm:max-w-[420px] h-auto drop-shadow-[0_20px_40px_rgba(0,0,0,0.8)]"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Peminatan Bidang Section -->
  <section class="py-16 bg-[#0f0f13] border-y border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-xs uppercase tracking-widest text-amber-400 font-bold mb-2">5 Bidang Peminatan</h2>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white">Temukan Potensi Terbaikmu</h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {[
          { title: 'KTI / Essay', desc: 'Karya tulis ilmiah & gagasan solutif untuk isu terkini' },
          { title: 'Business Plan', desc: 'Inovasi kewirausahaan & rencana bisnis berdaya saing' },
          { title: 'Debat', desc: 'Ketajaman argumentasi, logika kritis, dan wawasan global' },
          { title: 'Poster', desc: 'Visualisasi pesan ilmiah yang informatif dan estetik' },
          { title: 'Video Graph', desc: 'Kreativitas videografi & media edukasi berdampak luas' },
        ].map((item) => (
          <div class="bg-[#15151b] border border-white/5 hover:border-amber-400/40 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-amber-500/5">
            <div class="w-10 h-10 rounded-xl bg-amber-400/10 border border-amber-400/20 flex items-center justify-center text-amber-400 font-bold mb-4">
              ★
            </div>
            <h4 class="font-bold text-lg text-white mb-2">{item.title}</h4>
            <p class="text-xs text-gray-400 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Linimasa / Recruitment Timeline Section -->
  <section class="py-20 bg-[#0a0a0d] relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-amber-500/5 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          Jadwal Seleksi Resmi
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          Linimasa Open Recruitment
        </h2>
        <p class="text-sm text-gray-400 mt-2 leading-relaxed">
          Catat setiap tahapan seleksi penting agar Anda tidak melewatkan kesempatan berharga ini.
        </p>
      </div>

      <!-- Vertical Timeline Component -->
      {timelineList.length === 0 ? (
        <div class="text-center py-10 text-gray-500 text-sm">
          Jadwal tahapan seleksi akan segera diperbarui oleh panitia.
        </div>
      ) : (
        <div class="relative pl-6 sm:pl-10 space-y-8 before:absolute before:left-3 sm:before:left-5 before:top-3 before:bottom-3 before:w-0.5 before:bg-gradient-to-b before:from-amber-400 before:via-amber-400/30 before:to-white/10">
          {timelineList.map((item, idx) => {
            const startMs = new Date(item.startDate).getTime();
            const endMs = item.endDate ? new Date(item.endDate).getTime() : startMs + (24 * 60 * 60 * 1000);
            const nowMs = now.getTime();

            const isPast = nowMs > endMs;
            const isFuture = startMs > nowMs;
            const isCurrent = !isPast && !isFuture;

            return (
              <div class="relative group">
                <!-- Timeline Node Pin / Dot -->
                <div class={`absolute -left-[31px] sm:-left-[47px] top-1.5 w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center font-bold text-xs transition-all ${
                  isCurrent
                    ? 'bg-amber-400 text-black ring-4 ring-amber-400/30 shadow-lg shadow-amber-500/50 scale-110 z-10'
                    : isPast
                    ? 'bg-emerald-500 text-black ring-4 ring-emerald-500/20'
                    : 'bg-[#1a1a24] border-2 border-white/20 text-gray-400'
                }`}>
                  {isPast ? (
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                    </svg>
                  ) : isCurrent ? (
                    <span class="w-2.5 h-2.5 rounded-full bg-black animate-ping"></span>
                  ) : (
                    <span>{idx + 1}</span>
                  )}
                </div>

                <!-- Event Content Card -->
                <div class={`p-6 rounded-2xl border transition-all duration-300 ${
                  isCurrent
                    ? 'bg-gradient-to-r from-[#1b1810] via-[#1c1913] to-[#14141c] border-amber-400/60 shadow-xl shadow-amber-500/10 -translate-y-0.5'
                    : isPast
                    ? 'bg-[#121217]/80 border-emerald-500/20 opacity-90'
                    : 'bg-[#121217]/50 border-white/5 hover:border-white/10'
                }`}>
                  
                  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2 mb-2">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class={`text-[11px] font-mono font-bold tracking-wider uppercase ${
                        isCurrent ? 'text-amber-400' : isPast ? 'text-emerald-400' : 'text-gray-500'
                      }`}>
                        Tahap {item.sequenceOrder || idx + 1}
                      </span>

                      <!-- Status Pill -->
                      {isCurrent && (
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-400/20 text-amber-300 border border-amber-400/40 animate-pulse">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                          Sedang Berlangsung
                        </span>
                      )}
                      {isPast && (
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                          Selesai
                        </span>
                      )}
                      {isFuture && (
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-white/5 text-gray-400 border border-white/5">
                          Mendatang
                        </span>
                      )}
                    </div>

                    <!-- Date Badge in WITA (Single date or Range) -->
                    <div class="text-xs font-mono text-gray-300 bg-black/40 px-3 py-1 rounded-lg border border-white/5 w-fit">
                      {formatTimelineDate(item.startDate, item.endDate)}
                    </div>
                  </div>

                  <h3 class={`text-lg sm:text-xl font-bold tracking-tight mb-2 ${
                    isCurrent ? 'text-white' : isPast ? 'text-gray-200' : 'text-gray-300'
                  }`}>
                    {item.title}
                  </h3>

                  {item.description && (
                    <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
                      {item.description}
                    </p>
                  )}
                </div>

              </div>
            );
          })}
        </div>
      )}

    </div>
  </section>

  <!-- Public Q&A / FAQ Section -->
  <section class="py-20 bg-[#0c0c10] border-t border-white/5 relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          Tanya Jawab Resmi
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          Pertanyaan Seputar OPREC
        </h2>
        <p class="text-sm text-gray-400 mt-2 leading-relaxed">
          Temukan jawaban atas pertanyaan umum terkait pendaftaran, peminatan, dan alur seleksi UKM PERISAI UMI.
        </p>
      </div>

      <!-- Published Q&A Accordion List -->
      <div class="space-y-4 mb-14">
        {qnaPublishedList.length === 0 ? (
          <div class="text-center py-10 text-gray-500 text-sm bg-[#121217] rounded-2xl border border-white/5 p-6">
            Belum ada pertanyaan yang dipublikasikan. Ajukan pertanyaan pertama Anda di bawah ini!
          </div>
        ) : (
          qnaPublishedList.map((qna, idx) => (
            <div class="bg-[#13131a] border border-white/5 hover:border-amber-400/30 rounded-2xl overflow-hidden transition-all">
              <button
                type="button"
                class="qna-toggle-btn w-full p-5 sm:p-6 text-left flex items-start justify-between gap-4 cursor-pointer focus:outline-none"
                data-target={`qna-answer-${qna.id}`}
                aria-expanded={idx === 0 ? "true" : "false"}
              >
                <div class="flex items-start gap-3">
                  <span class="w-6 h-6 rounded-lg bg-amber-400/10 text-amber-400 font-bold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">
                    Q
                  </span>
                  <span class="font-bold text-base text-white leading-snug">
                    {qna.question}
                  </span>
                </div>
                <div class="w-6 h-6 rounded-full bg-white/5 flex items-center justify-center flex-shrink-0 text-gray-400 mt-0.5 transition-transform duration-200">
                  <svg class="qna-chevron w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
              </button>

              <div
                id={`qna-answer-${qna.id}`}
                class={`qna-answer-body px-5 sm:px-6 pb-6 pt-0 ${idx === 0 ? '' : 'hidden'}`}
              >
                <div class="p-4 rounded-xl bg-[#1a1a24] border border-white/5 text-sm text-gray-300 leading-relaxed flex items-start gap-3">
                  <span class="w-6 h-6 rounded-lg bg-emerald-500/15 text-emerald-400 font-bold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">
                    A
                  </span>
                  <div>
                    <p>{qna.answer}</p>
                    <div class="flex items-center gap-2 mt-3 pt-2 border-t border-white/5 text-[11px] text-gray-500">
                      <span>Jawaban Resmi Panitia OPREC</span>
                      {qna.askerName && (
                        <>
                          <span>&bull;</span>
                          <span>Ditanyakan oleh: {qna.askerName}</span>
                        </>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        )}
      </div>

      <!-- Public Question Submission Form -->
      <div class="bg-gradient-to-r from-[#171722] via-[#1a1a26] to-[#14141d] border border-amber-400/20 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
        <div class="absolute -right-12 -bottom-12 w-48 h-48 bg-amber-500/10 rounded-full blur-[80px] pointer-events-none"></div>

        <div class="max-w-2xl relative z-10">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-400/10 text-amber-300 text-xs font-semibold mb-2">
            Belum Menemukan Jawaban?
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            Punya Pertanyaan Lain?
          </h3>
          <p class="text-xs sm:text-sm text-gray-400 mt-1 mb-6">
            Kirimkan pertanyaan Anda mengenai Open Recruitment PERISAI UMI. Panitia akan meninjau dan menjawab pertanyaan Anda.
          </p>

          <form id="public-qna-form" class="space-y-4">
            <div id="qna-form-alert" class="hidden p-4 rounded-xl text-xs"></div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="sm:col-span-1">
                <label for="qna-asker-name" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
                  Nama Anda
                </label>
                <input
                  type="text"
                  id="qna-asker-name"
                  name="askerName"
                  placeholder="Nama / Panggilan"
                  class="w-full px-4 py-2.5 rounded-xl bg-[#13131c] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-amber-400 text-xs"
                />
              </div>

              <div class="sm:col-span-2">
                <label for="qna-question" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">
                  Pertanyaan Anda *
                </label>
                <input
                  type="text"
                  id="qna-question"
                  name="question"
                  required
                  placeholder="Tuliskan pertanyaan seputar OPREC..."
                  class="w-full px-4 py-2.5 rounded-xl bg-[#13131c] border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-amber-400 text-xs"
                />
              </div>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2">
              <span class="text-[11px] text-gray-500">
                Pertanyaan akan ditinjau oleh panitia sebelum dipublikasikan.
              </span>

              <button
                type="submit"
                id="qna-submit-btn"
                class="px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-xs shadow-md shadow-amber-500/20 hover:shadow-amber-500/35 transition-all flex items-center justify-center gap-2 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <span id="qna-submit-text">Kirim Pertanyaan</span>
                <svg id="qna-submit-spinner" class="hidden w-3.5 h-3.5 animate-spin text-black" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
            </div>
          </form>
        </div>


      </div>

    </div>
  </section>

  <!-- Real-time Countdown Client Script -->
  <script>
    function initCountdown() {
      const root = document.getElementById('registration-countdown-root');
      if (!root) return;

      const isOpen = root.getAttribute('data-open') === 'true';
      const startStr = root.getAttribute('data-start') || '';
      const endStr = root.getAttribute('data-end') || '';

      const startDate = startStr ? new Date(startStr) : null;
      const endDate = endStr ? new Date(endStr) : null;

      const startTime = startDate && !isNaN(startDate.getTime()) ? startDate.getTime() : null;
      const endTime = endDate && !isNaN(endDate.getTime()) ? endDate.getTime() : null;

      const labelEl = document.getElementById('countdown-label');
      const indicatorEl = document.getElementById('countdown-status-indicator');
      const timerGrid = document.getElementById('countdown-timer-grid');
      const closedNotice = document.getElementById('countdown-closed-notice');
      const registerBtn = document.getElementById('register-cta-btn');

      const daysEl = document.getElementById('timer-days');
      const hoursEl = document.getElementById('timer-hours');
      const minsEl = document.getElementById('timer-mins');
      const secsEl = document.getElementById('timer-secs');

      function pad(num: number): string {
        return String(num).padStart(2, '0');
      }

      function update() {
        const now = Date.now();

        // Status A: Ditutup secara manual
        if (!isOpen) {
          setClosed('Pendaftaran Telah Ditutup');
          return;
        }

        // Status B: Belum dimulai (Time < Start)
        if (startTime && now < startTime) {
          const diff = startTime - now;
          setBeforeStart('Pendaftaran dibuka dalam', diff);
          return;
        }

        // Status C: Sudah berakhir (Time > End)
        if (endTime && now > endTime) {
          setClosed('Pendaftaran Telah Ditutup');
          return;
        }

        // Status D: Sedang Berlangsung (Start <= Time <= End AND Open is true)
        if (endTime) {
          const diff = endTime - now;
          setActive('Sisa Waktu Pendaftaran', diff);
        } else {
          setActive('Pendaftaran Sedang Dibuka', null);
        }
      }

      function setClosed(msg: string) {
        if (labelEl) labelEl.textContent = msg;
        if (indicatorEl) {
          indicatorEl.className = 'w-2.5 h-2.5 rounded-full bg-rose-500';
        }
        if (timerGrid) timerGrid.classList.add('hidden');
        if (closedNotice) closedNotice.classList.remove('hidden');
        if (registerBtn) registerBtn.classList.add('hidden');
      }

      function setBeforeStart(label: string, diffMs: number) {
        if (labelEl) labelEl.textContent = label;
        if (indicatorEl) {
          indicatorEl.className = 'w-2.5 h-2.5 rounded-full bg-yellow-400 animate-pulse';
        }
        if (closedNotice) closedNotice.classList.add('hidden');
        if (timerGrid) timerGrid.classList.remove('hidden');
        if (registerBtn) registerBtn.classList.add('hidden'); // Sembunyikan tombol pendaftaran sebelum buka

        applyDiff(diffMs);
      }

      function setActive(label: string, diffMs: number | null) {
        if (labelEl) labelEl.textContent = label;
        if (indicatorEl) {
          indicatorEl.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse';
        }
        if (closedNotice) closedNotice.classList.add('hidden');
        if (timerGrid) timerGrid.classList.remove('hidden');
        if (registerBtn) registerBtn.classList.remove('hidden'); // Tampilkan tombol pendaftaran saat buka

        if (diffMs !== null) {
          applyDiff(diffMs);
        } else {
          if (daysEl) daysEl.textContent = '∞';
          if (hoursEl) hoursEl.textContent = '∞';
          if (minsEl) minsEl.textContent = '∞';
          if (secsEl) secsEl.textContent = '∞';
        }
      }

      function applyDiff(diffMs: number) {
        if (diffMs <= 0) {
          update();
          return;
        }

        const days = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diffMs / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diffMs / (1000 * 60)) % 60);
        const seconds = Math.floor((diffMs / 1000) % 60);

        if (daysEl) daysEl.textContent = pad(days);
        if (hoursEl) hoursEl.textContent = pad(hours);
        if (minsEl) minsEl.textContent = pad(minutes);
        if (secsEl) secsEl.textContent = pad(seconds);
      }

      update();
      setInterval(update, 1000);
    }

    function initQnA() {
      // Accordion toggles
      const toggleBtns = document.querySelectorAll<HTMLButtonElement>('.qna-toggle-btn');
      toggleBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          if (!targetId) return;
          const body = document.getElementById(targetId);
          const chevron = btn.querySelector('.qna-chevron');
          if (!body) return;

          const isHidden = body.classList.contains('hidden');
          if (isHidden) {
            body.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
            if (chevron) chevron.classList.add('rotate-180');
          } else {
            body.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            if (chevron) chevron.classList.remove('rotate-180');
          }
        });
      });

      // Form submission
      const form = document.getElementById('public-qna-form') as HTMLFormElement | null;
      if (!form) return;

      const alertEl = document.getElementById('qna-form-alert');
      const submitBtn = document.getElementById('qna-submit-btn') as HTMLButtonElement | null;
      const submitText = document.getElementById('qna-submit-text');
      const submitSpinner = document.getElementById('qna-submit-spinner');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const askerName = (formData.get('askerName') as string || '').trim();
        const question = (formData.get('question') as string || '').trim();

        if (!question) {
          if (alertEl) {
            alertEl.textContent = 'Silakan tulis pertanyaan Anda.';
            alertEl.className = 'p-4 rounded-xl text-xs bg-rose-500/10 text-rose-300 border border-rose-500/30 mb-4 block';
          }
          return;
        }

        // Set Loading
        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.textContent = 'Mengirim...';
        if (submitSpinner) submitSpinner.classList.remove('hidden');
        if (alertEl) alertEl.classList.add('hidden');

        try {
          const res = await fetch('/api/qna/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ askerName, question }),
          });

          const data = (await res.json()) as any;

          if (!res.ok || !data.success) {
            throw new Error(data.message || 'Gagal mengirim pertanyaan.');
          }

          if (alertEl) {
            alertEl.textContent = 'Pertanyaan Anda berhasil dikirim! Panitia akan meninjau dan menjawab pertanyaan Anda.';
            alertEl.className = 'p-4 rounded-xl text-xs bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 mb-4 block';
          }
          form.reset();
        } catch (err: any) {
          if (alertEl) {
            alertEl.textContent = err.message || 'Terjadi kesalahan sistem saat mengirim pertanyaan.';
            alertEl.className = 'p-4 rounded-xl text-xs bg-rose-500/10 text-rose-300 border border-rose-500/30 mb-4 block';
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.textContent = 'Kirim Pertanyaan';
          if (submitSpinner) submitSpinner.classList.add('hidden');
        }
      });
    }

    function initAll() {
      initCountdown();
      initQnA();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  </script>
</MainLayout>
